import "fonts/NetherPixel-Regular.ttf";
import "fonts/NetherPixel-Bold.ttf";
import "fonts/Barlow-Regular.ttf";
import "fonts/Barlow-Medium.ttf";
import "fonts/Barlow-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

import { Theme } from "theme.slint";
export { Theme }
import { Backend, Setup, Inst, Row, Detail, Link, PresetRow, WorldInvite, SkinLib, SkinTile, Wizard, JavaRt, Combiner, CombineCat, Sound, NewInst, ThemeSpec } from "structs.slint";
export { Backend, Inst, Row, Detail, Link, PresetRow, WorldInvite, SkinLib, SkinTile, Wizard, JavaRt, Combiner, CombineCat, Setup, Sound, NewInst, ThemeSpec }
import { Btn, Eyebrow, Page, Slash, Hatch, PlayButton, Icon, Ico, Pulse, LinkBtn, Heading, Scrim, WinButtons, Field, FocusTrap, Toggle, Dropdown, Stat } from "components.slint";
import { HomeScreen } from "home.slint";
import { SetupFlow } from "setup.slint";
import { InstancesScreen } from "instances.slint";
import { DiscoverScreen } from "discover.slint";
import { WardrobeScreen } from "wardrobe.slint";
import { Community, CommItem } from "community.slint";
export { Community, CommItem }
import { SettingsScreen } from "settings.slint";
import { Friends, FriendRow, FriendsPanel, FIco, FColor } from "friends.slint";
export { Friends, FriendRow }

// Top-bar square button (settings cog) with keyboard focus and a hover label below it.
component BarBtn inherits Rectangle {
    in property <bool> active;
    out property <bool> hot: ta.has-hover || fs.has-focus;
    callback clicked();
    border-radius: Theme.r2;
    background: root.active ? Theme.ln2 : (ta.has-hover ? Theme.hov : transparent);
    animate background { duration: Theme.fast; }
    @children
    ta := TouchArea { mouse-cursor: pointer; clicked => { Sound.play(0); root.clicked(); } }
    fs := FocusScope { width: 0px; height: 0px; focus-on-click: false;
        key-pressed(e) => { if e.text == " " || e.text == Key.Return { Sound.play(0); root.clicked(); return accept; } return reject; } }
    if fs.has-focus: Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; border-width: 2px; border-color: Theme.ice; }
}

// Left rail item (Lunar-style): 48 square, line icon (20 grid), accent tint + left bar when active, page name to the right on hover.
component RailBtn inherits Rectangle {
    in property <string> d;
    in property <string> label;
    in property <bool> active;
    // filled symbol (a brand mark such as Discord's, white on Dark and black on Light, as its rules allow) instead of a line icon
    in property <bool> filled;
    callback clicked();
    width: 48px; height: 48px; border-radius: Theme.r3;
    background: root.active ? Theme.red.with-alpha(0.16) : (ta.has-hover ? Theme.hov : transparent);
    animate background { duration: Theme.fast; }
    if root.active: Rectangle { x: -14px; y: 12px; width: 3px; height: 24px; border-radius: 1.5px; background: Theme.red; }
    Path {
        x: 13px; y: 13px; width: 22px; height: 22px; viewbox-width: 20; viewbox-height: 20;
        commands: root.d; fill: root.filled ? (Theme.light ? #000000 : #ffffff) : transparent; fill-rule: evenodd; stroke-width: root.filled ? 0px : 1.6px;
        stroke: root.active ? Theme.red2 : (ta.has-hover ? Theme.tx : Theme.dim);
        opacity: root.filled && !ta.has-hover ? 0.62 : 1;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { Sound.play(0); root.clicked(); } }
    fs := FocusScope { width: 0px; height: 0px; focus-on-click: false;
        key-pressed(e) => { if e.text == " " || e.text == Key.Return { Sound.play(0); root.clicked(); return accept; } return reject; } }
    if fs.has-focus: Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; border-radius: Theme.r3; border-width: 2px; border-color: Theme.ice; }
    if ta.has-hover || fs.has-focus: Rectangle {
        x: parent.width + 16px; y: (parent.height - 28px) / 2; width: tl.preferred-width + 20px; height: 28px; border-radius: Theme.r1;
        background: Theme.s3; border-width: 1px; border-color: Theme.ln2;
        tl := Text { text: root.label; color: Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// "Waiting" line used by the sign-in states.
component Waiting inherits Rectangle {
    in property <string> text;
    height: 20px;
    Pulse { x: 0px; y: 6px; }
    Text { x: 18px; height: parent.height; text: root.text; color: Theme.redtx; font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 500; vertical-alignment: center; }
}

export component AppWindow inherits Window {
    title: "Nether Client";
    icon: @image-url("assets/nether-icon.png");
    preferred-width: 1516px;
    preferred-height: 900px;
    min-width: 960px;
    min-height: 600px;
    background: #000000;
    default-font-family: "Barlow";

    in-out property <int> tab: 0;
    in-out property <int> open-idx: -1;
    in-out property <int> open-tab: 0;
    in-out property <int> open-mode: 0;
    // snapshot only: show the delete confirmation
    in-out property <bool> snap-confirm: false;
    // Wardrobe SKINS/CAPES page (kept across tab switches)
    in-out property <int> ward-page: 0;
    // uniform UI scale from the 1440x900 page design plus the 76 rail; the stage grows on the longer axis (no letterbox)
    property <float> s: Math.min(root.width / 1516px, root.height / 900px);
    property <length> W: root.width / root.s;
    property <length> H: root.height / root.s;
    property <[string]> labels: ["Home", "Play", "Discover", "Wardrobe"];
    property <[int]> ids: [0, 1, 2, 5];
    // rail icons (design/module-icons, 20 grid): home, play (game pad), discover, wardrobe
    property <[string]> icons: [
        "M3 9l7-6 7 6v8H3z M8 17v-5h4v5",
        "M6 6h8a4 4 0 0 1 4 4v1.5a2.5 2.5 0 0 1-4.4 1.6L12.5 12h-5l-1.1 1.1A2.5 2.5 0 0 1 2 11.5V10a4 4 0 0 1 4-4z M6.5 8.2v3 M5 9.7h3 M13.2 9h.1 M14.8 10.6h.1",
        "M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M13 7l-2 4-4 2 2-4z",
        "M7 3l3 2 3-2 4 3-2 3h-2v8H7V9H5L3 6z"];
    // left icon rail (Lunar-style); every page sits right of it
    property <length> rail: 76px;
    property <[length]> tx: [0px, 82px, 204px, 362px, 452px, 526px];
    property <[length]> tw: [82px, 122px, 158px, 90px, 74px, 124px];
    property <length> top: 56px;
    property <length> deck: 56px;
    property <length> body: root.H - root.top - root.deck;
    property <int> ai: Backend.active-inst;
    property <bool> has-inst: Backend.instances.length > 0;
    // a returning player keeps their face and name in the chip while the saved sign-in refreshes (no flicker)
    property <bool> acct-known: Backend.acct-state == 2 || (Backend.acct-state == 3 && Backend.acct-name != "");
    // the player preview asks for frames again when its tab opens or the model changes
    // leaving the Wardrobe with unapplied picks asks first (the tab bounces back until answered)
    property <int> ward-prev: 0;
    in-out property <int> ward-leave: -1;
    property <bool> ward-ok: false;
    changed tab => {
        if root.tab != 5 && root.ward-prev == 5 && Backend.look-dirty && !Backend.look-busy && !root.ward-ok {
            root.ward-leave = root.tab;
            root.tab = 5;
        } else {
            root.ward-ok = false;
            root.ward-prev = root.tab;
            Backend.skin-wake();
        }
    }
    function ward-go(apply: bool) {
        if apply { Backend.apply-look(); } else { Backend.revert-look(); }
        root.ward-ok = true;
        root.open-idx = -1;
        root.tab = root.ward-leave;
        root.ward-leave = -1;
    }
    property <bool> slim: Backend.skin-slim;
    changed slim => { Backend.skin-wake(); }
    // keyboard shortcuts (every key nothing else took): Ctrl+K command palette, Ctrl+1-4 pages in rail order, Ctrl+, settings, Ctrl+N new instance,
    // Esc closes the project page, account panel and crash page
    forward-focus: keys;
    keys := FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height; focus-on-click: false;
        // Ctrl+K works from anywhere, a focused text field included
        capture-key-pressed(e) => {
            if e.modifiers.control && (e.text == "k" || e.text == "K") && !Backend.gate-open && !Setup.open { Backend.pal-show(); return accept; }
            return reject;
        }
        key-pressed(e) => {
            if e.text == Key.Escape {
                if Backend.detail-open { Backend.detail-open = false; return accept; }
                if Backend.acct-open { Backend.acct-open = false; return accept; }
                if Friends.open { Friends.open = false; return accept; }
                if Backend.crash-open { Backend.crash-open = false; return accept; }
                if Backend.peek-open { Backend.peek-open = false; return accept; }
                return reject;
            }
            if !e.modifiers.control || Backend.gate-open || Setup.open { return reject; }
            if e.text == "," { root.open-idx = -1; root.tab = 6; return accept; }
            if e.text == "n" || e.text == "N" { Backend.create-open = true; root.open-idx = -1; root.tab = 1; return accept; }
            if e.text == "1" { root.open-idx = -1; root.tab = 0; return accept; }
            if e.text == "2" { root.tab = 1; return accept; }
            if e.text == "3" { root.open-idx = -1; root.tab = 2; return accept; }
            if e.text == "4" { root.open-idx = -1; root.tab = 5; return accept; }
            return reject;
        }

    stage := Rectangle {
        x: (root.width - root.W) / 2;
        y: (root.height - root.H) / 2;
        width: root.W;
        height: root.H;
        transform-scale: root.s;
        background: @linear-gradient(155deg, Theme.bg-top 0%, Theme.bg 55%);
        clip: true;

        // glass themes: a faint accent aura in the top-right corner gives the see-through panels something to show
        if Theme.aura > 0: Rectangle {
            x: root.W - 900px; y: -520px; width: 1400px; height: 1100px;
            background: @radial-gradient(circle, Theme.red.with-alpha(Theme.aura) 0%, transparent 70%);
        }

        // ambient: the launch target's wallpaper, faint, behind the top of every page (the user's world instead of a black void)
        if root.tab != 0 && root.tab != 6 && root.has-inst && Backend.instances[root.ai].has-cover: Rectangle {
            x: root.rail; y: root.top; width: root.W - root.rail; height: 360px; clip: true; opacity: 0.18; cache-rendering-hint: true;
            Image { width: parent.width; height: parent.height; source: Backend.instances[root.ai].cover-img; image-fit: cover; }
            Rectangle { background: @linear-gradient(180deg, Theme.bg.with-alpha(0.2) 0%, Theme.bg 100%); }
        }

        // screens (recreated on tab change, so selection state resets when you leave)
        // each Page fades + slides in when its tab is opened (the tab transition)
        if root.tab == 0: Page { x: root.rail; y: root.top; width: root.W - root.rail; height: root.H - root.top;
            HomeScreen {
                width: root.W - root.rail; height: root.H - root.top;
                open-instance(i) => { root.open-idx = i; root.open-tab = 0; root.open-mode = 0; root.tab = 1; }
                open-crash(i) => { Backend.log-kind = 2; root.open-idx = i; root.open-tab = 5; root.open-mode = 0; root.tab = 1; }
                go-wardrobe => { root.open-idx = -1; root.tab = 5; }
                go-discover => { root.open-idx = -1; root.tab = 2; }
                go-play => { root.open-idx = -1; Backend.refilter(); root.tab = 1; }
            }
        }
        if root.tab == 1: Page { x: root.rail; y: root.top; width: root.W - root.rail; height: root.body;
            InstancesScreen {
                width: root.W - root.rail; height: root.body;
                sel <=> root.open-idx;
                itab <=> root.open-tab;
                mode <=> root.open-mode;
                confirm-del: root.snap-confirm; del-idx: root.snap-confirm ? 0 : -1;
                go-discover => { root.open-idx = -1; root.tab = 2; }
                go-settings => { root.open-idx = -1; root.tab = 6; }
            }
        }
        if root.tab == 2: Page { x: root.rail; y: root.top; width: root.W - root.rail; height: root.body; DiscoverScreen { width: root.W - root.rail; height: root.body; } }
        if root.tab == 5: Page { x: root.rail; y: root.top; width: root.W - root.rail; height: root.body; WardrobeScreen { width: root.W - root.rail; height: root.body; page <=> root.ward-page; } }
        if root.tab == 6: Page { x: root.rail; y: root.top; width: root.W - root.rail; height: root.body; SettingsScreen { width: root.W - root.rail; height: root.body; } }

        // ---------- top bar: page title, account chip, window buttons ----------
        Rectangle {
            x: root.rail; y: 0px; width: root.W - root.rail; height: root.top;
            // see-through: the stage backdrop runs under the bar
            // empty bar = window drag handle
            TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { Backend.win-drag(); } } }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
            // window buttons (no native title bar)
            WinButtons { stage-w: root.W - root.rail; }
            // Nether players online now (everyone): quiet live readout left of Friends, hover for what it counts
            if Friends.everyone != "": Rectangle {
                x: fbtn.x - 4px - self.width; y: 8px; height: 40px; width: 14px + 8px + evn.preferred-width + 6px + evl.preferred-width + 14px;
                Rectangle { x: 12px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; border-radius: 6px; background: FColor.dot[1].with-alpha(0.18); }
                Rectangle { x: 14px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px; background: FColor.dot[1]; }
                evn := Text { x: 30px; height: parent.height; vertical-alignment: center; text: Friends.everyone; color: Theme.tx; font-family: Theme.mono; font-size: 12px * Theme.ts; font-weight: 600; }
                evl := Text { x: evn.x + evn.preferred-width + 6px; height: parent.height; vertical-alignment: center; text: "ONLINE"; color: Theme.dim; font-family: Theme.ui; font-size: 11px * Theme.ts; font-weight: 600; letter-spacing: 0.6px; }
                evt := TouchArea { }
                if evt.has-hover: Rectangle {
                    x: parent.width - self.width; y: parent.height + 10px; width: evh.preferred-width + 20px; height: 26px; border-radius: Theme.r1;
                    background: Theme.s3; border-width: 1px; border-color: Theme.ln2;
                    evh := Text { text: "Nether Client players online right now"; color: Theme.tx; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            // friends: icon + online count, badge for requests / asks to join
            // labelled (FRIENDS) until someone is online, then their faces (up to 3) and the count
            fbtn := BarBtn {
                property <int> nf: Math.min(Friends.faces.length, 3);
                property <length> faces-w: self.nf > 0 ? (self.nf - 1) * 14px + 20px + 8px : 0px;
                x: chip.x - 8px - self.width; y: 8px; height: 40px; width: fon.x + fon.preferred-width + 12px; active: Friends.open;
                clicked => { Friends.open = !Friends.open; if Friends.open { Backend.acct-open = false; Friends.refresh(); } }
                Icon { x: 14px; y: 14px; d: FIco.users; tint: fbtn.hot || Friends.open ? Theme.tx : Theme.dim; }
                for f[i] in Friends.faces: Rectangle {
                    visible: i < 3; x: 36px + i * 14px; y: 10px; width: 20px; height: 20px; border-radius: 5px; background: Theme.s1;
                    Image { x: 2px; y: 2px; width: 16px; height: 16px; source: f; image-rendering: pixelated; }
                }
                fon := Text { x: 34px + fbtn.faces-w; height: parent.height; vertical-alignment: center;
                    text: Friends.online > 0 ? Friends.online : "FRIENDS"; color: fbtn.hot || Friends.open ? Theme.tx : Theme.dim;
                    font-family: Friends.online > 0 ? Theme.mono : Theme.ui; font-size: (Friends.online > 0 ? 12px : 11px) * Theme.ts; font-weight: 600; letter-spacing: Friends.online > 0 ? 0px : 0.6px; }
                if Friends.badge > 0: Rectangle { x: 25px; y: 3px; width: Math.max(16px, bt.preferred-width + 8px); height: 16px; border-radius: 8px; background: Theme.red;
                    bt := Text { text: Friends.badge > 9 ? "9+" : Friends.badge; color: white; font-family: Theme.ui; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
            }
            // account
            chip := BarBtn {
                x: root.W - root.rail - 138px - 12px - 160px; y: 8px; width: 160px; height: 40px; active: Backend.acct-open;
                clicked => { Backend.acct-open = !Backend.acct-open; if Backend.acct-open { Friends.open = false; } }
                // player head (face + hat layer from the skin)
                Rectangle { x: 6px; y: 6px; width: 28px; height: 28px; background: Theme.s2; border-radius: Theme.r1; clip: true;
                    if !(root.acct-known && Backend.skin-ready): Icon { x: 8px; y: 8px; d: Ico.user; tint: Theme.mut; }
                    if root.acct-known && Backend.skin-ready: Image { width: 28px; height: 28px; source: Backend.acct-head; image-rendering: pixelated; } }
                Text { x: 44px; y: 4px; width: 92px; text: Backend.acct-state == 2 || (Backend.acct-state == 3 && Backend.acct-name != "") ? Backend.acct-name : "Sign in"; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                Text { x: 44px; y: 22px; text: Backend.acct-state == 2 ? (Backend.acct-offline ? "Offline · singleplayer" : "Microsoft account") : (Backend.acct-state == 1 ? "Waiting…" : (Backend.acct-state == 3 ? "Signing in…" : "Not signed in")); color: Backend.acct-state == 0 ? Theme.redtx : Theme.mut; font-family: Theme.ui; font-size: 11px * Theme.ts; }
                Icon { x: parent.width - 22px; y: 14px; d: Ico.down; tint: chip.hot ? Theme.tx : Theme.mut; }
            }
        }


        // ---------- left rail: logo, pages, settings at the bottom (Lunar-style; drawn over pages so tooltips show) ----------
        Rectangle {
            x: 0px; y: 0px; width: root.rail; height: root.H; background: Theme.s1;
            TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left && self.mouse-y < root.top { Backend.win-drag(); } } }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.ln; }
            Image { source: @image-url("assets/nether-logo.svg"); x: (root.rail - 44px) / 2; y: 6px; width: 44px; height: 44px; }
            Rectangle { x: 18px; y: root.top + 6px; width: root.rail - 36px; height: 1px; background: Theme.ln; }
            for l[i] in root.labels: RailBtn {
                x: (root.rail - 48px) / 2; y: root.top + 22px + i * 58px;
                d: root.icons[i]; label: l; active: root.tab == root.ids[i];
                clicked => { root.open-idx = -1; root.tab = root.ids[i]; }
            }
            // community Discord (official symbol, white): opens the invite in the browser
            RailBtn {
                x: (root.rail - 48px) / 2; y: root.H - 48px - 20px - 56px; label: "Discord"; filled: true;
                d: "M 15.545 4.913 A 13.195 13.195 0 0 0 12.288 3.903 A 0.049 0.049 0 0 0 12.236 3.928 C 12.095 4.178 11.94 4.504 11.831 4.761 C 10.601 4.577 9.377 4.577 8.173 4.761 C 8.063 4.499 7.902 4.178 7.761 3.928 A 0.051 0.051 0 0 0 7.708 3.903 A 13.158 13.158 0 0 0 4.451 4.913 A 0.047 0.047 0 0 0 4.43 4.932 C 2.356 8.031 1.787 11.054 2.066 14.039 A 0.055 0.055 0 0 0 2.087 14.077 C 3.456 15.082 4.781 15.692 6.082 16.096 A 0.052 0.052 0 0 0 6.139 16.078 C 6.446 15.658 6.721 15.214 6.956 14.748 A 0.051 0.051 0 0 0 6.928 14.678 C 6.493 14.513 6.079 14.311 5.68 14.083 A 0.051 0.051 0 0 1 5.675 13.998 C 5.759 13.935 5.843 13.87 5.923 13.804 A 0.05 0.05 0 0 1 5.975 13.797 C 8.593 14.992 11.428 14.992 14.016 13.797 A 0.049 0.049 0 0 1 14.068 13.803 C 14.148 13.869 14.232 13.935 14.317 13.998 A 0.051 0.051 0 0 1 14.312 14.083 A 8.199 8.199 0 0 1 13.064 14.677 A 0.051 0.051 0 0 0 13.036 14.748 C 13.277 15.214 13.551 15.657 13.853 16.077 A 0.051 0.051 0 0 0 13.909 16.096 C 15.217 15.692 16.542 15.082 17.911 14.077 A 0.051 0.051 0 0 0 17.932 14.04 C 18.266 10.588 17.373 7.59 15.566 4.932 A 0.041 0.041 0 0 0 15.545 4.913 Z M 7.347 12.221 C 6.559 12.221 5.909 11.497 5.909 10.609 C 5.909 9.72 6.546 8.996 7.347 8.996 C 8.154 8.996 8.798 9.726 8.785 10.609 C 8.785 11.497 8.148 12.221 7.347 12.221 Z M 12.664 12.221 C 11.875 12.221 11.226 11.497 11.226 10.609 C 11.226 9.72 11.863 8.996 12.664 8.996 C 13.471 8.996 14.114 9.726 14.102 10.609 C 14.102 11.497 13.471 12.221 12.664 12.221 Z";
                clicked => { Backend.open-url("https://discord.gg/R5vxAxVjwu"); }
            }
            RailBtn {
                x: (root.rail - 48px) / 2; y: root.H - 48px - 20px; label: "Settings"; active: root.tab == 6;
                d: "M8.6 3.6c.35-1.47 2.45-1.47 2.8 0a1.44 1.44 0 0 0 2.15.89c1.29-.79 2.77.69 1.98 1.98a1.44 1.44 0 0 0 .89 2.15c1.47.35 1.47 2.45 0 2.8a1.44 1.44 0 0 0-.89 2.15c.79 1.29-.69 2.77-1.98 1.98a1.44 1.44 0 0 0-2.15.89c-.35 1.47-2.45 1.47-2.8 0a1.44 1.44 0 0 0-2.15-.89c-1.29.79-2.77-.69-1.98-1.98a1.44 1.44 0 0 0-.89-2.15c-1.47-.35-1.47-2.45 0-2.8a1.44 1.44 0 0 0 .89-2.15c-.79-1.29.69-2.77 1.98-1.98a1.44 1.44 0 0 0 2.15-.89z M7.5 10a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0";
                clicked => { root.open-idx = -1; root.tab = 6; }
            }
        }

        // ---------- bottom deck: launch target + what is running / downloading ----------
        dk := Rectangle {
            visible: root.tab != 0;
            x: root.rail; y: root.H - root.deck; width: root.W - root.rail; height: root.deck;
            background: Theme.s1;
            TouchArea { }
            Rectangle { y: 0px; height: 1px; background: Theme.ln; }
            // Home and Instances carry their own accent action (PLAY): one per screen
            property <bool> launch: root.tab != 0 && root.tab != 1 && root.has-inst;
            // launch target (hidden on Home, where the hero is the launch control)
            if dk.launch: Rectangle {
                x: 0px; width: 330px;
                background: pk.has-hover ? Theme.s2 : transparent;
                animate background { duration: Theme.fast; }
                Rectangle { x: 20px; y: 10px; width: 36px; height: 36px; background: Theme.s2;
                    Image { x: 4px; y: 4px; width: 28px; height: 28px; source: Backend.instances[root.ai].icon-img; image-rendering: pixelated; } }
                Text { x: 68px; y: 9px; width: 222px; text: Backend.instances[root.ai].name; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                Text { x: 68px; y: 30px; width: 222px; text: Backend.instances[root.ai].ver + " · " + Backend.instances[root.ai].loader + (Backend.instances[root.ai].last == "" ? "" : " · " + Backend.instances[root.ai].last); color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
                Icon { x: 302px; y: 22px; d: "M 2 8 L 6 4 L 10 8"; tint: pk.has-hover ? Theme.tx : Theme.mut; }
                pk := TouchArea { mouse-cursor: pointer; clicked => { pop.show(); } }
                pop := PopupWindow {
                    x: 12px; y: -(Math.min(Backend.instances.length, 9) * 40px + 44px); width: 360px; height: Math.min(Backend.instances.length, 9) * 40px + 40px;
                    Rectangle {
                        background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                        Eyebrow { x: 16px; y: 10px; text: "LAUNCH TARGET"; }
                        Flickable {
                            y: 34px; height: parent.height - 38px; content-height: Backend.instances.length * 40px;
                            for it[i] in Backend.instances: Rectangle {
                                y: i * 40px; height: 40px; width: parent.width;
                                background: t2.has-hover ? Theme.s3 : transparent;
                                Rectangle { x: 0px; width: 3px; background: Theme.red; visible: root.ai == i; }
                                Image { x: 16px; y: 9px; width: 22px; height: 22px; source: it.icon-img; image-rendering: pixelated; }
                                Text { x: 50px; width: 200px; text: it.name; color: root.ai == i || t2.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
                                Text { x: parent.width - 106px; width: 90px; text: it.ver; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                                t2 := TouchArea { clicked => { Backend.active-inst = i; pop.close(); } }
                            }
                        }
                    }
                }
            }
            if dk.launch: PlayButton {
                x: 344px; y: 10px; width: 128px; height: 34px; text-size: 16px;
                label: Backend.instances[root.ai].stopping ? "STOPPING" : (Backend.instances[root.ai].running ? "STOP" : (Backend.instances[root.ai].starting ? "STARTING" : "PLAY"));
                arrow: !Backend.instances[root.ai].running && !Backend.instances[root.ai].starting;
                enabled: Backend.instances.length > 0 && !Backend.instances[root.ai].starting && !Backend.instances[root.ai].stopping;
                clicked => { if Backend.instances[root.ai].running { Backend.stop(Backend.instances[root.ai].name); } else { Backend.play(Backend.instances[root.ai].name); } }
            }
            if dk.launch: Rectangle { x: 500px; y: 16px; width: 1px; height: 24px; background: Theme.ln; }
            // activity
            Rectangle {
                x: dk.launch ? 524px : 24px; width: dk.width - self.x - 24px;
                if Backend.job-on: Rectangle {
                    Pulse { x: 0px; y: 24px; }
                    Text { x: 20px; width: parent.width - 420px - (Backend.job-more > 0 ? 90px : 0px); text: Backend.job-text; color: Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
                    if Backend.job-more > 0: Text { x: parent.width - 400px - 90px; width: 80px; text: "+{Backend.job-more} more"; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                    if Backend.job-cancel: LinkBtn { x: parent.width - 360px - self.width - 18px; y: 14px; text: "CANCEL"; clicked => { Backend.cancel-job(); } }
                    if Backend.job-prog >= 0: Rectangle {
                        x: parent.width - (Backend.job-cancel ? 300px : 360px); y: 26px; width: Backend.job-cancel ? 230px : 290px; height: 4px; background: Theme.s3;
                        Rectangle { x: 0px; width: parent.width * Math.clamp(Backend.job-prog, 0, 1); background: Theme.red2; animate width { duration: Theme.mid; } }
                    }
                    if Backend.job-prog >= 0: Text { x: parent.width - 60px; width: 60px; text: "\{Math.floor(Math.clamp(Backend.job-prog, 0, 1) * 100)}%"; color: Theme.tx; font-family: Theme.mono; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                }
                if !Backend.job-on && Backend.running-count > 0: Rectangle {
                    Pulse { x: 0px; y: 24px; }
                    Text { x: 20px; width: parent.width - 140px; overflow: elide; color: Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 500; vertical-alignment: center;
                        text: Backend.running-label != "" ? Backend.running-label : Backend.running-count == 1 ? "1 game running" : "\{Backend.running-count} games running"; }
                }
                if !Backend.job-on && Backend.running-count == 0: Text {
                    x: 0px; text: "Nothing running"; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center;
                }
                Text { x: 0px; width: parent.width; visible: !Backend.job-on; text: "\{Backend.instances.length} " + (Backend.instances.length == 1 ? "profile" : "profiles"); color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
            }
        }

        // ---------- account panel ----------
        if Backend.acct-open: Rectangle {
            x: 0px; y: root.top; width: root.W; height: root.H - root.top;
            TouchArea { clicked => { Backend.acct-open = false; } }
            Rectangle {
                x: root.W - 138px - 12px - 400px; y: 6px; width: 400px; height: Backend.acct-state == 1 ? 268px : (Backend.acct-state == 2 ? 112px + Backend.accounts.length * 48px + (Backend.acct-offline ? 26px : 0px) : (Backend.acct-msg != "" ? 210px : 152px));
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                TouchArea { }
                Eyebrow { x: 22px; y: 18px; text: "MICROSOFT ACCOUNT"; }
                if Backend.acct-state == 0 || Backend.acct-state == 3: Rectangle {
                    Text { x: 22px; y: 44px; width: 356px; text: Backend.acct-state == 3 ? "Signing you in…" : "Sign in to play online and use your skin and cape."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
                    if Backend.acct-state == 0: Btn { x: 22px; y: 96px; text: "SIGN IN WITH MICROSOFT"; solid: true; clicked => { Backend.sign-in(); } }
                    if Backend.acct-msg != "": Text { x: 22px; y: 146px; width: 356px; text: Backend.acct-msg; color: Theme.redtx; font-family: Theme.ui; font-size: 12px * Theme.ts; wrap: word-wrap; }
                }
                if Backend.acct-state == 1: Rectangle {
                    Text { x: 22px; y: 44px; width: 356px; text: "Open the page below and enter this code:"; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
                    Text { x: 22px; y: 70px; text: Backend.acct-code; color: Theme.tx; font-family: Theme.mono; font-size: 34px; font-weight: 700; letter-spacing: 4px; }
                    Text { x: 22px; y: 126px; text: Backend.acct-url; color: Theme.dim; font-family: Theme.mono; font-size: 11px * Theme.ts; }
                    op := Btn { x: 22px; y: 158px; text: "OPEN PAGE"; solid: true; icon: Ico.ext; clicked => { Backend.open-url(Backend.acct-url); } }
                    Btn { x: op.x + op.width + 8px; y: 158px; text: "COPY CODE"; icon: Ico.copy; clicked => { Backend.copy-text(Backend.acct-code); } }
                    Waiting { x: 22px; y: 220px; width: 200px; text: "Waiting for sign-in"; }
                    LinkBtn { x: parent.width - 22px - self.width; y: 216px; text: "CANCEL"; clicked => { Backend.cancel-sign-in(); } }
                }
                // signed in: every saved account (click one to switch), add another, sign the active one out
                if Backend.acct-state == 2: Rectangle {
                    for a[i] in Backend.accounts: Rectangle {
                        x: 12px; y: 42px + i * 48px; width: 376px; height: 44px; border-radius: Theme.r1;
                        background: a.active ? Theme.s2 : (row.has-hover ? Theme.s1 : transparent);
                        animate background { duration: Theme.fast; }
                        Rectangle { x: 10px; y: 8px; width: 28px; height: 28px; background: Theme.s3;
                            if a.active && Backend.skin-ready: Image { width: 28px; height: 28px; source: Backend.acct-head; image-rendering: pixelated; }
                            if !(a.active && Backend.skin-ready): Icon { x: 6px; y: 6px; d: Ico.user; tint: Theme.mut; } }
                        Text { x: 50px; y: 0px; width: 230px; height: parent.height; text: a.name; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        Text { x: parent.width - 86px; width: 76px; height: parent.height; text: a.active ? "ACTIVE" : (row.has-hover ? "SWITCH" : ""); color: a.active ? Theme.ice : Theme.dim;
                            font-family: Theme.disp; font-size: 16px; font-weight: 700; letter-spacing: 0.9px; horizontal-alignment: right; vertical-alignment: center; }
                        row := TouchArea { mouse-cursor: a.active ? default : pointer; clicked => { if !a.active { Backend.switch-account(a.uuid); } } }
                    }
                    if Backend.acct-offline: Text { x: 22px; y: 48px + Backend.accounts.length * 48px; width: 356px; text: "No connection: singleplayer only until you're back online."; color: Theme.redtx; font-family: Theme.ui; font-size: 12px * Theme.ts; wrap: word-wrap; }
                    aa := Btn { x: 22px; y: parent.height - 56px; text: "ADD ACCOUNT"; icon: Ico.plus; clicked => { Backend.sign-in(); } }
                    Btn { x: aa.x + aa.width + 8px; y: parent.height - 56px; text: "SIGN OUT"; danger: true; clicked => { Backend.sign-out(); } }
                }
            }
        }

        // ---------- friends drawer ----------
        if Friends.open: Rectangle {
            x: 0px; y: root.top; width: root.W; height: root.H - root.top;
            TouchArea { clicked => { Friends.open = false; } }
            FriendsPanel { x: root.W - 138px - 12px - self.width; y: 6px; height: Math.min(720px, parent.height - 12px); }
        }

        // ---------- first-run setup walkthrough (setup.rs): account, Java & memory, first profile, first launch ----------
        if Setup.open: SetupFlow {
            x: 0px; y: 0px; W: root.W; H: root.H; top: root.top;
            go-play => { root.open-idx = -1; root.tab = 1; }
            go-home => { root.open-idx = -1; root.tab = 0; }
        }

        // ---------- full-screen Microsoft sign-in gate (behind the setup walkthrough while it is open) ----------
        if Backend.gate-open && !Setup.open: Rectangle {
            x: 0px; y: 0px; width: root.W; height: root.H; background: Theme.bg;
            // only the top strip drags the window (like the top bar everywhere else)
            TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left && self.mouse-y < root.top { Backend.win-drag(); } } }
            Image { source: @image-url("assets/nether-logo.svg"); x: 20px; y: 10px; width: 36px; height: 36px; }
            Text { x: 66px; height: root.top; text: "Nether"; color: Theme.tx; font-family: Theme.pix; font-size: 24px; font-weight: 700; vertical-alignment: center; }
            // right: the banner (art/wide_banner.png) on a plate
            Rectangle {
                x: root.W - 600px; y: root.top; width: 560px; height: root.H - root.top - 40px; background: Theme.s1; border-radius: Theme.r2; clip: true;
                Image { source: @image-url("assets/banner.jpg"); width: parent.width; height: parent.height; image-fit: cover; }
                Rectangle { border-radius: Theme.r2; border-width: 1px; border-color: Theme.ln; }
            }
            Heading { x: 96px; y: 216px; text: "NETHER"; font-size: 64px; }
            Heading { x: 96px; y: 296px; text: "CLIENT"; font-size: 64px; color: Theme.red2; }
            Text { x: 100px; y: 420px; width: 560px; text: Backend.acct-state == 3 ? "Signing you in…" : "Sign in with your Microsoft account to play."; color: Theme.dim; font-family: Theme.ui; font-size: 19px; }

            // signed out
            if Backend.acct-state == 0: Rectangle {
                PlayButton { x: 100px; y: 476px; width: 420px; height: 64px; label: "SIGN IN WITH MICROSOFT"; text-size: 24px; arrow: false; clicked => { Backend.sign-in(); } }
                Text { x: 100px; y: 568px; width: 560px; text: Backend.acct-msg; color: Theme.redtx; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
            }
            // waiting for the user on microsoft.com
            if Backend.acct-state == 1: Rectangle {
                Eyebrow { x: 100px; y: 476px; text: "ENTER THIS CODE ON THE MICROSOFT PAGE"; }
                Text { x: 98px; y: 496px; text: Backend.acct-code; color: Theme.tx; font-family: Theme.mono; font-size: 64px; font-weight: 700; letter-spacing: 8px; }
                Text { x: 100px; y: 584px; text: Backend.acct-url; color: Theme.dim; font-family: Theme.mono; font-size: 13px * Theme.ts; }
                gop := Btn { x: 100px; y: 620px; height: 44px; text: "OPEN PAGE"; solid: true; icon: Ico.ext; clicked => { Backend.open-url(Backend.acct-url); } }
                Btn { x: gop.x + gop.width + 10px; y: 620px; height: 44px; text: "COPY CODE"; icon: Ico.copy; clicked => { Backend.copy-text(Backend.acct-code); } }
                Waiting { x: 100px; y: 692px; width: 320px; text: "Waiting for you to finish signing in"; }
                LinkBtn { x: 100px; y: 724px; text: "CANCEL"; clicked => { Backend.cancel-sign-in(); } }
            }
        }

        // ---------- crash page: what went wrong, our diagnosis, mclo.gs analysis, the log ----------
        if Backend.crash-open: Rectangle {
            x: 0px; y: 0px; width: root.W; height: root.H; background: Theme.bg;
            // keyboard focus stays on the crash page (Tab wraps), Esc closes it
            FocusTrap { x: 0px; y: 0px; width: root.W; height: root.H; escape => { Backend.crash-open = false; }
            TouchArea { scroll-event(e) => { accept } pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left && self.mouse-y < 56px { Backend.win-drag(); } } }
            // right: the end of the log + facts mclo.gs found
            Rectangle {
                x: 900px; y: 0px; width: root.W - 900px; height: root.H; background: Theme.s1; clip: true;
                Rectangle { x: 0px; width: 1px; background: Theme.ln; }
                Eyebrow { x: 36px; y: 56px; text: Backend.crash-title != "" ? Backend.crash-title : "END OF THE LOG"; }
                for f[i] in Backend.crash-facts: Text { x: 36px; y: 84px + i * 20px; width: 468px; text: f; color: Theme.dim; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
                Rectangle {
                    x: 36px; y: 96px + Backend.crash-facts.length * 20px; width: 468px; height: parent.height - self.y - 40px;
                    background: Theme.bg; border-radius: Theme.r2; border-width: 1px; border-color: Theme.ln2; clip: true;
                    Text { x: 14px; y: 12px; width: parent.width - 28px; height: parent.height - 24px; text: Backend.crash-tail; color: Theme.dim; font-family: Theme.mono; font-size: 11px * Theme.ts; wrap: char-wrap; overflow: elide; }
                }
            }
            // left: title, findings, analysis, actions
            Flickable {
                x: 0px; y: 0px; width: 900px; height: root.H - 96px;
                content-height: 420px + Math.min(Backend.crash-items.length, 5) * 126px + (Backend.crash-state == 2 ? 90px + Backend.crash-problems.length * 110px : 120px);
                Eyebrow { x: 74px; y: 62px; text: "MINECRAFT CRASHED" + (Backend.crash-code == "" ? "" : " · EXIT CODE " + Backend.crash-code); }
                Heading { x: 70px; y: 86px; width: 780px; text: Backend.crash-inst.to-uppercase(); font-size: Backend.crash-inst.character-count > 16 ? 48px : 64px; overflow: elide; }
                Text { x: 74px; y: 176px; width: 760px; text: "The game closed unexpectedly. Here is what went wrong and how to fix it."; color: Theme.dim; font-family: Theme.ui; font-size: 17px; wrap: word-wrap; }

                // 01 our own diagnosis (with one-click fixes)
                                Text { x: 74px; y: 248px; text: "WHAT WE FOUND"; color: Theme.dim; font-family: Theme.pix; font-size: 16px; font-weight: 700; }
                if Backend.crash-items.length == 0: Text { x: 74px; y: 282px; width: 760px; text: "Nothing we recognise. The mclo.gs analysis below knows many more crash causes."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; }
                for c[i] in Backend.crash-items: Rectangle {
                    x: 72px; y: 280px + i * 126px; width: 760px; height: 116px; visible: i < 5;
                    background: Theme.s1; border-width: 1px; border-color: Theme.ln; border-radius: Theme.r2;
                    Rectangle { x: 0px; width: 3px; background: Theme.red2; }
                    Text { x: 20px; y: 12px; width: parent.width - 40px - (c.act != "" ? 200px : 0px); text: c.title; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; overflow: elide; }
                    Text { x: 20px; y: 40px; width: parent.width - 40px; height: 32px; text: c.text; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; overflow: elide; }
                    Text { x: 20px; y: 74px; width: parent.width - 40px; height: 34px; text: "Fix: " + c.fix; color: Theme.ice; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; overflow: elide; }
                    if c.act != "": Btn { x: parent.width - self.width - 12px; y: 8px; height: 28px; text: c.act; solid: true; clicked => { Backend.crash-fix(i); } }
                }

                // 02 mclo.gs: upload for a link + automatic analysis
                property <length> y2: 300px + Math.max(1, Math.min(Backend.crash-items.length, 5)) * 126px;
                                Text { x: 74px; y: y2; text: "MCLO.GS ANALYSIS"; color: Theme.dim; font-family: Theme.disp; font-size: 16px; font-weight: 700; }
                if Backend.crash-state == 0 || Backend.crash-state == 3: Rectangle {
                    x: 72px; y: y2 + 32px; width: 760px; height: 100px;
                    Text { x: 2px; y: 0px; width: 740px; text: Backend.crash-state == 3 ? "Upload failed: " + Backend.crash-err : "Upload the crash log to mclo.gs. You get a link to share with friends or a mod author, and an automatic check against hundreds of known problems. Your Windows user folder and sign-in token are removed first.";
                        color: Backend.crash-state == 3 ? Theme.redtx : Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
                    PlayButton { x: 0px; y: 52px; width: 400px; height: 48px; label: Backend.crash-state == 3 ? "TRY AGAIN" : "UPLOAD TO MCLO.GS"; text-size: 24px; clicked => { Backend.crash-upload(); } }
                }
                if Backend.crash-state == 1: Waiting { x: 72px; y: y2 + 40px; width: 400px; text: "Uploading and analysing the log"; }
                if Backend.crash-state == 2: Rectangle {
                    x: 72px; y: y2 + 32px; width: 760px; height: 70px + Backend.crash-problems.length * 110px;
                    Rectangle {
                        x: 0px; y: 0px; width: 760px; height: 44px; background: Theme.s1; border-width: 1px; border-color: Theme.ln2;
                        Text { x: 16px; width: 480px; text: Backend.crash-url; color: Theme.ice; font-family: Theme.mono; font-size: 13px * Theme.ts; vertical-alignment: center; overflow: elide; }
                        Btn { x: cop.x - 8px - self.width; y: 6px; height: 32px; text: "COPY LINK"; icon: Ico.copy; clicked => { Backend.copy-text(Backend.crash-url); Backend.toast("Link copied"); } }
                        cop := Btn { x: parent.width - 8px - self.width; y: 6px; height: 32px; text: "OPEN"; icon: Ico.ext; clicked => { Backend.open-url(Backend.crash-url); } }
                    }
                    if Backend.crash-problems.length == 0: Text { x: 2px; y: 60px; width: 740px; text: "mclo.gs found no known problem in this log. Share the link with whoever can help."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
                    for p[i] in Backend.crash-problems: Rectangle {
                        y: 58px + i * 110px; width: 760px; height: 100px;
                        background: Theme.s1; border-width: 1px; border-color: Theme.ln; border-radius: Theme.r2;
                        Rectangle { x: 0px; width: 3px; background: Theme.ice; }
                        Text { x: 20px; y: 12px; width: parent.width - 40px; text: p.title; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; wrap: word-wrap; height: 38px; overflow: elide; }
                        Text { x: 20px; y: 54px; width: parent.width - 40px; height: 40px; text: p.fixes; color: Theme.ice; font-family: Theme.ui; font-size: 12px * Theme.ts; wrap: word-wrap; overflow: elide; }
                    }
                }
            }
            // actions
            Rectangle {
                x: 0px; y: root.H - 96px; width: 900px; height: 96px; background: Theme.bg;
                Rectangle { height: 1px; background: Theme.ln; }
                PlayButton { x: 72px; y: 22px; width: 260px; height: 52px; label: "PLAY AGAIN"; text-size: 24px; clicked => { Backend.crash-relaunch(); } }
                vl := Btn { x: 348px; y: 30px; height: 38px; text: "FULL LOG"; clicked => { Backend.crash-open = false; root.open-idx = Backend.crash-idx; root.open-tab = 5; root.open-mode = 0; root.tab = 1; } }
                Btn { x: vl.x + vl.width + 10px; y: 30px; height: 38px; text: "SUPPORT ZIP"; icon: Ico.export; clicked => { Backend.inst-action(Backend.crash-idx, 6); } }
                Btn { x: 900px - 72px - self.width; y: 30px; height: 38px; text: "CLOSE"; clicked => { Backend.crash-open = false; } }
            }
            WinButtons { stage-w: root.W; }
            }
        }
        if (Backend.gate-open || Setup.open) && !Backend.crash-open: WinButtons { stage-w: root.W; }

        // ---------- L1: pre-launch check: problems that would stop the game, each with its fix; never blocks ----------
        if Backend.pre-open: Scrim {
            x: 0px; y: 0px; width: root.W; height: root.H;
            dismiss => { Backend.pre-open = false; }
            pd := Rectangle {
                property <int> n: Backend.pre-items.length;
                property <length> list-h: Math.min(Math.max(pd.n, 1), 4) * 120px;
                x: (root.W - 760px) / 2; y: Math.max(40px, (root.H - self.height) / 2 - 24px); width: 760px; height: 222px + pd.list-h;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                TouchArea { }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 4px; background: pd.n > 0 ? Theme.red : Theme.ice; }
                Eyebrow { x: 32px; y: 30px; text: pd.n > 0 ? "BEFORE YOU PLAY" : "ALL FIXED"; color: pd.n > 0 ? Theme.redtx : Theme.dim; }
                Text { x: 32px; y: 50px; width: parent.width - 64px; text: Backend.pre-inst.to-uppercase(); color: Theme.tx; font-family: Theme.pix; font-size: 32px; font-weight: 800;  overflow: elide; }
                Text { x: 32px; y: 98px; width: parent.width - 64px; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap;
                    text: pd.n == 0 ? "Everything we found is fixed. Ready when you are." : (pd.n == 1 ? "One thing would likely stop the game. Fix it here, or launch anyway." : "\{pd.n} things would likely stop the game. Fix them here, or launch anyway."); }
                Flickable {
                    x: 32px; y: 134px; width: parent.width - 64px; height: pd.list-h; content-height: pd.n * 120px;
                    if pd.n == 0: Rectangle { y: 0px; height: 108px; background: Theme.s1; border-width: 1px; border-color: Theme.ln;
                        Icon { x: 22px; y: 48px; d: Ico.check; tint: Theme.ice; }
                        Text { x: 48px; height: parent.height; text: "No problems left. Your changes are saved."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; vertical-alignment: center; } }
                    for c[i] in Backend.pre-items: Rectangle {
                        y: i * 120px; height: 110px;
                        background: Theme.s1; border-width: 1px; border-color: Theme.ln; border-radius: Theme.r2;
                        Rectangle { x: 0px; width: 3px; background: Theme.red2; }
                        Text { x: 20px; y: 12px; width: parent.width - 40px - (c.act != "" ? 190px : 0px); text: c.title; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; overflow: elide; }
                        Text { x: 20px; y: 40px; width: parent.width - 40px; height: 32px; text: c.text; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; overflow: elide; }
                        Text { x: 20px; y: 74px; width: parent.width - 40px; height: 30px; text: "Fix: " + c.fix; color: Theme.ice; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; overflow: elide; }
                        if c.act != "": Btn { x: parent.width - self.width - 12px; y: 8px; height: 28px; text: c.act; solid: true; clicked => { Backend.pre-fix(i); } }
                    }
                }
                if pd.n > 0: Btn { x: 32px; y: parent.height - 66px; height: 40px; text: "LAUNCH ANYWAY"; icon: Ico.play; clicked => { Backend.pre-launch(); } }
                if pd.n > 0: Text { x: 214px; y: parent.height - 66px; width: 340px; height: 40px; text: "These won't be flagged again for this instance."; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; wrap: word-wrap; vertical-alignment: center; }
                if pd.n == 0: PlayButton { x: 32px; y: parent.height - 72px; width: 200px; height: 48px; label: "PLAY"; text-size: 24px; clicked => { Backend.pre-launch(); } }
                LinkBtn { x: parent.width - 32px - self.width; y: parent.height - 60px; text: "CANCEL"; clicked => { Backend.pre-open = false; } }
            }
        }

        // ---------- import confirm: what a modpack file / instance folder holds, before anything is written ----------
        if Backend.peek-open: Scrim {
            x: 0px; y: 0px; width: root.W; height: root.H;
            dismiss => { Backend.peek-open = false; }
            ipk := Rectangle {
                property <bool> cf: Backend.peek-missing > 0;
                x: (root.W - 600px) / 2; y: (root.H - self.height) / 2 - 24px; width: 600px; height: ipk.cf ? 448px : 368px;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2; clip: true;
                TouchArea { }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 4px; background: ipk.cf ? Theme.red : Theme.ice; }
                Eyebrow { x: 32px; y: 30px; text: "IMPORT  ·  " + Backend.peek-format; }
                Text { x: 32px; y: 50px; width: parent.width - 64px; text: Backend.peek-file; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
                Eyebrow { x: 32px; y: 84px; text: "NEW INSTANCE NAME"; }
                nm := Field { x: 32px; y: 106px; width: parent.width - 64px; height: 44px; text-size: 16px; text <=> Backend.peek-name; placeholder: "Instance name";
                    accepted => { if Backend.peek-name != "" { Backend.peek-confirm(); } } }
                Rectangle {
                    x: 32px; y: 172px; width: parent.width - 64px; height: 48px;
                    Stat { x: 0px; width: 150px; rule: false; k: "MINECRAFT"; v: Backend.peek-mc; }
                    Stat { x: 150px; width: 220px; k: "LOADER"; v: Backend.peek-loader; }
                    Stat { x: 370px; width: parent.width - 370px; k: ipk.cf ? "MODS" : "FILES"; v: Backend.peek-files; }
                }
                Rectangle { x: 32px; y: 240px; width: parent.width - 64px; height: 1px; background: Theme.ln; }
                if !ipk.cf: Text { x: 32px; y: 256px; width: parent.width - 64px; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap;
                    text: Backend.peek-format == "PRISM / MULTIMC INSTANCE" ? "Worlds, mods, configs and settings are copied into a new instance. The source stays as it is." : "Mods are downloaded from Modrinth and checked; configs and worlds from the pack are copied in. The file stays as it is."; }
                if ipk.cf: Rectangle {
                    x: 32px; y: 256px; width: parent.width - 64px; height: 108px; background: Theme.red.with-alpha(0.08); border-radius: Theme.r1;
                    Rectangle { x: 0px; width: 3px; background: Theme.red2; }
                    Text { x: 18px; y: 12px; text: Backend.peek-missing == 1 ? "1 MOD FILE WON'T DOWNLOAD" : "\{Backend.peek-missing} MOD FILES WON'T DOWNLOAD"; color: Theme.redtx; font-family: Theme.disp; font-size: 16px * Theme.ts; font-weight: 700; letter-spacing: 0.8px; }
                    Text { x: 18px; y: 36px; width: parent.width - 36px; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap;
                        text: "CurseForge only hands out mod files through its API, which needs a key this build doesn't have. The Minecraft version, loader, configs and worlds are imported; add the mods afterwards."; }
                }
                LinkBtn { x: parent.width - 32px - ib.width - 20px - self.width; y: parent.height - 60px; height: 40px; text: "CANCEL"; clicked => { Backend.peek-open = false; } }
                ib := Btn { x: parent.width - 32px - self.width; y: parent.height - 60px; height: 40px; width: 170px; text: "IMPORT"; solid: true; icon: Ico.download;
                    enabled: Backend.peek-name != ""; clicked => { Backend.peek-confirm(); } }
                init => { nm.focus-input(); }
            }
        }

        // ---------- Invite to world: a friend's singleplayer world; JOIN starts a matching instance straight into it ----------
        if WorldInvite.open: Scrim {
            x: 0px; y: 0px; width: root.W; height: root.H;
            dismiss => { WorldInvite.later(); }
            wi := Rectangle {
                x: (root.W - 580px) / 2; y: (root.H - self.height) / 2 - 24px; width: 580px; height: WorldInvite.plan == 1 ? 362px : 310px;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2; clip: true;
                TouchArea { }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 4px; background: Theme.red; }
                Eyebrow { x: 32px; y: 30px; text: "WORLD INVITE"; color: Theme.redtx; }
                Text { x: 32px; y: 50px; width: parent.width - 64px; text: WorldInvite.world.to-uppercase(); color: Theme.tx; font-family: Theme.pix; font-size: 32px; font-weight: 800; overflow: elide; }
                Text { x: 32px; y: 98px; width: parent.width - 64px; text: WorldInvite.from + " invited you to play in their world."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; overflow: elide; }
                Rectangle {
                    x: 32px; y: 134px; width: parent.width - 64px; height: 60px;
                    background: Theme.s1; border-width: 1px; border-color: Theme.ln; border-radius: Theme.r2;
                    Text { x: 20px; y: 12px; text: "GAME"; color: Theme.mut; font-family: Theme.ui; font-size: 11px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; }
                    Text { x: 20px; y: 29px; width: parent.width / 2 - 28px; text: WorldInvite.game; color: Theme.tx; font-family: Theme.mono; font-size: 14px * Theme.ts; overflow: elide; }
                    Text { x: parent.width / 2; y: 12px; text: "PLAYS WITH"; color: Theme.mut; font-family: Theme.ui; font-size: 11px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; }
                    Text { x: parent.width / 2; y: 29px; width: parent.width / 2 - 20px; overflow: elide; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600;
                        color: WorldInvite.plan == 2 ? Theme.dim : Theme.ice;
                        text: WorldInvite.plan == 0 ? WorldInvite.insts[0] : WorldInvite.plan == 1 ? "\{WorldInvite.insts.length} matching instances" : "A new instance, made for you"; }
                }
                if WorldInvite.plan == 1: Dropdown {
                    x: 32px; y: 210px; width: parent.width - 64px; height: 40px;
                    items: WorldInvite.insts; current: WorldInvite.pick;
                    changed(i) => { WorldInvite.pick = i; }
                }
                Text { x: 32px; y: WorldInvite.plan == 1 ? 262px : 210px; width: parent.width - 64px; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; wrap: word-wrap;
                    text: WorldInvite.plan == 2 ? "You have no instance on this version and loader yet. JOIN makes one, installs it and connects." : "The game starts and connects to the world on its own."; }
                PlayButton { x: 32px; y: parent.height - 72px; width: 200px; height: 48px; label: "JOIN"; text-size: 24px; clicked => { WorldInvite.join(); } }
                Btn { x: 250px; y: parent.height - 68px; height: 40px; text: "DECLINE"; clicked => { WorldInvite.decline(); } }
                LinkBtn { x: parent.width - 32px - self.width; y: parent.height - 60px; text: "LATER"; clicked => { WorldInvite.later(); } }
            }
        }

        // ---------- L1: safe update: what changes (with changelogs), picked rows only; old files are kept for undo ----------
        if Backend.upd-open: Scrim {
            x: 0px; y: 0px; width: root.W; height: root.H;
            dismiss => { Backend.upd-open = false; }
            ud := Rectangle {
                // the list is as tall as its rows (up to the window), so a short update has no empty band
                property <length> list-h: Backend.upd-state == 0 ? 96px : Math.min(ul.preferred-height, Math.min(root.H - 360px, 460px));
                x: (root.W - 820px) / 2; y: Math.max(40px, (root.H - self.height) / 2 - 24px); width: 820px; height: 232px + ud.list-h;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                TouchArea { }
                Eyebrow { x: 32px; y: 30px; text: "UPDATE " + (Backend.upd-rows.length == 1 ? "1 FILE" : "\{Backend.upd-rows.length} FILES"); }
                Text { x: 32px; y: 50px; width: parent.width - 64px; text: Backend.upd-inst.to-uppercase(); color: Theme.tx; font-family: Theme.pix; font-size: 32px; font-weight: 800;  overflow: elide; }
                Text { x: 32px; y: 98px; width: parent.width - 64px; text: "Read what changes first. The current files and configs are kept, so one click undoes the update."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
                if Backend.upd-state == 0: Waiting { x: 32px; y: 150px; width: 400px; text: "Reading changelogs"; }
                Flickable { visible: Backend.upd-state != 0;
                    x: 32px; y: 134px; width: parent.width - 64px; height: ud.list-h;
                    ul := VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        for u[i] in Backend.upd-rows: Rectangle {
                            height: u.open ? 236px : 58px;
                            background: Theme.s1; border-width: 1px; border-color: Theme.ln; border-radius: Theme.r2;
                            Toggle { x: 16px; y: 18px; on: u.on; toggled(v) => { Backend.upd-pick(i, v); } }
                            Text { x: 76px; y: 0px; width: parent.width - 76px - 330px; height: 58px; text: u.name; color: u.on ? Theme.tx : Theme.mut; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; vertical-alignment: center; overflow: elide; }
                            Text { x: parent.width - 330px; y: 0px; width: 190px; height: 58px; text: u.from + "  →  " + u.to; color: u.on ? Theme.ice : Theme.mut; font-family: Theme.mono; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                            if u.notes != "": LinkBtn { x: parent.width - self.width - 16px; y: 15px; text: u.open ? "HIDE" : "CHANGELOG"; clicked => { Backend.upd-pick(-1 - i, !u.open); } }
                            if u.notes == "": Text { x: parent.width - 126px; y: 0px; width: 110px; height: 58px; text: "No changelog"; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                            if u.open: Rectangle {
                                x: 16px; y: 58px; width: parent.width - 32px; height: 164px; background: #0B0B0E; border-width: 1px; border-color: Theme.ln2; clip: true;
                                Text { x: 14px; y: 10px; width: parent.width - 28px; height: parent.height - 20px; text: u.notes; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; overflow: elide; }
                            }
                        }
                    }
                }
                Btn { x: 32px; y: parent.height - 66px; height: 40px; solid: true; icon: Ico.download; enabled: Backend.upd-state == 1 && Backend.upd-picked > 0;
                    text: Backend.upd-picked == Backend.upd-rows.length ? "UPDATE ALL" : "UPDATE \{Backend.upd-picked}"; clicked => { Backend.upd-apply(); } }
                LinkBtn { x: parent.width - 32px - self.width; y: parent.height - 60px; text: "CANCEL"; clicked => { Backend.upd-open = false; } }
            }
        }

        // ---------- L1: update history: the last 5 updates, each undoable (files + configs) ----------
        if Backend.hist-open: Scrim {
            x: 0px; y: 0px; width: root.W; height: root.H;
            dismiss => { Backend.hist-open = false; }
            hd := Rectangle {
                property <int> n: Backend.hist-rows.length;
                property <length> list-h: Math.max(1, Math.min(hd.n, 5)) * 84px;
                x: (root.W - 760px) / 2; y: Math.max(40px, (root.H - self.height) / 2 - 24px); width: 760px; height: 222px + hd.list-h;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                TouchArea { }
                Eyebrow { x: 32px; y: 30px; text: "UPDATE HISTORY"; }
                Text { x: 32px; y: 50px; width: parent.width - 64px; text: Backend.hist-inst.to-uppercase(); color: Theme.tx; font-family: Theme.pix; font-size: 32px; font-weight: 800;  overflow: elide; }
                Text { x: 32px; y: 98px; width: parent.width - 64px; text: "Undo puts the files and configs back exactly as they were before that update. The last 5 updates are kept."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
                Flickable {
                    x: 32px; y: 134px; width: parent.width - 64px; height: hd.list-h; content-height: hd.n * 84px;
                    if hd.n == 0: Rectangle { y: 0px; height: 74px; background: Theme.s1; border-width: 1px; border-color: Theme.ln;
                        Text { x: 20px; width: parent.width - 40px; height: parent.height; text: "No updates yet. When you update mods here, the previous versions are kept and show up in this list."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; vertical-alignment: center; } }
                    for h[i] in Backend.hist-rows: Rectangle {
                        y: i * 84px; height: 74px;
                        background: Theme.s1; border-width: 1px; border-color: Theme.ln; border-radius: Theme.r2;
                        Rectangle { x: 0px; width: 3px; background: i == 0 ? Theme.ice : Theme.ln2; }
                        Text { x: 20px; y: 12px; width: parent.width - 320px; text: h.title; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; overflow: elide; }
                        Text { x: parent.width - 300px; y: 12px; width: 170px; text: h.when; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; }
                        Text { x: 20px; y: 38px; width: parent.width - 150px; text: h.sub; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; overflow: elide; }
                        Btn { x: parent.width - self.width - 16px; y: 20px; height: 34px; text: "UNDO"; clicked => { Backend.hist-revert(h.id); } }
                    }
                }
                Btn { x: parent.width - 32px - self.width; y: parent.height - 66px; height: 40px; text: "CLOSE"; clicked => { Backend.hist-open = false; } }
            }
        }

        // ---------- yes/no confirmation (delete world, delete screenshot, install Iris, ...) ----------
        if Backend.ask-open: Scrim {
            x: 0px; y: 0px; width: root.W; height: root.H;
            dismiss => { Backend.ask-answer(false); }
            Rectangle {
                x: (root.W - 520px) / 2; y: 260px; width: 520px; height: 96px + at.preferred-height + 70px;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                TouchArea { }
                Rectangle { x: 0px; width: 4px; background: Backend.ask-danger ? Theme.red2 : Theme.ice; }
                Text { x: 32px; y: 28px; width: 456px; text: Backend.ask-title; color: Theme.tx; font-family: Theme.pix; font-size: 24px; font-weight: 700;  overflow: elide; }
                at := Text { x: 32px; y: 72px; width: 456px; text: Backend.ask-text; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
                Btn { x: 32px; y: parent.height - 62px; text: Backend.ask-yes; solid: !Backend.ask-danger; danger: Backend.ask-danger; clicked => { Backend.ask-answer(true); } }
                LinkBtn { x: parent.width - 32px - self.width; y: parent.height - 56px; text: "CANCEL"; clicked => { Backend.ask-answer(false); } }
            }
        }

        // ---------- leaving the Wardrobe with unapplied picks ----------
        if root.ward-leave >= 0: Scrim {
            x: 0px; y: 0px; width: root.W; height: root.H;
            dismiss => { root.ward-leave = -1; }
            Rectangle {
                x: (root.W - 520px) / 2; y: 260px; width: 520px; height: 196px;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                TouchArea { }
                Rectangle { x: 0px; width: 4px; background: Theme.red2; }
                Text { x: 32px; y: 28px; width: 456px; text: "Apply your new look?"; color: Theme.tx; font-family: Theme.pix; font-size: 24px; font-weight: 700; overflow: elide; }
                Text { x: 32px; y: 72px; width: 456px; text: "You picked capes or cosmetics in the Wardrobe that aren't applied yet. Nobody sees them until you apply."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
                ab := Btn { x: 32px; y: parent.height - 62px; text: "APPLY & LEAVE"; solid: true; icon: Ico.check; enabled: Backend.acct-state == 2; clicked => { root.ward-go(true); } }
                Btn { x: ab.x + ab.width + 10px; y: parent.height - 62px; text: "DISCARD"; clicked => { root.ward-go(false); } }
                LinkBtn { x: parent.width - 32px - self.width; y: parent.height - 56px; text: "KEEP EDITING"; clicked => { root.ward-leave = -1; } }
            }
        }

        // ---------- L2: restore a restore point: as a new instance (nothing changes here) or in place ----------
        if Backend.rp-ask >= 0: Scrim {
            x: 0px; y: 0px; width: root.W; height: root.H;
            dismiss => { Backend.rp-ask = -1; }
            rd := Rectangle {
                property <string> nm: Backend.instances[Math.max(0, Backend.current-inst)].name;
                x: (root.W - 640px) / 2; y: Math.max(40px, (root.H - self.height) / 2 - 24px); width: 640px; height: 356px;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                TouchArea { }
                Eyebrow { x: 32px; y: 30px; text: "RESTORE POINT · " + Backend.rpoints[Backend.rp-ask].kind; }
                Text { x: 32px; y: 50px; width: parent.width - 64px; text: Backend.rpoints[Backend.rp-ask].date.to-uppercase(); color: Theme.tx; font-family: Theme.pix; font-size: 32px; font-weight: 800;  overflow: elide; }
                Text { x: 32px; y: 98px; width: parent.width - 64px; text: rd.nm + " as it was then: mods, worlds, configs, settings, version and loader (" + Backend.rpoints[Backend.rp-ask].size + ")."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
                for o[i] in [{t: "As a new instance", s: "A copy next to this one. Nothing in " + rd.nm + " changes."}, {t: "Replace " + rd.nm, s: "Goes back to that point. Its current state is saved as a restore point first."}]: Rectangle {
                    x: 32px; y: 150px + i * 70px; width: parent.width - 64px; height: 62px;
                    background: ota.has-hover ? Theme.s2 : Theme.s1; border-width: 1px; border-color: ota.has-hover ? (i == 1 ? Theme.red2 : Theme.mut) : Theme.ln; border-radius: Theme.r2;
                    animate background, border-color { duration: Theme.fast; }
                    Rectangle { x: 0px; width: 3px; background: i == 0 ? Theme.ice : Theme.red2; }
                    Text { x: 20px; y: 11px; width: parent.width - 60px; text: o.t; color: i == 1 ? Theme.redtx : Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; overflow: elide; }
                    Text { x: 20px; y: 34px; width: parent.width - 60px; text: o.s; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; overflow: elide; }
                    Icon { x: parent.width - 30px; y: 25px; d: Ico.chev; tint: ota.has-hover ? Theme.tx : Theme.mut; }
                    ota := TouchArea { mouse-cursor: pointer; clicked => { Backend.rp-restore(Backend.rp-ask, i == 1); } }
                    ofs := FocusScope { width: 0px; height: 0px; focus-on-click: false;
                        key-pressed(e) => { if e.text == " " || e.text == Key.Return { Backend.rp-restore(Backend.rp-ask, i == 1); return accept; } return reject; } }
                    if ofs.has-focus: Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; border-width: 2px; border-color: Theme.ice; }
                }
                LinkBtn { x: parent.width - 32px - self.width; y: parent.height - 52px; text: "CANCEL"; clicked => { Backend.rp-ask = -1; } }
            }
        }

        // ---------- L2: command palette (Ctrl+K): type, arrows, Enter; Esc or a click outside closes ----------
        if Backend.pal-open: Scrim {
            x: 0px; y: 0px; width: root.W; height: root.H;
            dismiss => { Backend.pal-open = false; }
            pp := Rectangle {
                property <int> n: Backend.pal-rows.length;
                property <length> rh: 54px;
                property <length> list-h: Math.max(1, Math.min(pp.n, 8)) * pp.rh;
                x: (root.W - 760px) / 2; y: 96px; width: 760px; height: 84px + pp.list-h + 44px;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                TouchArea { }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 4px; background: Theme.red2; }
                FocusScope {
                    focus-on-click: false; focus-on-tab-navigation: false;
                    capture-key-pressed(e) => {
                        if e.text == Key.UpArrow { Backend.pal-sel = Math.max(0, Backend.pal-sel - 1); return accept; }
                        if e.text == Key.DownArrow { Backend.pal-sel = Math.min(pp.n - 1, Backend.pal-sel + 1); return accept; }
                        if e.text == Key.Return { if pp.n > 0 { Backend.pal-run(Backend.pal-sel); } return accept; }
                        return reject;
                    }
                    Field { x: 20px; y: 22px; width: parent.width - 40px; height: 46px; text-size: 16px; search: true; text <=> Backend.pal-query;
                        placeholder: "Search instances, worlds, mods, settings and actions";
                        init => { self.focus-input(); }
                        edited => { Backend.pal-search(); } }
                    pl := Flickable {
                        x: 20px; y: 80px; width: parent.width - 40px; height: pp.list-h; content-height: pp.n * pp.rh;
                        property <int> s: Backend.pal-sel;
                        // keep the highlighted row in view
                        changed s => {
                            if self.s * pp.rh < -self.content-y { self.content-y = -self.s * pp.rh; }
                            if (self.s + 1) * pp.rh > -self.content-y + self.height { self.content-y = self.height - (self.s + 1) * pp.rh; }
                        }
                        if pp.n == 0: Text { x: 14px; height: pp.rh; text: "Nothing matches \"" + Backend.pal-query + "\"."; color: Theme.mut; font-family: Theme.ui; font-size: 14px * Theme.ts; vertical-alignment: center; }
                        for r[i] in Backend.pal-rows: Rectangle {
                            y: i * pp.rh; height: pp.rh;
                            background: Backend.pal-sel == i ? Theme.s3 : (pta.has-hover ? Theme.s2 : transparent);
                            Rectangle { x: 0px; width: 3px; background: Theme.red2; visible: Backend.pal-sel == i; }
                            Rectangle { x: 14px; y: (parent.height - 20px) / 2; width: 84px; height: 20px; background: Backend.pal-sel == i ? Theme.s1 : Theme.s2;
                                Text { text: r.kind; color: r.kind == "PLAY" ? Theme.redtx : Theme.dim; font-family: Theme.mono; font-size: 10px * Theme.ts; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                            Text { x: 112px; y: 8px; width: parent.width - 130px; text: r.title; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; overflow: elide; }
                            Text { x: 112px; y: 30px; width: parent.width - 130px; text: r.sub; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; overflow: elide; }
                            pta := TouchArea { mouse-cursor: pointer; clicked => { Backend.pal-run(i); } }
                        }
                    }
                }
                Rectangle { x: 0px; y: parent.height - 40px; width: parent.width; height: 1px; background: Theme.ln; }
                Text { x: 22px; y: parent.height - 40px; height: 40px; text: "↑ ↓  move     ENTER  open     ESC  close"; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; vertical-alignment: center; }
                Text { x: parent.width - 22px - self.width; y: parent.height - 40px; height: 40px; text: "CTRL + K"; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; vertical-alignment: center; }
            }
        }

        // ---------- update required: an installed copy on an old version can't be used; update now or exit ----------
        if Backend.update-gate: Rectangle {
            x: 0px; y: 0px; width: root.W; height: root.H;
            background: #000000e0;
            TouchArea { scroll-event(e) => { accept } }
            // holds focus so no shortcut reaches the launcher underneath
            gf := FocusScope { init => { gf.focus(); } key-pressed(e) => { accept } }
            Rectangle {
                x: (root.W - 620px) / 2; y: (root.H - self.height) / 2 - 24px; width: 620px; height: 330px;
                background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2; clip: true;
                TouchArea { }
                Rectangle { y: 0px; height: 3px; background: Theme.red2; }
                Eyebrow { x: 36px; y: 34px; text: "UPDATE REQUIRED"; }
                Text { x: 36px; y: 54px; width: parent.width - 72px; text: "A NEW NETHER IS HERE"; color: Theme.tx; font-family: Theme.pix; font-size: 32px; font-weight: 800; overflow: elide; }
                Rectangle { x: 36px; y: 108px; width: parent.width - 72px; height: 56px; background: Theme.s1; border-width: 1px; border-color: Theme.ln; border-radius: Theme.r2;
                    Text { x: 20px; y: 10px; text: "YOU HAVE"; color: Theme.mut; font-family: Theme.ui; font-size: 11px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; }
                    Text { x: 20px; y: 26px; text: Backend.app-version; color: Theme.dim; font-family: Theme.mono; font-size: 15px * Theme.ts; }
                    Text { x: 0px; width: parent.width; height: parent.height; text: "→"; color: Theme.mut; font-family: Theme.ui; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { x: parent.width - 20px - self.width; y: 10px; text: "NEWEST"; color: Theme.red2; font-family: Theme.ui; font-size: 11px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; }
                    Text { x: parent.width - 20px - self.width; y: 26px; text: Backend.update-ver; color: Theme.ice; font-family: Theme.mono; font-size: 15px * Theme.ts; font-weight: 600; }
                }
                Text { x: 36px; y: 182px; width: parent.width - 72px; wrap: word-wrap; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts;
                    text: "Nether Client " + Backend.update-ver + " is ready. You need the newest version to play: it takes a few seconds, and Nether reopens on its own."; }
                if Backend.update-gate-busy: Waiting { x: 36px; y: 236px; width: 400px; text: Backend.update-state == 4 ? "Installing " + Backend.update-ver : "Downloading " + Backend.update-ver; }
                if !Backend.update-gate-busy && Backend.update-state != 4 && Backend.update-state != 5: Text { x: 36px; y: 236px; width: parent.width - 72px; text: "Couldn't download the update. Check your connection and try again."; color: Theme.redtx; font-family: Theme.ui; font-size: 13px * Theme.ts; overflow: elide; }
                Btn { x: 36px; y: parent.height - 66px; height: 42px; solid: true; icon: Ico.download; enabled: !Backend.update-gate-busy;
                    text: Backend.update-gate-busy ? "UPDATING…" : (Backend.update-state == 4 || Backend.update-state == 5 ? "UPDATE NOW" : "TRY AGAIN"); clicked => { Backend.update-now(); } }
                LinkBtn { x: parent.width - 36px - self.width; y: parent.height - 59px; text: "EXIT"; clicked => { Backend.update-exit(); } }
            }
        }

        // ---------- toast ----------
        toast := Rectangle {
            property <length> act-w: Backend.toast-action == "" ? 0px : 130px;
            width: Backend.toast-err ? 560px : Math.clamp(tt.preferred-width + 44px + self.act-w, 300px, 600px);
            height: Backend.toast-err ? 86px : 46px;
            visible: self.opacity > 0;
            tta := TouchArea {
                mouse-cursor: pointer;
                changed has-hover => { Backend.toast-hover = self.has-hover; }
                clicked => { Backend.toast-close(); }
            }
            x: root.W - self.width - 24px; y: root.H - root.deck - 16px - self.height + (Backend.toast-on ? 0px : 10px);
            background: Theme.s2; border-width: 1px; border-color: Backend.toast-err ? Theme.red2.with-alpha(0.533) : Theme.ln2; border-radius: Theme.r2;
            opacity: Backend.toast-on ? 1 : 0;
            animate opacity { duration: Theme.mid; }
            animate y { duration: Theme.slow; easing: ease-out-quint; }
            Rectangle { x: 0px; width: 4px; background: Backend.toast-err ? Theme.red2 : Theme.ice; }
            if Backend.toast-err: Text { x: 20px; y: 10px; text: "SOMETHING WENT WRONG"; color: Theme.redtx; font-family: Theme.pix; font-size: 16px; font-weight: 700; letter-spacing: 0.9px; }
            if Backend.toast-err: Text { x: 20px; y: 30px; width: 520px - toast.act-w; height: 46px; text: Backend.toast-text; color: Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; overflow: elide; }
            tt := Text { x: 20px; width: parent.width - 40px - toast.act-w; visible: !Backend.toast-err; text: Backend.toast-text; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
            if Backend.toast-action != "": Btn { x: parent.width - self.width - 14px; y: (parent.height - self.height) / 2; height: 32px; text: Backend.toast-action; clicked => { Backend.toast-act(); } }
        }
    }
    }
}
