import { Theme } from "theme.slint";
import { Backend, Inst } from "structs.slint";
import { Btn, LinkBtn, Ico, Icon, Pulse, SpinArea } from "components.slint";

// v6 Home = "Dock": the launch target's wallpaper full-bleed, its title and PLAY bottom-left, a glass dock of instances
// bottom-centre, the player standing right of centre and a glass news card on the right. Glass = a darkened translucent fill.
export component HomeScreen inherits Rectangle {
    callback open-instance(int);
    // L2: the crash page of an instance (its Logs tab on the crash report)
    callback open-crash(int);
    callback go-wardrobe();
    callback go-discover();
    property <int> ai: Backend.active-inst;
    property <Inst> cur: Backend.instances[root.ai];
    property <bool> any: Backend.instances.length > 0;
    property <int> tl: root.cur.title.character-count;
    property <length> m: 56px;
    property <bool> can: !root.cur.starting && !root.cur.stopping;
    property <int> shown: Math.min(Backend.instances.length, 9);
    property <length> dock-w: (root.shown + 1) * 66px + 18px;
    property <length> dock-y: root.height - 24px - 84px;
    background: Theme.bg;

    // ---------- wallpaper ----------
    if root.any && root.cur.has-cover: Image { width: root.width; height: root.height; source: root.cur.cover-img; image-fit: cover; }
    Rectangle { background: @linear-gradient(180deg, #00000070 0%, #00000040 35%, #000000a8 75%, #000000e0 100%); }

    // ---------- player, right of centre (always turning; drag to spin) ----------
    if Backend.skin-ready: Image { x: root.width / 2 - 20px; y: 84px; width: 340px; height: 440px; source: Backend.skin-frame; image-fit: contain; }
    SpinArea { x: root.width / 2 - 20px; y: 84px; width: 340px; height: 440px; }

    // ---------- launch target, bottom-left ----------
    if root.any: Rectangle {
        x: root.m; y: root.height - 24px - 84px - 300px; width: 600px; height: 280px;
        if root.cur.running: Pulse { x: 0px; y: 12px; }
        ey := Text { x: root.cur.running ? 16px : 0px; y: 0px; height: 24px; vertical-alignment: center;
            color: root.cur.running || root.cur.crashed ? Theme.red2 : #ffffffb8; font-family: Theme.disp; font-size: 16px; font-weight: 700; letter-spacing: 0.5px;
            text: root.cur.running ? "RUNNING NOW" : (root.cur.crashed ? "LAST SESSION CRASHED" : (root.cur.last == "" ? "READY TO PLAY" : "LAST PLAYED · " + root.cur.last)); }
        if root.cur.crashed && !root.cur.running && !root.cur.starting: LinkBtn { x: ey.x + ey.preferred-width + 18px; y: -2px; text: "VIEW CRASH"; clicked => { root.open-crash(root.ai); } }
        Text { x: 0px; y: 36px; width: 640px; height: 72px; vertical-alignment: center; overflow: elide;
            text: root.cur.title; color: #FFFFFF; font-family: Theme.disp; font-size: 64px; font-weight: 700; }
        Text { x: 0px; y: 116px; width: 640px; height: 24px; vertical-alignment: center; overflow: elide;
            text: root.cur.ver + "  ·  " + root.cur.loader + "  ·  " + root.cur.ram + " GB  ·  " + root.cur.hours + " h played  ·  " + root.cur.mods + " mods";
            color: #ffffffc0; font-family: Theme.ui; font-size: 15px * Theme.ts; }
        // PLAY
        Rectangle {
            x: 0px; y: 164px; width: 210px; height: 56px; border-radius: 8px;
            opacity: root.can ? 1 : 0.5;
            background: pt.pressed ? Theme.press : (pt.has-hover ? Theme.red2 : Theme.red);
            animate background { duration: Theme.fast; }
            if !root.cur.running && !root.cur.starting: Icon { x: 30px; y: 22px; width: 14px; height: 14px; viewbox-width: 12; viewbox-height: 12; d: Ico.play; tint: #FFFFFF; solid: true; }
            Text { x: root.cur.running || root.cur.starting ? 0px : 20px; width: parent.width - (root.cur.running || root.cur.starting ? 0px : 20px); height: parent.height;
                horizontal-alignment: center; vertical-alignment: center; color: #FFFFFF; font-family: Theme.disp; font-size: 24px; font-weight: 700;
                text: root.cur.stopping ? "STOPPING" : (root.cur.running ? "STOP" : (root.cur.starting ? "STARTING" : "PLAY")); }
            pt := TouchArea { mouse-cursor: pointer; enabled: root.can;
                clicked => { if root.cur.running { Backend.stop(root.cur.name); } else { Backend.play(root.cur.name); } } }
        }
        // change the launch target
        Rectangle {
            x: 226px; y: 164px; width: 170px; height: 56px;
            Text { height: parent.height; vertical-alignment: center; text: "Change instance"; color: ch.has-hover ? #FFFFFF : #ffffffc0; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 500; }
            ch := TouchArea { mouse-cursor: pointer; clicked => { pop.show(); } }
            pop := PopupWindow {
                x: 0px; y: -(Math.min(Backend.instances.length, 8) * 40px + 16px); width: 340px; height: Math.min(Backend.instances.length, 8) * 40px + 8px;
                Rectangle {
                    background: Theme.s1; border-width: 1px; border-color: Theme.ln2; border-radius: 8px;
                    Flickable {
                        y: 4px; height: parent.height - 8px; content-height: Backend.instances.length * 40px;
                        for it[i] in Backend.instances: Rectangle {
                            y: i * 40px; height: 40px; width: parent.width;
                            background: t2.has-hover ? Theme.s3 : transparent;
                            Rectangle { x: 0px; y: 8px; width: 3px; height: 24px; background: Theme.red; visible: root.ai == i; }
                            Image { x: 16px; y: 9px; width: 22px; height: 22px; source: it.icon-img; image-rendering: pixelated; }
                            Text { x: 50px; width: 190px; text: it.name; color: root.ai == i || t2.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
                            Text { x: parent.width - 86px; width: 70px; text: it.ver; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                            t2 := TouchArea { clicked => { Backend.active-inst = i; pop.close(); } }
                        }
                    }
                }
            }
        }
    }

    // first run: nothing to launch yet
    if !root.any: Rectangle {
        x: root.m; y: root.height - 24px - 84px - 300px; width: 700px; height: 280px;
        Text { x: 0px; y: 0px; height: 24px; vertical-alignment: center; text: "START HERE"; color: #ffffffb8; font-family: Theme.disp; font-size: 16px; font-weight: 700; }
        Text { x: 0px; y: 36px; width: 700px; height: 72px; vertical-alignment: center; text: "No instances yet"; color: #FFFFFF; font-family: Theme.disp; font-size: 64px; font-weight: 700; }
        Text { x: 0px; y: 116px; width: 560px; text: "An instance is one Minecraft setup: a version, a loader and its own mods and worlds. Make one, or start from a modpack."; color: #ffffffc0; font-family: Theme.ui; font-size: 15px * Theme.ts; wrap: word-wrap; }
        Rectangle {
            x: 0px; y: 190px; width: 230px; height: 56px; border-radius: 8px; background: pn.pressed ? Theme.press : (pn.has-hover ? Theme.red2 : Theme.red);
            Text { text: "NEW INSTANCE"; color: #FFFFFF; font-family: Theme.disp; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            pn := TouchArea { mouse-cursor: pointer; clicked => { Backend.create-open = true; root.open-instance(-1); } }
        }
        Btn { x: 246px; y: 198px; height: 40px; text: "BROWSE MODPACKS"; clicked => { root.go-discover(); } }
    }

    // ---------- news: glass card, right ----------
    property <bool> no-news: Backend.news-failed && Backend.news.length == 0;
    Rectangle {
        x: root.width - root.m - 330px; y: 84px; width: 330px; height: root.no-news ? 96px : 64px + 3 * 62px; border-radius: 12px;
        background: Theme.glass; border-width: 1px; border-color: Theme.glass-ln;
        Text { x: 20px; y: 14px; height: 24px; vertical-alignment: center; text: "NEWS"; color: Theme.dim; font-family: Theme.disp; font-size: 16px; font-weight: 700; }
        LinkBtn { x: parent.width - 20px - self.width; y: 12px; text: "WARDROBE"; clicked => { root.go-wardrobe(); } }
        if Backend.news.length == 0 && !Backend.news-failed: Text { x: 20px; y: 52px; text: "Fetching the latest releases…"; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; }
        if root.no-news: Text { x: 20px; y: 52px; width: parent.width - 40px; text: "No news right now."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; }
        for n[i] in Backend.news: Rectangle {
            visible: i < 3;
            x: 12px; y: 48px + i * 62px; width: parent.width - 24px; height: 58px; border-radius: 6px;
            background: nta.has-hover ? Theme.hov : transparent;
            nta := TouchArea { mouse-cursor: pointer; clicked => { Backend.open-url(n.url); } }
            Text { x: 8px; y: 6px; width: parent.width - 16px; text: n.tag; color: Theme.mut; font-family: Theme.ui; font-size: 11px * Theme.ts; overflow: elide; }
            Text { x: 8px; y: 24px; width: parent.width - 16px; height: 30px; text: n.title; color: Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 500; wrap: word-wrap; overflow: elide; }
        }
    }

    // ---------- job progress: a small glass bar above the dock ----------
    if Backend.job-on: Rectangle {
        x: (root.width - self.width) / 2; y: root.dock-y - 52px; width: 460px; height: 38px; border-radius: 10px;
        background: Theme.glass; border-width: 1px; border-color: Theme.glass-ln;
        Pulse { x: 14px; y: 16px; }
        Text { x: 34px; width: parent.width - 34px - (Backend.job-prog >= 0 ? 150px : 14px); height: parent.height; text: Backend.job-text; color: Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center; overflow: elide; }
        if Backend.job-prog >= 0: Rectangle {
            x: parent.width - 140px; y: 17px; width: 124px; height: 4px; border-radius: 2px; background: Theme.s3;
            Rectangle { width: parent.width * Math.clamp(Backend.job-prog, 0, 1); border-radius: 2px; background: Theme.red2; animate width { duration: Theme.mid; } }
        }
    }

    // ---------- dock: instances, bottom-centre ----------
    Rectangle {
        x: (root.width - self.width) / 2; y: root.dock-y; width: root.dock-w; height: 84px; border-radius: 12px;
        background: Theme.glass; border-width: 1px; border-color: Theme.glass-ln;
        for it[i] in Backend.instances: Rectangle {
            visible: i < 9;
            x: 12px + i * 66px; y: 10px; width: 56px; height: 56px; border-radius: 10px;
            background: root.ai == i ? Theme.ln2 : (dt.has-hover ? Theme.hov : transparent);
            animate background { duration: Theme.fast; }
            Image { x: 8px; y: 8px; width: 40px; height: 40px; source: it.icon-img; image-rendering: pixelated; }
            if it.running: Rectangle { x: parent.width - 12px; y: 4px; width: 8px; height: 8px; border-radius: 4px; background: Theme.red2; }
            if root.ai == i: Rectangle { x: (parent.width - 6px) / 2; y: parent.height + 5px; width: 6px; height: 6px; border-radius: 3px; background: Theme.red2; }
            dt := TouchArea { mouse-cursor: pointer; clicked => { Backend.active-inst = i; } }
        }
        Rectangle {
            x: 12px + root.shown * 66px; y: 10px; width: 56px; height: 56px; border-radius: 10px;
            background: pt2.has-hover ? Theme.hov : transparent; border-width: 1px; border-color: Theme.glass-ln;
            Icon { x: 21px; y: 21px; width: 14px; height: 14px; viewbox-width: 12; viewbox-height: 12; d: Ico.plus; tint: Theme.dim; }
            pt2 := TouchArea { mouse-cursor: pointer; clicked => { Backend.create-open = true; root.open-instance(-1); } }
        }
    }
}
