import { Theme } from "theme.slint";
import { Backend, Inst } from "structs.slint";
import { Btn, LinkBtn, Ico, Icon, Pulse, SpinArea, GroundShadow } from "components.slint";

// Home (Lunar-style, 2026-11-14): a hero banner (the launch target's wallpaper, the player on the right, one big
// accent LAUNCH button in the middle with an instance picker). 2026-11-26: the PROFILES / FRIENDS column under it
// is gone (friends live in the top bar's drawer, instances on Play), so the banner takes the whole page.
export component HomeScreen inherits Rectangle {
    callback open-instance(int);
    // L2: the crash page of an instance (its Logs tab on the crash report)
    callback open-crash(int);
    callback go-wardrobe();
    callback go-discover();
    // the Play page
    callback go-play();
    property <int> ai: Backend.active-inst;
    property <Inst> cur: Backend.instances[root.ai];
    property <bool> any: Backend.instances.length > 0;
    property <length> m: 24px;
    property <bool> can: !root.cur.starting && !root.cur.stopping;
    // the banner takes the whole page
    property <length> hero-h: Math.max(340px, root.height - 2 * root.m);
    // the LAUNCH picker ends in a row to the Play page (every version and way to play)
    property <length> more-h: 48px;
    background: Theme.bg;

    // ---------- hero banner ----------
    Rectangle {
        x: root.m; y: root.m; width: root.width - 2 * root.m; height: root.hero-h; border-radius: Theme.r3; clip: true;
        background: Theme.s1; border-width: 1px; border-color: Theme.ln;
        // static layer: rendered once, so the turning player does not repaint it every frame
        Rectangle { cache-rendering-hint: true;
            if root.any && root.cur.has-cover: Image { width: parent.width; height: parent.height; source: root.cur.cover-img; image-fit: cover; }
            Rectangle { background: @linear-gradient(90deg, #000000a0 0%, #00000040 40%, #00000020 70%, #00000070 100%); }
            // a soft pool of shade behind the centred title and LAUNCH, so they read on bright key art
            Rectangle { background: @radial-gradient(circle, #00000088 0%, #00000044 35%, #00000000 62%); }
            Rectangle { background: @linear-gradient(180deg, #00000000 55%, #000000a0 100%); }
        }

        // player, right side (always turning; drag to spin)
        if Backend.skin-ready: GroundShadow { x: parent.width - 330px + (280px - self.width) / 2; y: parent.height - 44px; }
        // the frame is 3:2 (room for wings/pets); its height matches the old 280-wide 600:780 box, so the player keeps its size
        if Backend.skin-ready: Image { height: Math.min(364px, parent.height - 40px); width: self.height * 1.5; x: parent.width - 190px - self.width / 2; y: 16px + (parent.height - 40px - self.height) / 2;
            source: Backend.skin-frame; image-fit: contain; }
        SpinArea { x: parent.width - 330px; y: 16px; width: 280px; height: parent.height - 40px; }

        // welcome + status, top-left
        Text { x: 28px; y: 22px; height: 24px; vertical-alignment: center; color: #ffffffd8; font-family: Theme.ui; font-size: 16px * Theme.ts; font-weight: 500;
            text: Backend.acct-name != "" ? "Welcome back, " + Backend.acct-name + "." : "Welcome to Nether."; }

        if root.any: Rectangle {
            // centre column: title, spec, LAUNCH
            property <length> cw: 420px;
            x: (parent.width - self.cw) / 2; y: (parent.height - 210px) / 2; width: self.cw; height: 210px;
            if root.cur.running: Pulse { x: (parent.width - st.preferred-width) / 2 - 16px; y: 8px; }
            st := Text { x: 0px; y: 0px; width: parent.width; height: 24px; horizontal-alignment: center; vertical-alignment: center;
                color: root.cur.running || root.cur.crashed ? Theme.red2 : #ffffffb0; font-family: Theme.disp; font-size: 16px; font-weight: 700;
                text: root.cur.running ? "RUNNING NOW" : (root.cur.crashed ? "LAST SESSION CRASHED" : (root.cur.last == "" ? "READY TO PLAY" : "LAST PLAYED · " + root.cur.last)); }
            Text { x: -100px; y: 30px; width: parent.width + 200px; height: 56px; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                text: root.cur.title; color: #FFFFFF; font-family: Theme.pix; font-size: 40px; font-weight: 700; }
            Text { x: -100px; y: 88px; width: parent.width + 200px; height: 22px; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                text: root.cur.ver + "  ·  " + root.cur.loader + "  ·  " + root.cur.mods + " mods  ·  " + root.cur.hours + " h played";
                color: #ffffffb8; font-family: Theme.ui; font-size: 14px * Theme.ts; }
            // LAUNCH: main part plays / stops, the chevron segment picks the instance
            Rectangle {
                y: 126px; width: parent.width; height: 68px; border-radius: Theme.r3;
                background: !root.can ? Theme.s3 : (lt.pressed ? Theme.press : (lt.has-hover ? Theme.red.brighter(0.1) : Theme.red));
                animate background { duration: Theme.fast; }
                // bevel lip (Minecraft button edge), seated when pressed
                drop-shadow-offset-y: root.can && !lt.pressed ? 4px : 0px;
                drop-shadow-color: root.can ? Theme.red.darker(0.5) : transparent;
                Text { x: 0px; y: 10px; width: parent.width - 56px; height: 30px; horizontal-alignment: center; vertical-alignment: center; color: #FFFFFF; font-family: Theme.pix; font-size: 24px; font-weight: 700;
                    text: root.cur.stopping ? "STOPPING" : (root.cur.running ? "STOP" : (root.cur.starting ? "STARTING" : "LAUNCH " + root.cur.ver)); }
                Text { x: 0px; y: 40px; width: parent.width - 56px; height: 18px; horizontal-alignment: center; vertical-alignment: center; color: #ffffffcc; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; overflow: elide;
                    text: root.cur.running ? "Close the game from here" : (root.cur.starting ? "Getting everything ready…" : root.cur.name); }
                lt := TouchArea { width: parent.width - 56px; x: 0px; mouse-cursor: pointer; enabled: root.can;
                    clicked => { if root.cur.running { Backend.stop(root.cur.name); } else { Backend.play(root.cur.name); } } }
                Rectangle { x: parent.width - 56px; width: 1px; y: 14px; height: parent.height - 28px; background: #ffffff40; }
                Rectangle { x: parent.width - 55px; width: 55px; background: ch.has-hover ? #ffffff26 : transparent; animate background { duration: Theme.fast; }
                    Icon { x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2; d: Ico.down; tint: #FFFFFF; }
                    ch := TouchArea { mouse-cursor: pointer; clicked => { pop.show(); } } }
                pop := PopupWindow {
                    x: 0px; y: parent.height + 6px; width: parent.width; height: Math.min(Backend.instances.length, 7) * 40px + 8px + root.more-h;
                    Rectangle {
                        background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                        Flickable {
                            y: 4px; height: parent.height - 8px - root.more-h; content-height: Backend.instances.length * 40px;
                            for it[i] in Backend.instances: Rectangle {
                                y: i * 40px; height: 40px; width: parent.width;
                                background: t2.has-hover ? Theme.s3 : transparent;
                                Rectangle { x: 0px; y: 8px; width: 3px; height: 24px; background: Theme.red; visible: root.ai == i; }
                                Image { x: 16px; y: 9px; width: 22px; height: 22px; source: it.icon-img; image-rendering: pixelated; }
                                Text { x: 50px; width: 250px; text: it.name; color: root.ai == i || t2.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
                                Text { x: parent.width - 96px; width: 80px; text: it.ver; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                                t2 := TouchArea { clicked => { Backend.active-inst = i; pop.close(); } }
                            }
                        }
                        // every version and way to play
                        Rectangle {
                            y: parent.height - root.more-h; height: root.more-h; width: parent.width;
                            background: mt.has-hover ? Theme.s3 : transparent;
                            Rectangle { x: 12px; y: 0px; width: parent.width - 24px; height: 1px; background: Theme.ln; }
                            Icon { x: 18px; y: (parent.height - 12px) / 2; d: Ico.plus; tint: mt.has-hover ? Theme.tx : Theme.dim; }
                            Text { x: 50px; width: parent.width - 80px; text: "More versions and ways to play"; color: mt.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; vertical-alignment: center; overflow: elide; }
                            Icon { x: parent.width - 28px; y: (parent.height - 12px) / 2; d: Ico.chev; tint: mt.has-hover ? Theme.tx : Theme.mut; }
                            mt := TouchArea { mouse-cursor: pointer; clicked => { pop.close(); root.go-play(); } }
                        }
                    }
                }
            }
        }
        if root.any && root.cur.crashed && !root.cur.running && !root.cur.starting: LinkBtn {
            x: (parent.width - self.width) / 2; y: (parent.height + 210px) / 2 + 6px; text: "VIEW CRASH"; clicked => { root.open-crash(root.ai); } }

        // first run: one-click presets (Lunar style), or your own instance
        if !root.any: Rectangle {
            x: (parent.width - 600px) / 2; y: (parent.height - 250px) / 2; width: 600px; height: 250px;
            Text { y: 0px; width: parent.width; height: 24px; horizontal-alignment: center; vertical-alignment: center; text: "START HERE"; color: #ffffffb0; font-family: Theme.disp; font-size: 16px; font-weight: 700; }
            Text { y: 30px; width: parent.width; height: 56px; horizontal-alignment: center; vertical-alignment: center; text: "Pick a version and play"; color: #FFFFFF; font-family: Theme.pix; font-size: 40px; font-weight: 700; }
            for p[k] in Backend.presets: Rectangle {
                x: k * (parent.width / 2 + 6px); y: 100px; width: parent.width / 2 - 6px; height: 82px; border-radius: Theme.r3;
                background: pc.pressed ? Theme.press : (pc.has-hover ? Theme.red2 : (k == 0 ? Theme.red : #ffffff1c));
                border-width: k == 0 ? 0px : 1px; border-color: #ffffff40;
                animate background { duration: Theme.fast; }
                Text { x: 20px; y: 12px; height: 34px; vertical-alignment: center; text: "PLAY " + p.ver; color: #FFFFFF; font-family: Theme.disp; font-size: 28px; font-weight: 700; }
                Text { x: 20px; y: 48px; width: parent.width - 40px; height: 20px; vertical-alignment: center; text: p.sub; color: #ffffffcc; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; overflow: elide; }
                pc := TouchArea { mouse-cursor: pointer; clicked => { Backend.preset-play(p.id); } }
            }
            Text { y: 198px; width: parent.width; horizontal-alignment: center; text: "Both play with the Nether client. Change their mods and settings any time."; color: #ffffffa0; font-family: Theme.ui; font-size: 13px * Theme.ts; }
            LinkBtn { x: (parent.width - self.width) / 2 - 90px; y: 222px; text: "MORE VERSIONS"; clicked => { root.go-play(); } }
            LinkBtn { x: (parent.width - self.width) / 2 + 90px; y: 222px; text: "BROWSE MODPACKS"; clicked => { root.go-discover(); } }
        }

        // job progress, bottom-left of the banner
        if Backend.job-on: Rectangle {
            x: 20px; y: parent.height - 20px - 38px; width: 440px; height: 38px; border-radius: Theme.r3;
            background: Theme.glass; border-width: 1px; border-color: Theme.glass-ln;
            Pulse { x: 14px; y: 16px; }
            Text { x: 34px; width: parent.width - 34px - (Backend.job-prog >= 0 ? 150px : 14px); height: parent.height; text: Backend.job-text; color: Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center; overflow: elide; }
            if Backend.job-prog >= 0: Rectangle {
                x: parent.width - 140px; y: 17px; width: 124px; height: 4px; border-radius: 2px; background: Theme.s3;
                Rectangle { width: parent.width * Math.clamp(Backend.job-prog, 0, 1); border-radius: 2px; background: Theme.red2; animate width { duration: Theme.mid; } }
            }
        }
    }
}
