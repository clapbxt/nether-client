import { Theme } from "theme.slint";
import { Backend, Inst } from "structs.slint";
import { Btn, LinkBtn, Ico, Icon, Pulse, SpinArea, GroundShadow } from "components.slint";
import { Friends, FColor, Head } from "friends.slint";

// Home (Lunar-style, 2026-11-14): a hero banner (the launch target's wallpaper, the player on the right, one big
// accent LAUNCH button in the middle with an instance picker), then LATEST NEWS cards on the left and, on the right,
// PROFILES or FRIENDS (Lunar's friends column): it follows who is online until you pick one.
export component HomeScreen inherits Rectangle {
    callback open-instance(int);
    // L2: the crash page of an instance (its Logs tab on the crash report)
    callback open-crash(int);
    callback go-wardrobe();
    callback go-discover();
    // Play page, Nether tab (every version and way to play)
    callback go-play();
    property <int> ai: Backend.active-inst;
    property <Inst> cur: Backend.instances[root.ai];
    property <bool> any: Backend.instances.length > 0;
    property <length> m: 24px;
    property <bool> can: !root.cur.starting && !root.cur.stopping;
    // the lower row (news cards, instances) is a fixed 190; the banner takes the rest
    property <length> hero-h: Math.max(340px, root.height - 2 * root.m - 28px - 40px - 190px);
    property <length> side-w: 340px;
    // the LAUNCH picker ends in a row to the Play page (every version and way to play)
    property <length> more-h: 48px;
    property <length> low-y: root.m + root.hero-h + 28px;
    background: Theme.bg;

    // ---------- hero banner ----------
    Rectangle {
        x: root.m; y: root.m; width: root.width - 2 * root.m; height: root.hero-h; border-radius: Theme.r3; clip: true;
        background: Theme.s1; border-width: 1px; border-color: Theme.ln;
        // static layer: rendered once, so the turning player does not repaint it every frame
        Rectangle { cache-rendering-hint: true;
            if root.any && root.cur.has-cover: Image { width: parent.width; height: parent.height; source: root.cur.cover-img; image-fit: cover; }
            Rectangle { background: @linear-gradient(90deg, #000000a0 0%, #00000040 40%, #00000020 70%, #00000070 100%); }
            // a soft pool of shade behind the centred title and LAUNCH, so they read on bright key art
            Rectangle { background: @radial-gradient(circle, #00000088 0%, #00000044 35%, #00000000 62%); }
            Rectangle { background: @linear-gradient(180deg, #00000000 55%, #000000a0 100%); }
        }

        // player, right side (always turning; drag to spin)
        if Backend.skin-ready: GroundShadow { x: parent.width - 330px + (280px - self.width) / 2; y: parent.height - 44px; }
        // the frame is 3:2 (room for wings/pets); its height matches the old 280-wide 600:780 box, so the player keeps its size
        if Backend.skin-ready: Image { height: Math.min(364px, parent.height - 40px); width: self.height * 1.5; x: parent.width - 190px - self.width / 2; y: 16px + (parent.height - 40px - self.height) / 2;
            source: Backend.skin-frame; image-fit: contain; }
        SpinArea { x: parent.width - 330px; y: 16px; width: 280px; height: parent.height - 40px; }

        // welcome + status, top-left
        Text { x: 28px; y: 22px; height: 24px; vertical-alignment: center; color: #ffffffd8; font-family: Theme.ui; font-size: 16px * Theme.ts; font-weight: 500;
            text: Backend.acct-name != "" ? "Welcome back, " + Backend.acct-name + "." : "Welcome to Nether."; }

        if root.any: Rectangle {
            // centre column: title, spec, LAUNCH
            property <length> cw: 420px;
            x: (parent.width - self.cw) / 2; y: (parent.height - 210px) / 2; width: self.cw; height: 210px;
            if root.cur.running: Pulse { x: (parent.width - st.preferred-width) / 2 - 16px; y: 8px; }
            st := Text { x: 0px; y: 0px; width: parent.width; height: 24px; horizontal-alignment: center; vertical-alignment: center;
                color: root.cur.running || root.cur.crashed ? Theme.red2 : #ffffffb0; font-family: Theme.disp; font-size: 16px; font-weight: 700;
                text: root.cur.running ? "RUNNING NOW" : (root.cur.crashed ? "LAST SESSION CRASHED" : (root.cur.last == "" ? "READY TO PLAY" : "LAST PLAYED · " + root.cur.last)); }
            Text { x: -100px; y: 30px; width: parent.width + 200px; height: 56px; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                text: root.cur.title; color: #FFFFFF; font-family: Theme.disp; font-size: 48px; font-weight: 700; }
            Text { x: -100px; y: 88px; width: parent.width + 200px; height: 22px; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                text: root.cur.ver + "  ·  " + root.cur.loader + "  ·  " + root.cur.mods + " mods  ·  " + root.cur.hours + " h played";
                color: #ffffffb8; font-family: Theme.ui; font-size: 14px * Theme.ts; }
            // LAUNCH: main part plays / stops, the chevron segment picks the instance
            Rectangle {
                y: 126px; width: parent.width; height: 68px; border-radius: Theme.r3; clip: true;
                background: !root.can ? Theme.s3 : (lt.pressed ? Theme.press : (lt.has-hover ? Theme.red2 : Theme.red));
                animate background { duration: Theme.fast; }
                Text { x: 0px; y: 10px; width: parent.width - 56px; height: 30px; horizontal-alignment: center; vertical-alignment: center; color: #FFFFFF; font-family: Theme.disp; font-size: 24px; font-weight: 700;
                    text: root.cur.stopping ? "STOPPING" : (root.cur.running ? "STOP" : (root.cur.starting ? "STARTING" : "LAUNCH " + root.cur.ver)); }
                Text { x: 0px; y: 40px; width: parent.width - 56px; height: 18px; horizontal-alignment: center; vertical-alignment: center; color: #ffffffcc; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; overflow: elide;
                    text: root.cur.running ? "Close the game from here" : (root.cur.starting ? "Getting everything ready…" : root.cur.name); }
                lt := TouchArea { width: parent.width - 56px; x: 0px; mouse-cursor: pointer; enabled: root.can;
                    clicked => { if root.cur.running { Backend.stop(root.cur.name); } else { Backend.play(root.cur.name); } } }
                Rectangle { x: parent.width - 56px; width: 1px; y: 14px; height: parent.height - 28px; background: #ffffff40; }
                Rectangle { x: parent.width - 55px; width: 55px; background: ch.has-hover ? #ffffff26 : transparent; animate background { duration: Theme.fast; }
                    Icon { x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2; d: Ico.down; tint: #FFFFFF; }
                    ch := TouchArea { mouse-cursor: pointer; clicked => { pop.show(); } } }
                pop := PopupWindow {
                    x: 0px; y: parent.height + 6px; width: parent.width; height: Math.min(Backend.instances.length, 7) * 40px + 8px + root.more-h;
                    Rectangle {
                        background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                        Flickable {
                            y: 4px; height: parent.height - 8px - root.more-h; content-height: Backend.instances.length * 40px;
                            for it[i] in Backend.instances: Rectangle {
                                y: i * 40px; height: 40px; width: parent.width;
                                background: t2.has-hover ? Theme.s3 : transparent;
                                Rectangle { x: 0px; y: 8px; width: 3px; height: 24px; background: Theme.red; visible: root.ai == i; }
                                Image { x: 16px; y: 9px; width: 22px; height: 22px; source: it.icon-img; image-rendering: pixelated; }
                                Text { x: 50px; width: 250px; text: it.name; color: root.ai == i || t2.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
                                Text { x: parent.width - 96px; width: 80px; text: it.ver; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                                t2 := TouchArea { clicked => { Backend.active-inst = i; pop.close(); } }
                            }
                        }
                        // every version and way to play
                        Rectangle {
                            y: parent.height - root.more-h; height: root.more-h; width: parent.width;
                            background: mt.has-hover ? Theme.s3 : transparent;
                            Rectangle { x: 12px; y: 0px; width: parent.width - 24px; height: 1px; background: Theme.ln; }
                            Icon { x: 18px; y: (parent.height - 12px) / 2; d: Ico.plus; tint: mt.has-hover ? Theme.tx : Theme.dim; }
                            Text { x: 50px; width: parent.width - 80px; text: "More versions and ways to play"; color: mt.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; vertical-alignment: center; overflow: elide; }
                            Icon { x: parent.width - 28px; y: (parent.height - 12px) / 2; d: Ico.chev; tint: mt.has-hover ? Theme.tx : Theme.mut; }
                            mt := TouchArea { mouse-cursor: pointer; clicked => { pop.close(); root.go-play(); } }
                        }
                    }
                }
            }
        }
        if root.any && root.cur.crashed && !root.cur.running && !root.cur.starting: LinkBtn {
            x: (parent.width - self.width) / 2; y: (parent.height + 210px) / 2 + 6px; text: "VIEW CRASH"; clicked => { root.open-crash(root.ai); } }

        // first run: one-click presets (Lunar style), or your own instance
        if !root.any: Rectangle {
            x: (parent.width - 600px) / 2; y: (parent.height - 250px) / 2; width: 600px; height: 250px;
            Text { y: 0px; width: parent.width; height: 24px; horizontal-alignment: center; vertical-alignment: center; text: "START HERE"; color: #ffffffb0; font-family: Theme.disp; font-size: 16px; font-weight: 700; }
            Text { y: 30px; width: parent.width; height: 56px; horizontal-alignment: center; vertical-alignment: center; text: "Pick a version and play"; color: #FFFFFF; font-family: Theme.disp; font-size: 44px; font-weight: 700; }
            for p[k] in Backend.presets: Rectangle {
                x: k * (parent.width / 2 + 6px); y: 100px; width: parent.width / 2 - 6px; height: 82px; border-radius: Theme.r3;
                background: pc.pressed ? Theme.press : (pc.has-hover ? Theme.red2 : (k == 0 ? Theme.red : #ffffff1c));
                border-width: k == 0 ? 0px : 1px; border-color: #ffffff40;
                animate background { duration: Theme.fast; }
                Text { x: 20px; y: 12px; height: 34px; vertical-alignment: center; text: "PLAY " + p.ver; color: #FFFFFF; font-family: Theme.disp; font-size: 28px; font-weight: 700; }
                Text { x: 20px; y: 48px; width: parent.width - 40px; height: 20px; vertical-alignment: center; text: p.sub; color: #ffffffcc; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; overflow: elide; }
                pc := TouchArea { mouse-cursor: pointer; clicked => { Backend.preset-play(p.id); } }
            }
            Text { y: 198px; width: parent.width; horizontal-alignment: center; text: "Both play with the Nether client. Change their mods and settings any time."; color: #ffffffa0; font-family: Theme.ui; font-size: 13px * Theme.ts; }
            LinkBtn { x: (parent.width - self.width) / 2 - 90px; y: 222px; text: "MORE VERSIONS"; clicked => { root.go-play(); } }
            LinkBtn { x: (parent.width - self.width) / 2 + 90px; y: 222px; text: "BROWSE MODPACKS"; clicked => { root.go-discover(); } }
        }

        // job progress, bottom-left of the banner
        if Backend.job-on: Rectangle {
            x: 20px; y: parent.height - 20px - 38px; width: 440px; height: 38px; border-radius: Theme.r3;
            background: Theme.glass; border-width: 1px; border-color: Theme.glass-ln;
            Pulse { x: 14px; y: 16px; }
            Text { x: 34px; width: parent.width - 34px - (Backend.job-prog >= 0 ? 150px : 14px); height: parent.height; text: Backend.job-text; color: Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center; overflow: elide; }
            if Backend.job-prog >= 0: Rectangle {
                x: parent.width - 140px; y: 17px; width: 124px; height: 4px; border-radius: 2px; background: Theme.s3;
                Rectangle { width: parent.width * Math.clamp(Backend.job-prog, 0, 1); border-radius: 2px; background: Theme.red2; animate width { duration: Theme.mid; } }
            }
        }
    }

    // ---------- latest news: cards, left ----------
    property <length> news-w: root.width - 2 * root.m - root.side-w - 24px;
    property <length> card-w: (root.news-w - 2 * 16px) / 3;
    property <length> card-h: 190px;
    property <bool> no-news: Backend.news-failed && Backend.news.length == 0;
    Text { x: root.m; y: root.low-y; height: 24px; vertical-alignment: center; text: "LATEST NEWS"; color: Theme.tx; font-family: Theme.disp; font-size: 24px; font-weight: 700; }
    LinkBtn { x: root.m + root.news-w - self.width; y: root.low-y + 2px; text: "DISCOVER"; clicked => { root.go-discover(); } }
    if Backend.news.length == 0: Rectangle {
        x: root.m; y: root.low-y + 40px; width: root.news-w; height: root.card-h; border-radius: Theme.r3; background: Theme.s1; border-width: 1px; border-color: Theme.ln;
        Text { text: root.no-news ? "No news right now." : "Fetching the latest releases…"; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; horizontal-alignment: center; vertical-alignment: center; }
    }
    for n[i] in Backend.news: nc := Rectangle {
        visible: i < 3;
        x: root.m + i * (root.card-w + 16px); y: root.low-y + 40px; width: root.card-w; height: root.card-h; border-radius: Theme.r3; clip: true;
        background: Theme.s2;
        // the release's art from Mojang's launcher feed, else our banner; it leans in on hover
        Image {
            property <float> zoom: nta.has-hover ? 1.05 : 1.0;
            animate zoom { duration: Theme.slow; easing: ease-out; }
            width: parent.width * self.zoom; height: parent.height * self.zoom;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            source: n.has-img ? n.img : @image-url("assets/banner.jpg"); image-fit: cover;
        }
        Rectangle { background: @linear-gradient(180deg, #00000020 0%, #00000000 25%, #000000c0 62%, #000000f0 100%); }
        Rectangle {
            x: 14px; y: 14px; width: ntg.preferred-width + 14px; height: 20px; border-radius: 4px; background: i == 0 ? Theme.red : #000000a8;
            ntg := Text { text: n.tag; color: #FFFFFF; font-family: Theme.mono; font-size: 10px; font-weight: 700; letter-spacing: 1px; horizontal-alignment: center; vertical-alignment: center; }
        }
        Icon { x: parent.width - 30px; y: 18px; d: Ico.ext; tint: nta.has-hover ? #FFFFFF : #ffffff80; }
        Text { x: 16px; y: parent.height - 64px; width: parent.width - 32px; height: 46px; text: n.title; color: #FFFFFF; font-family: Theme.disp; font-size: 19px; font-weight: 700; wrap: word-wrap; overflow: elide; vertical-alignment: bottom; }
        Rectangle { border-radius: Theme.r3; border-width: 1px; border-color: nta.has-hover ? #ffffff40 : #ffffff14; animate border-color { duration: Theme.fast; } }
        nta := TouchArea { mouse-cursor: pointer; clicked => { Backend.open-url(n.url); } }
    }

    // ---------- right column: PROFILES | FRIENDS (Lunar's friends column) ----------
    property <length> side-x: root.width - root.m - root.side-w;
    // -1 = not picked: FRIENDS while any friend is online, else PROFILES
    property <int> side-pick: -1;
    property <int> side: root.side-pick >= 0 ? root.side-pick : (Friends.online > 0 ? 1 : 0);
    for t[i] in ["PROFILES", "FRIENDS"]: Rectangle {
        x: root.side-x + (i == 0 ? 0px : 128px); y: root.low-y; height: 24px; width: tt.preferred-width + (i == 1 && Friends.online > 0 ? 34px : 0px);
        tt := Text { x: 0px; height: parent.height; vertical-alignment: center; text: t; font-family: Theme.disp; font-size: 24px; font-weight: 700;
            color: root.side == i ? Theme.tx : (ta.has-hover ? Theme.dim : Theme.mut); animate color { duration: Theme.fast; } }
        if i == 1 && Friends.online > 0: Rectangle {
            x: tt.preferred-width + 10px; y: 8px; width: 8px; height: 8px; border-radius: 4px; background: FColor.dot[1]; }
        if i == 1 && Friends.online > 0: Text { x: tt.preferred-width + 22px; height: parent.height; vertical-alignment: center; text: Friends.online;
            color: Theme.dim; font-family: Theme.mono; font-size: 12px * Theme.ts; font-weight: 600; }
        ta := TouchArea { mouse-cursor: pointer; clicked => { root.side-pick = i; } }
    }
    LinkBtn { x: root.side-x + root.side-w - self.width; y: root.low-y + 2px; text: "ALL";
        clicked => { if root.side == 0 { root.go-play(); } else { Friends.open = true; Backend.acct-open = false; Friends.refresh(); } } }
    if root.side == 1: Rectangle {
        x: root.side-x; y: root.low-y + 40px; width: root.side-w; height: root.card-h; border-radius: Theme.r3; clip: true;
        background: Theme.s1; border-width: 1px; border-color: Theme.ln;
        // not signed in / nobody yet: what friends are for, one way in
        if !Friends.ready || Friends.total == 0: Rectangle {
            Text { x: 20px; y: 18px; text: "Play together"; color: Theme.tx; font-family: Theme.disp; font-size: 20px; font-weight: 700; }
            Text { x: 20px; y: 48px; width: parent.width - 40px; wrap: word-wrap; color: Theme.dim; font-family: Theme.ui; font-size: 12px * Theme.ts;
                text: !Friends.ready ? "Sign in with your Microsoft account to add friends, see where they play and join them in one click."
                    : "Add friends by their Minecraft name. See where they play, join in one click, and party up on the title screen in game."; }
            if Friends.ready: Btn { x: 20px; y: parent.height - 20px - 34px; height: 34px; text: "ADD A FRIEND";
                clicked => { Friends.open = true; Backend.acct-open = false; Friends.tab = 0; Friends.refresh(); } }
        }
        if Friends.ready && Friends.total > 0: Flickable {
            y: 6px; height: parent.height - 12px; content-height: Friends.friends.length * 48px;
            for r[i] in Friends.friends: Rectangle {
                y: i * 48px; x: 6px; width: parent.width - 12px; height: 46px; border-radius: Theme.r2;
                background: ft.has-hover ? Theme.hov : transparent;
                animate background { duration: Theme.fast; }
                Head { x: 6px; y: 5px; img: r.head; has-img: r.has-head; status: r.status; }
                Text { x: 52px; y: 5px; width: parent.width - 52px - (ft.has-hover && (r.can-join || r.can-invite) ? 84px : 8px); text: r.name; overflow: elide;
                    color: r.status > 0 ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; }
                Text { x: 52px; y: 25px; width: parent.width - 52px - (ft.has-hover && (r.can-join || r.can-invite) ? 84px : 8px); overflow: elide;
                    text: r.activity + (r.detail != "" ? " · " + r.detail : ""); color: r.status > 0 ? Theme.dim : Theme.mut; font-family: Theme.ui; font-size: 11px * Theme.ts; }
                ft := TouchArea { mouse-cursor: pointer; clicked => { Friends.open = true; Backend.acct-open = false; Friends.refresh(); } }
                // the drawer's own actions, on hover: JOIN where they are, else INVITE them where you are
                if ft.has-hover && (r.can-join || r.can-invite): Btn { x: parent.width - self.width - 8px; y: 8px; height: 30px;
                    text: r.can-join ? "JOIN" : "INVITE"; solid: r.can-join;
                    clicked => { Friends.act(r.can-join ? "join" : "invite", r.uuid); } }
            }
        }
    }
    if root.side == 0: Rectangle {
        x: root.side-x; y: root.low-y + 40px; width: root.side-w; height: root.card-h; border-radius: Theme.r3; clip: true;
        background: Theme.s1; border-width: 1px; border-color: Theme.ln;
        if !root.any: Text { text: "Your profiles show up here."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; horizontal-alignment: center; vertical-alignment: center; }
        Flickable {
            y: 6px; height: parent.height - 12px; content-height: Backend.instances.length * 48px;
            for it[i] in Backend.instances: Rectangle {
                y: i * 48px; x: 6px; width: parent.width - 12px; height: 46px; border-radius: Theme.r2;
                background: root.ai == i ? Theme.red.with-alpha(0.14) : (rt.has-hover ? Theme.hov : transparent);
                animate background { duration: Theme.fast; }
                Rectangle { x: 8px; y: 7px; width: 32px; height: 32px; border-radius: Theme.r1; background: Theme.s3;
                    Image { x: 4px; y: 4px; width: 24px; height: 24px; source: it.icon-img; image-rendering: pixelated; } }
                Text { x: 50px; y: 5px; width: parent.width - 50px - 44px; text: it.name; color: root.ai == i || rt.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                Text { x: 50px; y: 25px; width: parent.width - 50px - 44px; overflow: elide; font-family: Theme.ui; font-size: 11px * Theme.ts;
                    color: it.running ? Theme.red2 : Theme.mut;
                    text: it.running ? "Playing now" : it.ver + " · " + it.loader + (it.last == "" ? "" : " · " + it.last); }
                // play this one straight away
                Rectangle {
                    x: parent.width - 38px; y: 8px; width: 30px; height: 30px; border-radius: Theme.r1;
                    visible: rt.has-hover || pb.has-hover;
                    background: pb.has-hover ? Theme.red : Theme.s3;
                    Icon { x: 9px; y: 9px; d: Ico.play; tint: #FFFFFF; solid: true; }
                    pb := TouchArea { mouse-cursor: pointer; clicked => { Backend.active-inst = i; if !it.running && !it.starting { Backend.play(it.name); } } }
                }
                rt := TouchArea { width: parent.width - 44px; x: 0px; mouse-cursor: pointer; clicked => { Backend.active-inst = i; } double-clicked => { root.open-instance(i); } }
            }
        }
    }
}
