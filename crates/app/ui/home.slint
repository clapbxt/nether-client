import { Theme } from "theme.slint";
import { Backend, Inst } from "structs.slint";
import { Btn, LinkBtn, Ico, Icon, Pulse, SpinArea, GroundShadow } from "components.slint";

// Home (Lunar-style, 2026-11-14): a hero banner (the launch target's wallpaper, the player on the right, one big
// accent LAUNCH button in the middle with an instance picker), then LATEST NEWS cards on the left and an INSTANCES
// list on the right (Lunar's friends column).
export component HomeScreen inherits Rectangle {
    callback open-instance(int);
    // L2: the crash page of an instance (its Logs tab on the crash report)
    callback open-crash(int);
    callback go-wardrobe();
    callback go-discover();
    property <int> ai: Backend.active-inst;
    property <Inst> cur: Backend.instances[root.ai];
    property <bool> any: Backend.instances.length > 0;
    property <length> m: 24px;
    property <bool> can: !root.cur.starting && !root.cur.stopping;
    // the lower row (news cards, instances) is a fixed 190; the banner takes the rest
    property <length> hero-h: Math.max(340px, root.height - 2 * root.m - 28px - 40px - 190px);
    property <length> side-w: 340px;
    property <length> low-y: root.m + root.hero-h + 28px;
    background: Theme.bg;

    // ---------- hero banner ----------
    Rectangle {
        x: root.m; y: root.m; width: root.width - 2 * root.m; height: root.hero-h; border-radius: 12px; clip: true;
        background: Theme.s1; border-width: 1px; border-color: Theme.ln;
        // static layer: rendered once, so the turning player does not repaint it every frame
        Rectangle { cache-rendering-hint: true;
            if root.any && root.cur.has-cover: Image { width: parent.width; height: parent.height; source: root.cur.cover-img; image-fit: cover; }
            Rectangle { background: @linear-gradient(90deg, #000000b0 0%, #00000060 45%, #00000030 70%, #00000080 100%); }
            Rectangle { background: @linear-gradient(180deg, #00000000 55%, #000000a0 100%); }
        }

        // player, right side (always turning; drag to spin)
        if Backend.skin-ready: GroundShadow { x: parent.width - 330px + (280px - self.width) / 2; y: parent.height - 44px; }
        if Backend.skin-ready: Image { x: parent.width - 330px; y: 16px; width: 280px; height: parent.height - 40px; source: Backend.skin-frame; image-fit: contain; }
        SpinArea { x: parent.width - 330px; y: 16px; width: 280px; height: parent.height - 40px; }

        // welcome + status, top-left
        Text { x: 28px; y: 22px; height: 24px; vertical-alignment: center; color: #ffffffd8; font-family: Theme.ui; font-size: 16px * Theme.ts; font-weight: 500;
            text: Backend.acct-name != "" ? "Welcome back, " + Backend.acct-name + "." : "Welcome to Nether."; }

        if root.any: Rectangle {
            // centre column: title, spec, LAUNCH
            property <length> cw: 420px;
            x: (parent.width - self.cw) / 2; y: (parent.height - 210px) / 2; width: self.cw; height: 210px;
            if root.cur.running: Pulse { x: (parent.width - st.preferred-width) / 2 - 16px; y: 8px; }
            st := Text { x: 0px; y: 0px; width: parent.width; height: 24px; horizontal-alignment: center; vertical-alignment: center;
                color: root.cur.running || root.cur.crashed ? Theme.red2 : #ffffffb0; font-family: Theme.disp; font-size: 16px; font-weight: 700;
                text: root.cur.running ? "RUNNING NOW" : (root.cur.crashed ? "LAST SESSION CRASHED" : (root.cur.last == "" ? "READY TO PLAY" : "LAST PLAYED · " + root.cur.last)); }
            Text { x: -100px; y: 30px; width: parent.width + 200px; height: 56px; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                text: root.cur.title; color: #FFFFFF; font-family: Theme.disp; font-size: 48px; font-weight: 700; }
            Text { x: -100px; y: 88px; width: parent.width + 200px; height: 22px; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                text: root.cur.ver + "  ·  " + root.cur.loader + "  ·  " + root.cur.mods + " mods  ·  " + root.cur.hours + " h played";
                color: #ffffffb8; font-family: Theme.ui; font-size: 14px * Theme.ts; }
            // LAUNCH: main part plays / stops, the chevron segment picks the instance
            Rectangle {
                y: 126px; width: parent.width; height: 68px; border-radius: 10px; clip: true;
                background: !root.can ? Theme.s3 : (lt.pressed ? Theme.press : (lt.has-hover ? Theme.red2 : Theme.red));
                animate background { duration: Theme.fast; }
                Text { x: 0px; y: 10px; width: parent.width - 56px; height: 30px; horizontal-alignment: center; vertical-alignment: center; color: #FFFFFF; font-family: Theme.disp; font-size: 24px; font-weight: 700;
                    text: root.cur.stopping ? "STOPPING" : (root.cur.running ? "STOP" : (root.cur.starting ? "STARTING" : "LAUNCH " + root.cur.ver)); }
                Text { x: 0px; y: 40px; width: parent.width - 56px; height: 18px; horizontal-alignment: center; vertical-alignment: center; color: #ffffffcc; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; overflow: elide;
                    text: root.cur.running ? "Close the game from here" : (root.cur.starting ? "Getting everything ready…" : root.cur.name); }
                lt := TouchArea { width: parent.width - 56px; x: 0px; mouse-cursor: pointer; enabled: root.can;
                    clicked => { if root.cur.running { Backend.stop(root.cur.name); } else { Backend.play(root.cur.name); } } }
                Rectangle { x: parent.width - 56px; width: 1px; y: 14px; height: parent.height - 28px; background: #ffffff40; }
                Rectangle { x: parent.width - 55px; width: 55px; background: ch.has-hover ? #ffffff26 : transparent; animate background { duration: Theme.fast; }
                    Icon { x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2; d: Ico.down; tint: #FFFFFF; }
                    ch := TouchArea { mouse-cursor: pointer; clicked => { pop.show(); } } }
                pop := PopupWindow {
                    x: 0px; y: parent.height + 6px; width: parent.width; height: Math.min(Backend.instances.length, 7) * 40px + 8px;
                    Rectangle {
                        background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: 8px;
                        Flickable {
                            y: 4px; height: parent.height - 8px; content-height: Backend.instances.length * 40px;
                            for it[i] in Backend.instances: Rectangle {
                                y: i * 40px; height: 40px; width: parent.width;
                                background: t2.has-hover ? Theme.s3 : transparent;
                                Rectangle { x: 0px; y: 8px; width: 3px; height: 24px; background: Theme.red; visible: root.ai == i; }
                                Image { x: 16px; y: 9px; width: 22px; height: 22px; source: it.icon-img; image-rendering: pixelated; }
                                Text { x: 50px; width: 250px; text: it.name; color: root.ai == i || t2.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
                                Text { x: parent.width - 96px; width: 80px; text: it.ver; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                                t2 := TouchArea { clicked => { Backend.active-inst = i; pop.close(); } }
                            }
                        }
                    }
                }
            }
        }
        if root.any && root.cur.crashed && !root.cur.running && !root.cur.starting: LinkBtn {
            x: (parent.width - self.width) / 2; y: (parent.height + 210px) / 2 + 6px; text: "VIEW CRASH"; clicked => { root.open-crash(root.ai); } }

        // first run: nothing to launch yet
        if !root.any: Rectangle {
            x: (parent.width - 560px) / 2; y: (parent.height - 200px) / 2; width: 560px; height: 200px;
            Text { y: 0px; width: parent.width; height: 24px; horizontal-alignment: center; vertical-alignment: center; text: "START HERE"; color: #ffffffb0; font-family: Theme.disp; font-size: 16px; font-weight: 700; }
            Text { y: 30px; width: parent.width; height: 56px; horizontal-alignment: center; vertical-alignment: center; text: "No instances yet"; color: #FFFFFF; font-family: Theme.disp; font-size: 48px; font-weight: 700; }
            Text { y: 90px; width: parent.width; horizontal-alignment: center; text: "An instance is one Minecraft setup: a version, a loader and its own mods and worlds."; color: #ffffffb8; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
            Rectangle {
                x: (parent.width - 230px - 12px - 200px) / 2; y: 136px; width: 230px; height: 56px; border-radius: 10px; background: pn.pressed ? Theme.press : (pn.has-hover ? Theme.red2 : Theme.red);
                Text { text: "NEW INSTANCE"; color: #FFFFFF; font-family: Theme.disp; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                pn := TouchArea { mouse-cursor: pointer; clicked => { Backend.create-open = true; root.open-instance(-1); } }
            }
            Btn { x: (parent.width - 230px - 12px - 200px) / 2 + 242px; y: 144px; height: 40px; text: "BROWSE MODPACKS"; clicked => { root.go-discover(); } }
        }

        // job progress, bottom-left of the banner
        if Backend.job-on: Rectangle {
            x: 20px; y: parent.height - 20px - 38px; width: 440px; height: 38px; border-radius: 10px;
            background: Theme.glass; border-width: 1px; border-color: Theme.glass-ln;
            Pulse { x: 14px; y: 16px; }
            Text { x: 34px; width: parent.width - 34px - (Backend.job-prog >= 0 ? 150px : 14px); height: parent.height; text: Backend.job-text; color: Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center; overflow: elide; }
            if Backend.job-prog >= 0: Rectangle {
                x: parent.width - 140px; y: 17px; width: 124px; height: 4px; border-radius: 2px; background: Theme.s3;
                Rectangle { width: parent.width * Math.clamp(Backend.job-prog, 0, 1); border-radius: 2px; background: Theme.red2; animate width { duration: Theme.mid; } }
            }
        }
    }

    // ---------- latest news: cards, left ----------
    property <length> news-w: root.width - 2 * root.m - root.side-w - 24px;
    property <length> card-w: (root.news-w - 2 * 16px) / 3;
    property <length> card-h: 190px;
    property <bool> no-news: Backend.news-failed && Backend.news.length == 0;
    Text { x: root.m; y: root.low-y; height: 24px; vertical-alignment: center; text: "LATEST NEWS"; color: Theme.tx; font-family: Theme.disp; font-size: 24px; font-weight: 700; }
    LinkBtn { x: root.m + root.news-w - self.width; y: root.low-y + 2px; text: "DISCOVER"; clicked => { root.go-discover(); } }
    if Backend.news.length == 0: Rectangle {
        x: root.m; y: root.low-y + 40px; width: root.news-w; height: root.card-h; border-radius: 10px; background: Theme.s1; border-width: 1px; border-color: Theme.ln;
        Text { text: root.no-news ? "No news right now." : "Fetching the latest releases…"; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; horizontal-alignment: center; vertical-alignment: center; }
    }
    for n[i] in Backend.news: Rectangle {
        visible: i < 3;
        x: root.m + i * (root.card-w + 16px); y: root.low-y + 40px; width: root.card-w; height: root.card-h; border-radius: 10px; clip: true;
        background: nta.has-hover ? Theme.s2 : Theme.s1; border-width: 1px; border-color: nta.has-hover ? Theme.ln2 : Theme.ln;
        animate background, border-color { duration: Theme.fast; }
        // accent strip + big tag (the news feed has no images)
        Rectangle { height: 4px; y: 0px; background: i == 0 ? Theme.red : Theme.s3; }
        Text { x: 18px; y: 22px; width: parent.width - 36px; text: n.tag; color: i == 0 ? Theme.red2 : Theme.dim; font-family: Theme.disp; font-size: 16px; font-weight: 700; overflow: elide; }
        Text { x: 18px; y: 50px; width: parent.width - 36px; height: parent.height - 50px - 40px; text: n.title; color: Theme.tx; font-family: Theme.ui; font-size: 16px * Theme.ts; font-weight: 600; wrap: word-wrap; overflow: elide; }
        Text { x: 18px; y: parent.height - 34px; text: "Read more"; color: nta.has-hover ? Theme.tx : Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; }
        Icon { x: parent.width - 30px; y: parent.height - 28px; d: Ico.ext; tint: nta.has-hover ? Theme.tx : Theme.mut; }
        nta := TouchArea { mouse-cursor: pointer; clicked => { Backend.open-url(n.url); } }
    }

    // ---------- instances: list, right (Lunar's friends column) ----------
    property <length> side-x: root.width - root.m - root.side-w;
    Text { x: root.side-x; y: root.low-y; height: 24px; vertical-alignment: center; text: "INSTANCES"; color: Theme.tx; font-family: Theme.disp; font-size: 24px; font-weight: 700; }
    LinkBtn { x: root.side-x + root.side-w - self.width; y: root.low-y + 2px; text: "NEW"; clicked => { Backend.create-open = true; root.open-instance(-1); } }
    Rectangle {
        x: root.side-x; y: root.low-y + 40px; width: root.side-w; height: root.card-h; border-radius: 10px; clip: true;
        background: Theme.s1; border-width: 1px; border-color: Theme.ln;
        if !root.any: Text { text: "Your instances show up here."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; horizontal-alignment: center; vertical-alignment: center; }
        Flickable {
            y: 6px; height: parent.height - 12px; content-height: Backend.instances.length * 48px;
            for it[i] in Backend.instances: Rectangle {
                y: i * 48px; x: 6px; width: parent.width - 12px; height: 46px; border-radius: 8px;
                background: root.ai == i ? Theme.red.with-alpha(0.14) : (rt.has-hover ? Theme.hov : transparent);
                animate background { duration: Theme.fast; }
                Rectangle { x: 8px; y: 7px; width: 32px; height: 32px; border-radius: 6px; background: Theme.s3;
                    Image { x: 4px; y: 4px; width: 24px; height: 24px; source: it.icon-img; image-rendering: pixelated; } }
                Text { x: 50px; y: 5px; width: parent.width - 50px - 44px; text: it.name; color: root.ai == i || rt.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                Text { x: 50px; y: 25px; width: parent.width - 50px - 44px; overflow: elide; font-family: Theme.ui; font-size: 11px * Theme.ts;
                    color: it.running ? Theme.red2 : Theme.mut;
                    text: it.running ? "Playing now" : it.ver + " · " + it.loader + (it.last == "" ? "" : " · " + it.last); }
                // play this one straight away
                Rectangle {
                    x: parent.width - 38px; y: 8px; width: 30px; height: 30px; border-radius: 6px;
                    visible: rt.has-hover || pb.has-hover;
                    background: pb.has-hover ? Theme.red : Theme.s3;
                    Icon { x: 9px; y: 9px; d: Ico.play; tint: #FFFFFF; solid: true; }
                    pb := TouchArea { mouse-cursor: pointer; clicked => { Backend.active-inst = i; if !it.running && !it.starting { Backend.play(it.name); } } }
                }
                rt := TouchArea { width: parent.width - 44px; x: 0px; mouse-cursor: pointer; clicked => { Backend.active-inst = i; } double-clicked => { root.open-instance(i); } }
            }
        }
    }
}
