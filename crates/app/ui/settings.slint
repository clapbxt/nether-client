import { Theme } from "theme.slint";
import { Backend, Art, Acct, JavaRt, Link, Sound, ThemeSpec } from "structs.slint";
import { Eyebrow, Heading, Btn, Toggle, Dropdown, IconBtn, Ico, Icon, SectionHead, SetRow, Slash, Seg, Chip, Field, LinkBtn } from "components.slint";

// A row with a switch on the right. A disabled row must not flip (the change would never be saved).
component SyncRow inherits SetRow {
    in property <bool> enabled: true;
    in-out property <bool> on;
    callback toggled(bool);
    reserve: 90px;
    dimmed: !root.enabled;
    Toggle { x: parent.width - 42px; y: 21px; on <=> root.on; enabled: root.enabled; opacity: root.enabled ? 1 : 0.4; toggled(v) => { root.toggled(v); } }
}

// A row with a dropdown on the right.
component ChoiceRow inherits SetRow {
    in property <[string]> items;
    in-out property <int> current;
    callback changed(int);
    reserve: 270px;
    Dropdown { x: parent.width - 240px; y: 12px; width: 240px; items: root.items; current <=> root.current; changed(i) => { root.changed(i); } }
}

// Uploaded icons / wallpapers with an add tile; hover a tile to delete it.
component Uploads inherits Rectangle {
    in property <[Art]> items;
    in property <length> tile;
    in property <bool> pixel;
    callback add();
    callback remove(string);
    property <int> cols: Math.floor((self.width + 8px) / (root.tile + 8px));
    height: Math.ceil((root.items.length + 1) / root.cols) * (root.tile + 8px);
    for a[i] in root.items: Rectangle {
        x: mod(i, root.cols) * (root.tile + 8px); y: floor(i / root.cols) * (root.tile + 8px);
        width: root.tile; height: root.tile; clip: true;
        background: Theme.s2;
        Image { x: root.pixel ? 8px : 0px; y: root.pixel ? 8px : 0px; width: parent.width - (root.pixel ? 16px : 0px); height: parent.height - (root.pixel ? 16px : 0px);
            source: a.img; image-fit: root.pixel ? contain : cover; image-rendering: root.pixel ? pixelated : smooth; }
        ut := TouchArea { }
        Rectangle { x: parent.width - 28px; y: 4px; width: 24px; height: 24px; background: #060608d0; opacity: ut.has-hover || rm.hovered ? 1 : 0; animate opacity { duration: Theme.fast; }
            rm := IconBtn { size: 24px; d: Ico.trash; danger: true; tip: "Remove"; clicked => { root.remove(a.key); } } }
    }
    Rectangle {
        x: mod(root.items.length, root.cols) * (root.tile + 8px); y: floor(root.items.length / root.cols) * (root.tile + 8px);
        width: root.tile; height: root.tile;
        background: at.has-hover ? Theme.s2 : transparent; border-width: 1px; border-color: at.has-hover ? Theme.red2 : Theme.ln2; border-radius: Theme.r2;
        animate background, border-color { duration: Theme.mid; }
        Icon { x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2; d: Ico.plus; tint: at.has-hover ? Theme.tx : Theme.dim; }
        at := TouchArea { mouse-cursor: pointer; clicked => { root.add(); } }
        fs := FocusScope { width: 0px; height: 0px; focus-on-click: false;
            key-pressed(e) => { if e.text == " " || e.text == Key.Return { root.add(); return accept; } return reject; } }
        if fs.has-focus: Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; border-width: 2px; border-color: Theme.ice; }
    }
}

// Index entry on the left: jumps to a section.
component Jump inherits Rectangle {
    in property <string> idx;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 38px;
    border-radius: Theme.r1;
    background: root.active ? Theme.red.with-alpha(0.16) : (ta.has-hover ? Theme.hov : transparent);
    animate background { duration: Theme.fast; }
    Rectangle { x: 0px; y: 8px; width: 3px; height: parent.height - 16px; border-radius: 2px; background: Theme.red2; opacity: root.active ? 1 : 0; animate opacity { duration: Theme.mid; } }
    Text { x: 16px; text: root.label; color: root.active ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { width: 0px; height: 0px; focus-on-click: false;
        key-pressed(e) => { if e.text == " " || e.text == Key.Return { root.clicked(); return accept; } return reject; } }
    if fs.has-focus: Rectangle { border-radius: Theme.r1; border-width: 2px; border-color: Theme.ice; }
}

// A saved Microsoft account: head, name, what it is used for; switch / remove on the right.
component AcctRow inherits SetRow {
    in property <Acct> acct;
    reserve: 240px;
    indent: 52px;
    title: root.acct.name;
    sub: root.acct.active ? (Backend.acct-offline ? "Plays now · offline until the connection is back" : "Plays now · your skin and capes come from here") : "Saved on this PC · switch any time";
    // indent the text past the head
    Rectangle { x: 0px; y: 14px; width: 36px; height: 36px; background: Theme.s2; clip: true;
        if root.acct.active && Backend.skin-ready: Image { width: 36px; height: 36px; source: Backend.acct-head; image-rendering: pixelated; }
        if !(root.acct.active && Backend.skin-ready): Icon { x: 12px; y: 12px; d: Ico.user; tint: Theme.mut; } }
    if root.acct.active: Chip { x: parent.width - 52px - self.width - 12px; y: 21px; text: "ACTIVE"; hot: true; }
    if !root.acct.active: Btn { x: parent.width - 52px - self.width - 10px; y: 14px; text: "USE"; clicked => { Backend.switch-account(root.acct.uuid); } }
    IconBtn { x: parent.width - 36px; y: 16px; d: Ico.trash; danger: true; tip: root.acct.active ? "Sign out" : "Remove account";
        clicked => { if root.acct.active { Backend.sign-out(); } else { Backend.remove-account(root.acct.uuid); } } }
}


// Theme picker tile: a tiny window drawn in that theme's own colours and shape, name below
component ThemeTile inherits Rectangle {
    in property <ThemeSpec> spec;
    in property <bool> on;
    callback pick();
    width: 120px; height: 82px;
    Rectangle {
        width: 120px; height: 56px; y: 0px; background: root.spec.bg; border-radius: root.spec.r; clip: true;
        border-width: root.on ? 2px : 1px; border-color: root.on ? Theme.red : ta.has-hover ? Theme.ln2 : Theme.ln;
        animate border-color { duration: Theme.fast; }
        // side rail, two panels, accent action
        Rectangle { x: 8px; y: 8px; width: 22px; height: 40px; background: root.spec.panel; border-radius: root.spec.r / 2.5; }
        Rectangle { x: 36px; y: 8px; width: 76px; height: 18px; background: root.spec.panel; border-radius: root.spec.r / 2.5; border-width: 1px; border-color: root.spec.line; }
        Rectangle { x: 36px; y: 30px; width: 46px; height: 18px; background: root.spec.panel; border-radius: root.spec.r / 2.5; border-width: 1px; border-color: root.spec.line; }
        Rectangle { x: 86px; y: 30px; width: 26px; height: 18px; background: Theme.red; border-radius: root.spec.r / 2.5; }
        Rectangle { x: 12px; y: 13px; width: 14px; height: 3px; background: root.spec.text.with-alpha(0.7); }
        Rectangle { x: 41px; y: 15px; width: 40px; height: 3px; background: root.spec.text.with-alpha(0.6); }
    }
    Text { x: 0px; y: 62px; width: 120px; text: root.spec.name + " " + root.spec.sub; color: root.on || ta.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 12px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(); } }
}

export component SettingsScreen inherits Rectangle {
    property <length> cw: 760px;
    // section tops (each follows the one before it)
    property <int> nacc: Math.max(1, Backend.accounts.length);
    property <length> y2: 540px;
    property <length> y3: root.y2 + 40px + root.nacc * 64px + 68px;
    property <length> y4: root.y3 + 40px + Backend.javas.length * 64px + 40px;
    property <length> y5: root.y4 + 40px + 7 * 64px + 40px;
    property <length> py: root.y5 + 216px + 60px + root.trows * 90px + 8px;
    property <length> y6: root.py + 206px + ic.height + wp.height;
    property <length> sy: root.y6 + 24px + Backend.folders.length * 64px;
    // L2: privacy (what the launcher and client connect to)
    property <length> y7: root.sy + 5 * 64px + 40px;
    property <length> dy: Backend.discord-ready ? 64px : 0px;
    property <length> pos: -fl.content-y;
    property <length> end: fl.content-height - fl.height - 2px;
    property <[length]> tops: [0px, root.y2, root.y3, root.y4, root.y5, root.y6, root.y7];
    property <int> at: root.pos >= Math.min(root.y7 - 120px, root.end) ? 6 : (root.pos >= root.y6 - 120px ? 5 : (root.pos >= root.y5 - 120px ? 4 : (root.pos >= root.y4 - 120px ? 3 : (root.pos >= root.y3 - 120px ? 2 : (root.pos >= root.y2 - 120px ? 1 : 0)))));
    // theme tiles: 128 px apart, as many per row as fit
    property <int> tcols: Math.max(1, Math.floor((root.cw + 8px) / 128px));
    property <int> trows: Math.max(1, Math.ceil(Backend.themes.length / root.tcols));
    property <[string]> accent-names: ["Fire", "Racing red", "Acid", "Cobalt", "Violet"];
    property <[color]> accents: [#F76A05, #E5372D, #22A845, #1F6FEB, #8B3DFF];
    // L2: what connects where (Rule 6); k = what for, url = hosts and when
    property <[Link]> hosts: [
        {k: "Sign-in", url: "login.microsoftonline.com, xboxlive.com, api.minecraftservices.com · your token goes only to Microsoft and Mojang"},
        {k: "Game files", url: "piston-meta.mojang.com, launchermeta.mojang.com, libraries.minecraft.net, resources.download.minecraft.net"},
        {k: "Mod loaders", url: "meta.fabricmc.net, meta.quiltmc.org, meta.legacyfabric.net, maven.minecraftforge.net, maven.neoforged.net"},
        {k: "Mods and modpacks", url: "api.modrinth.com, cdn.modrinth.com · searches and downloads you start"},
        {k: "Skins and capes", url: "sessionserver.mojang.com, api.mojang.com, textures.minecraft.net"},
        {k: "Nether content and capes", url: "the Nether service (signed packs and cape list; your cape, and lookups in game)"},
        {k: "Launcher updates", url: "api.github.com, github.com · checking for and downloading signed updates"},
        {k: "Invite to world", url: "iroh.link (peer-to-peer link + relay fallback), api.ipify.org, api.mcstatus.io, api.mojang.com · only while you share or join a world"},
        {k: "Friends, world invites", url: "the Nether friends service (Cloudflare) · while signed in: your friends, requests, blocks and status"},
        {k: "Parties, chat and voice", url: "your party members directly (peer-to-peer), iroh.link relays as fallback · only in a party; never stored or recorded"},
        {k: "Sharing logs", url: "api.mclo.gs · only when you confirm Share or press Upload (a public link)"},
        {k: "In game", url: "sessionserver.mojang.com for your head, and your saved servers for their status (title screen) · media helper: local only"},
        {k: "Lyrics (off by default)", url: "lrclib.net (title, artist, album, length); api.lyrics.ovh if not found (title, artist); music.163.com for word timing (title, artist)"},
    ];

    Heading { x: 56px; y: 28px; text: "SETTINGS"; font-size: 32px; }

    // section index
    // L2: the command palette opens a section (Backend.settings-goto)
    property <int> goto: Backend.settings-goto;
    function jump() { if Backend.settings-goto >= 0 { fl.content-y = -Math.max(0px, Math.min(root.tops[Backend.settings-goto], fl.content-height - fl.height)); Backend.settings-goto = -1; } }
    init => { root.jump(); }
    changed goto => { root.jump(); }

    for s[i] in ["Game", "Accounts", "Java", "Launcher", "Personalization", "Storage & about", "Privacy"]: Jump {
        x: 48px; y: 100px + i * 40px; width: 220px; idx: "0\{i + 1}"; label: s; active: root.at == i;
        clicked => { fl.content-y = -Math.max(0px, Math.min(root.tops[i], fl.content-height - fl.height)); }
    }

    fl := Flickable {
        x: 306px; y: 112px; width: root.cw + 20px; height: parent.height - 112px;
        content-height: root.y7 + 24px + 64px + root.dy + root.hosts.length * 64px + 60px;

        // ---------- 01 shared game settings ----------
        SectionHead { x: 0px; y: 12px; width: root.cw; idx: "01"; title: "SHARED GAME SETTINGS"; }
        SyncRow { x: 0px; y: 36px; width: root.cw; title: "Share settings between instances"; sub: "Set a keybind or your FOV once and it follows you into every instance."; on <=> Backend.sync-on; toggled(v) => { Backend.save-sync(); } }
        Rectangle { x: 0px; y: 100px; width: root.cw; height: 320px;
            Rectangle { x: 6px; y: 12px; width: 1px; height: parent.height - 24px; background: Theme.ln2; }
            SyncRow { x: 28px; y: 0px; width: parent.width - 28px; title: "Controls & keybinds"; sub: "Every keybind (mod keys included), mouse sensitivity, toggle sprint / crouch"; enabled: Backend.sync-on; on <=> Backend.sync-controls; toggled => { Backend.save-sync(); } }
            SyncRow { x: 28px; y: 64px; width: parent.width - 28px; title: "Video"; sub: "FOV, brightness, GUI scale, render distance, max FPS, VSync, fullscreen"; enabled: Backend.sync-on; on <=> Backend.sync-video; toggled => { Backend.save-sync(); } }
            SyncRow { x: 28px; y: 128px; width: parent.width - 28px; title: "Audio"; sub: "Master, music and every sound category, output device, subtitles"; enabled: Backend.sync-on; on <=> Backend.sync-audio; toggled => { Backend.save-sync(); } }
            SyncRow { x: 28px; y: 192px; width: parent.width - 28px; title: "Chat, language & accessibility"; sub: "Chat scale and opacity, language, narrator, other options"; enabled: Backend.sync-on; on <=> Backend.sync-other; toggled => { Backend.save-sync(); } }
            SyncRow { x: 28px; y: 256px; width: parent.width - 28px; title: "Mod video settings"; sub: "Sodium, Embeddium and OptiFine options; the copy changed last wins"; enabled: Backend.sync-on; on <=> Backend.sync-mods; toggled => { Backend.save-sync(); } }
        }
        imp := Btn { x: 0px; y: 440px; text: "IMPORT FROM MINECRAFT LAUNCHER"; icon: Ico.download; clicked => { Backend.import-settings(); } }
        Btn { x: imp.width + 10px; y: 440px; text: "OPEN SETTINGS FILE"; icon: Ico.ext; clicked => { Backend.open-settings-file(); } }

        // ---------- 02 accounts ----------
        SectionHead { x: 0px; y: root.y2; width: root.cw; idx: "02"; title: "ACCOUNTS"; note: Backend.accounts.length == 1 ? "1 account" : "\{Backend.accounts.length} accounts"; }
        for a[i] in Backend.accounts: AcctRow { x: 0px; y: root.y2 + 24px + i * 64px; width: root.cw; acct: a; }
        if Backend.accounts.length == 0: SetRow { x: 0px; y: root.y2 + 24px; width: root.cw; reserve: 260px;
            title: "No account yet"; sub: "Sign in with Microsoft to play, join servers and wear your skin.";
            Btn { x: parent.width - self.width; y: 14px; text: "SIGN IN WITH MICROSOFT"; solid: true; clicked => { Backend.acct-open = true; Backend.sign-in(); } } }
        if Backend.accounts.length > 0: Btn { x: 0px; y: root.y2 + 24px + root.nacc * 64px + 16px; text: "ADD ACCOUNT"; icon: Ico.plus; clicked => { Backend.acct-open = true; Backend.sign-in(); } }

        // ---------- 03 java ----------
        SectionHead { x: 0px; y: root.y3; width: root.cw; idx: "03"; title: "JAVA"; note: "picked per instance on its Overview"; }
        for j[i] in Backend.javas: SetRow {
            x: 0px; y: root.y3 + 24px + i * 64px; width: root.cw; reserve: j.custom ? 360px : 170px;
            title: j.title; sub: j.sub;
            ch := Btn { x: parent.width - self.width; y: 14px; text: "CHOOSE"; icon: Ico.folder; clicked => { Backend.java-pick(j.major); } }
            if j.custom: Rectangle {
                rs := Btn { x: ch.x - 10px - self.width; y: 14px; text: "RESET"; clicked => { Backend.java-reset(j.major); } }
                Chip { x: rs.x - self.width - 12px; y: 21px; text: "CUSTOM"; }
            }
        }

        // ---------- 04 launcher ----------
        SectionHead { x: 0px; y: root.y4; width: root.cw; idx: "04"; title: "LAUNCHER"; }
        SyncRow { x: 0px; y: root.y4 + 24px; width: root.cw; title: "Hardware acceleration"; sub: "Draw the launcher on the GPU. Turn off if it flickers or crashes (applies after a restart)."; on <=> Backend.lp-gpu; toggled => { Backend.save-launcher(); } }
        SyncRow { x: 0px; y: root.y4 + 88px; width: root.cw; title: "Start with Windows"; sub: "Open Nether Client when you sign in to Windows."; on <=> Backend.lp-autostart; toggled => { Backend.save-launcher(); } }
        ChoiceRow { x: 0px; y: root.y4 + 152px; width: root.cw; title: "When a game starts"; sub: "The launcher comes back when the game closes."; items: ["Keep launcher open", "Minimize launcher", "Hide to tray"]; current <=> Backend.lp-on-launch; changed => { Backend.save-launcher(); } }
        ChoiceRow { x: 0px; y: root.y4 + 216px; width: root.cw; title: "Close button"; sub: "Quit, or keep running in the system tray."; items: ["Quit the launcher", "Hide to tray"]; current <=> Backend.lp-on-close; changed => { Backend.save-launcher(); } }
        SyncRow { x: 0px; y: root.y4 + 280px; width: root.cw; title: "Reduce motion"; sub: "Turn off page transitions and pulsing indicators; saves power on laptops."; on <=> Backend.calm; toggled => { Backend.save-launcher(); } }
        SetRow { x: 0px; y: root.y4 + 344px; width: root.cw; reserve: 340px; title: "Interface sounds"; sub: "Soft clicks in the launcher and the in-game menus, a chime on PLAY.";
            Seg { x: parent.width - self.width; y: 15px; items: ["Off", "Quiet", "Normal"]; current: Backend.lp-sounds;
                changed(i) => { Backend.lp-sounds = i; Backend.save-launcher(); Sound.play(0); } }
        }
        SetRow { x: 0px; y: root.y4 + 408px; width: root.cw; reserve: 0px; title: "Keyboard shortcuts"; sub: "Ctrl+K search everything  ·  Ctrl+1-4 pages  ·  Ctrl+, settings  ·  Ctrl+N new instance  ·  Esc closes"; }

        // ---------- 05 personalization ----------
        SectionHead { x: 0px; y: root.y5; width: root.cw; idx: "05"; title: "PERSONALIZATION"; }
        SetRow { x: 0px; y: root.y5 + 24px; width: root.cw; reserve: 330px; title: "Accent colour"; sub: (Backend.lp-accent == 5 ? "Custom " + Backend.lp-accent-hex : root.accent-names[Backend.lp-accent]) + " · PLAY, buttons, selection marks and live states";
            for c[i] in root.accents: Rectangle {
                x: parent.width - 6 * 36px - 96px + 6px + i * 36px; y: 18px; width: 28px; height: 28px; background: c;
                border-width: Backend.lp-accent == i ? 2px : 0px; border-color: Theme.ice; border-radius: Theme.r2;
                Rectangle { x: 2px; y: 2px; width: 24px; height: 24px; border-radius: Theme.r1; background: transparent; border-width: Backend.lp-accent == i ? 2px : 0px; border-color: Theme.bg; }
                sw := TouchArea { mouse-cursor: pointer; clicked => { Backend.lp-accent = i; Backend.save-launcher(); } }
                sf := FocusScope { width: 0px; height: 0px; focus-on-click: false;
                    key-pressed(e) => { if e.text == " " || e.text == Key.Return { Backend.lp-accent = i; Backend.save-launcher(); return accept; } return reject; } }
                if sf.has-focus || (sw.has-hover && Backend.lp-accent != i): Rectangle { x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px; border-radius: Theme.r3; border-width: 1px; border-color: sf.has-focus ? Theme.ice : Theme.ln2; }
            }
            // the custom colour: its swatch, and a hex field (Enter applies)
            Rectangle {
                x: parent.width - 36px - 96px + 6px; y: 18px; width: 28px; height: 28px; background: Backend.lp-accent == 5 ? Backend.accent-custom : Theme.s2;
                border-width: Backend.lp-accent == 5 ? 2px : 1px; border-color: Backend.lp-accent == 5 ? Theme.ice : Theme.ln2; border-radius: Theme.r2;
                if Backend.lp-accent != 5: Text { text: "+"; color: Theme.dim; font-family: Theme.ui; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => { if Backend.lp-accent-hex != "" { Backend.lp-accent = 5; Backend.save-launcher(); } else { hexf.focus-input(); } } }
            }
            hexf := Field { x: parent.width - 88px; y: 14px; width: 88px; height: 36px; text-size: 13px; placeholder: "#RRGGBB"; text: Backend.lp-accent-hex;
                accepted => { Backend.lp-accent-hex = self.text; Backend.lp-accent = 5; Backend.save-launcher(); } }
        }
        SetRow { x: 0px; y: root.y5 + 88px; width: root.cw; reserve: 340px; title: "Text size"; sub: "Bigger reading text. Titles keep their size.";
            Seg { x: parent.width - self.width; y: 15px; items: ["Default", "Large", "Larger"]; current: Backend.lp-text; changed(i) => { Backend.lp-text = i; Backend.save-launcher(); } }
        }
        SetRow { x: 0px; y: root.y5 + 152px; width: root.cw; reserve: 340px; title: "Corners"; sub: "How round panels, cards and buttons are, here and in game.";
            Seg { x: parent.width - self.width; y: 15px; items: ["Sharp", "Default", "Round"]; current: Backend.lp-corners; changed(i) => { Backend.lp-corners = i; Backend.save-launcher(); } }
        }
        SetRow { x: 0px; y: root.y5 + 216px; width: root.cw; height: 60px + root.trows * 90px; reserve: 150px; title: "Theme"; sub: "The launcher, the in-game menus and the title screen follow it. Add your own as a JSON file.";
            LinkBtn { x: parent.width - self.width; y: 16px; text: "THEMES FOLDER"; clicked => { Backend.open-themes(); } }
            for t[i] in Backend.themes: ThemeTile { x: Math.mod(i, root.tcols) * 128px; y: 60px + Math.floor(i / root.tcols) * 90px; spec: t; on: Backend.lp-theme == i;
                pick => { Backend.lp-theme = i; Backend.save-launcher(); } }
        }
        Text { x: 0px; y: root.py + 24px; text: "Your instance icons"; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; }
        Text { x: 0px; y: root.py + 46px; width: root.cw; text: "PNG, JPG or WebP. Pixel art stays crisp; large images are scaled to 64px."; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; }
        ic := Uploads { x: 0px; y: root.py + 76px; width: root.cw; tile: 56px; pixel: true; items: Backend.custom-icons; add => { Backend.upload-art(0); } remove(k) => { Backend.remove-art(0, k); } }
        Text { x: 0px; y: ic.y + ic.height + 24px; text: "Your wallpapers"; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; }
        Text { x: 0px; y: ic.y + ic.height + 46px; width: root.cw; text: "Screenshots or any image. They appear next to the version wallpapers when you make or edit an instance."; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; }
        wp := Uploads { x: 0px; y: ic.y + ic.height + 76px; width: root.cw; tile: 100px; pixel: false; items: Backend.custom-covers; add => { Backend.upload-art(1); } remove(k) => { Backend.remove-art(1, k); } }

        // ---------- 06 storage & about ----------
        SectionHead { x: 0px; y: root.y6; width: root.cw; idx: "06"; title: "STORAGE & ABOUT"; }
        for f[i] in Backend.folders: SetRow { x: 0px; y: root.y6 + 24px + i * 64px; width: root.cw; reserve: 140px; title: f.k; sub: f.url;
            Btn { x: parent.width - self.width; y: 14px; text: "OPEN"; icon: Ico.folder; clicked => { Backend.open-path(f.url); } } }
        SetRow { x: 0px; y: root.sy; width: root.cw; reserve: 140px; title: "Download cache"; sub: Backend.cache-size + " of saved icons and lookups. Safe to clear; it refills as you browse.";
            Btn { x: parent.width - self.width; y: 14px; text: "CLEAR"; clicked => { Backend.clear-cache(); } } }
        SetRow { x: 0px; y: root.sy + 64px; width: root.cw; reserve: 260px; title: "Updates";
            sub: Backend.update-state == 0 ? "Checking for a newer version…" : (Backend.update-state == 2 ? "Nether Client " + Backend.update-ver + " is out. Get it from the release page." : (Backend.update-state == 3 ? "Couldn't reach GitHub to check. Try again later." : (Backend.update-state == 4 ? "Nether Client " + Backend.update-ver + " is downloaded. Restart to install it." : (Backend.update-state == 5 ? "Downloading Nether Client " + Backend.update-ver + "…" : "You're on the newest version."))));
            if Backend.update-state == 2: Btn { x: parent.width - self.width; y: 14px; text: "GET " + Backend.update-ver; solid: true; icon: Ico.download; clicked => { Backend.open-url(Backend.update-url); } }
            if Backend.update-state == 4: Btn { x: parent.width - self.width; y: 14px; text: "RESTART NOW"; solid: true; icon: Ico.download; clicked => { Backend.update-restart(); } }
            if Backend.update-state != 2 && Backend.update-state != 4: Btn { x: parent.width - self.width; y: 14px; text: "CHECK NOW"; enabled: Backend.update-state != 0 && Backend.update-state != 5; clicked => { Backend.check-updates(); } } }
        SyncRow { x: 0px; y: root.sy + 128px; width: root.cw; title: "Beta updates";
            sub: "Get new versions early, before they're fully tested. Off: full releases only (a beta you have stays until the next release)."; on <=> Backend.lp-beta; toggled => { Backend.save-launcher(); } }
        SetRow { x: 0px; y: root.sy + 192px; width: root.cw; reserve: 420px; title: "Support"; sub: "The launcher's own log, and a summary of this PC for a bug report.";
            Btn { x: csi.x - 10px - self.width; y: 14px; text: "LOGS"; icon: Ico.folder; clicked => { Backend.open-logs(); } }
            csi := Btn { x: parent.width - self.width; y: 14px; text: "COPY SYSTEM INFO"; icon: Ico.copy; clicked => { Backend.copy-sysinfo(); } } }
        SetRow { x: 0px; y: root.sy + 256px; width: root.cw; reserve: 0px; title: "Nether Client " + Backend.app-version; sub: "Beta. No telemetry, no ads. Sign-in tokens stay in Windows Credential Manager."; }

        // ---------- 07 privacy (L2): every service the launcher and client talk to, and when ----------
        SectionHead { x: 0px; y: root.y7; width: root.cw; idx: "07"; title: "PRIVACY"; note: "no telemetry, no analytics"; }
        SyncRow { x: 0px; y: root.y7 + 24px; width: root.cw; title: "Capes and cosmetics in game";
            sub: "Shows other Nether players' capes and cosmetics. Lookups use a short hash, never names or UUIDs. Off deletes your entry at the service."; on <=> Backend.lp-capes; toggled => { Backend.save-launcher(); } }
        if Backend.discord-ready: SyncRow { x: 0px; y: root.y7 + 88px; width: root.cw; title: "Discord status";
            sub: "Shows your name, Minecraft version, Singleplayer or Multiplayer, and play time on Discord. Only the Discord app on this PC is told; never your server address or world."; on <=> Backend.lp-discord; toggled => { Backend.save-launcher(); } }
        for h[i] in root.hosts: SetRow { x: 0px; y: root.y7 + 88px + root.dy + i * 64px; width: root.cw; reserve: 0px; title: h.k; sub: h.url; }
    }

    // side notes for the section in view (the column used to sit empty past the Game section)
    property <[string]> note-heads: ["HOW SHARING WORKS", "ABOUT ACCOUNTS", "ABOUT JAVA", "GOOD TO KNOW", "MAKE IT YOURS", "STORAGE & UPDATES", "WHAT WE COLLECT"];
    property <[{s: int, n: int, h: string, b: string}]> notes: [
        {s: 0, n: 0, h: "Every loader", b: "Settings are merged into each instance's own options.txt before launch, so Vanilla, Fabric, Quilt, Forge and NeoForge all read them the normal way."},
        {s: 0, n: 1, h: "Different mods per instance", b: "Mod keybinds are kept even in instances without that mod, and come back in any instance that has it."},
        {s: 0, n: 2, h: "Old and new versions", b: "1.8.9-1.12 key codes are translated to and from modern key names, so binds carry between eras."},
        {s: 0, n: 3, h: "Changes made in game", b: "When the game closes, what you changed is saved back. Instances can opt out on their Overview page."},
        {s: 1, n: 0, h: "Switch in one click", b: "Every saved account sits in the chip at the top right. Pick one there before you press Play."},
        {s: 1, n: 1, h: "Your sign-in stays here", b: "Tokens are kept in Windows Credential Manager and only ever sent to Microsoft and Mojang."},
        {s: 1, n: 2, h: "No connection?", b: "You can still play singleplayer with the last account that signed in."},
        {s: 2, n: 0, h: "Nothing to install", b: "Nether downloads the right Java for each Minecraft version the first time you play it."},
        {s: 2, n: 1, h: "Bring your own", b: "Choose a folder to use your own Java for that version. Reset goes back to ours."},
        {s: 2, n: 2, h: "Per instance", b: "An instance can pin a Java on its Overview page, next to memory and JVM flags."},
        {s: 3, n: 0, h: "Find anything", b: "Ctrl+K searches instances, worlds, mods, settings and actions from any page."},
        {s: 3, n: 1, h: "Out of the way", b: "Hide to tray keeps Nether ready without a window. The tray icon brings it back."},
        {s: 4, n: 0, h: "In game too", b: "Theme and accent follow you into the Right Shift menu and HUD editor."},
        {s: 4, n: 1, h: "Your pictures", b: "Uploaded icons and wallpapers show up when you make or edit an instance. Home uses the wallpaper full screen."},
        {s: 5, n: 0, h: "Safe to clear", b: "The download cache only holds icons and lookups. It refills as you browse."},
        {s: 5, n: 1, h: "Signed updates", b: "Every update is checked against our signing key before it installs."},
        {s: 6, n: 0, h: "No telemetry", b: "No analytics, no ads, no tracking. The list on the left is every service Nether talks to."},
        {s: 6, n: 1, h: "Only when you use it", b: "World sharing, log sharing and lyrics connect only while you use them."},
        {s: 6, n: 2, h: "Parties stay between you", b: "Party chat and voice go straight to your party and are never saved. Hide my IP sends them through a relay."},
    ];
    Rectangle {
        x: 1124px; y: 0px; width: 316px; height: parent.height; background: Theme.s1;
        Rectangle { x: 0px; width: 1px; background: Theme.ln; }
        Eyebrow { x: 28px; y: 124px; text: root.note-heads[root.at]; }
        for t[i] in root.notes: Rectangle {
            visible: t.s == root.at;
            x: 28px; y: 156px + t.n * 124px * Theme.ts; height: 124px * Theme.ts; width: parent.width - 56px;
            Text { x: 0px; y: 0px; text: "0\{t.n + 1}"; color: Theme.red2; font-family: Theme.mono; font-size: 11px * Theme.ts; font-weight: 700; }
            Text { x: 0px; y: 18px; width: parent.width; text: t.h; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; }
            Text { x: 0px; y: 40px; width: parent.width; text: t.b; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
        }
    }
}
