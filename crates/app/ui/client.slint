import { Theme } from "theme.slint";
import { Backend, ClientState, ClientMod, SetVal } from "structs.slint";
import { Eyebrow, Heading, Seg, Toggle, Btn, Chip, SectionHead, Slider, Ticks, Hatch, Dropdown, Field } from "components.slint";

// Box shown in the HUD editor for each enabled HUD module (sample in-game look).
component HudWidget inherits Rectangle {
    in property <ClientMod> m;
    in property <float> k: 1;
    property <length> u: 1px * root.k * root.m.scale;
    property <string> line: root.m.id == "fps" ? "144 FPS" : (root.m.id == "cps" ? "CPS 11 | 9" : (root.m.id == "coords" ? "XYZ 120 / 64 / -340  N"
        : (root.m.id == "ping" ? "24 MS" : (root.m.id == "clock" ? "12:45" : (root.m.id == "memory" ? "MEM 1.2 / 4.0 GB" : (root.m.id == "server" ? "play.server.net"
        : (root.m.id == "worldtime" ? "DAY 12  ·  14:20" : (root.m.id == "speed" ? "4.3 m/s" : (root.m.id == "compass" ? "N   ·   NE   ·   E" : (root.m.id == "sprint" ? "SPRINT" : (root.m.id == "sneak" ? "SNEAK" : "")))))))))));
    property <bool> tiles: root.m.id == "armor" && root.m.variant == "Icons";
    width: root.m.id == "keys" ? 82 * root.u : (root.m.id == "armor" ? (root.tiles ? 140 * root.u : 92 * root.u) : (root.m.id == "potions" ? 118 * root.u : t.preferred-width + 16 * root.u));
    height: root.m.id == "keys" ? 82 * root.u : (root.m.id == "armor" ? (root.tiles ? 44 * root.u : 74 * root.u) : (root.m.id == "potions" ? 42 * root.u : 20 * root.u));
    if root.line != "": Rectangle { background: #00000088; }
    t := Text { text: root.line; color: white; font-family: Theme.mono; font-size: 10 * root.u; horizontal-alignment: center; vertical-alignment: center; }
    if root.m.id == "keys": Rectangle {
        for k[i] in [{t: "W", x: 1, y: 0, w: 1}, {t: "A", x: 0, y: 1, w: 1}, {t: "S", x: 1, y: 1, w: 1}, {t: "D", x: 2, y: 1, w: 1}, {t: "LMB", x: 0, y: 2, w: 1.5}, {t: "RMB", x: 1.5, y: 2, w: 1.5}]: Rectangle {
            x: k.x * 27 * root.u; y: k.y * 27 * root.u; width: k.w * 27 * root.u - 2 * root.u; height: 25 * root.u;
            background: i == 0 ? #ffffffcc : #00000088;
            Text { text: k.t; color: i == 0 ? black : white; font-family: Theme.mono; font-size: 9 * root.u; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    // armor: list / compact rows, or icon tiles with a durability bar
    if root.m.id == "armor" && !root.tiles: Rectangle {
        for a[i] in [{n: "HELMET", f: 0.8}, {n: "CHEST", f: 0.62}, {n: "LEGS", f: 0.3}, {n: "BOOTS", f: 0.08}]: Rectangle {
            y: i * 18.5 * root.u; height: 17 * root.u; background: #00000088;
            Text { x: 6 * root.u; text: root.m.variant == "Compact" ? "■" : a.n; color: white; font-family: Theme.mono; font-size: 8 * root.u; vertical-alignment: center; }
            Rectangle { x: parent.width - 34 * root.u; y: parent.height / 2 - 1.5 * root.u; width: 28 * root.u; height: 3 * root.u; background: #ffffff22;
                Rectangle { x: 0; width: parent.width * a.f; background: a.f > 0.3 ? #EAEEF3 : (a.f > 0.15 ? #FFB020 : #FF3B2F); } }
        }
    }
    if root.tiles: Rectangle {
        background: #00000088;
        for f[i] in [0.8, 0.62, 0.3, 0.08]: Rectangle {
            x: (5 + i * 33) * root.u; y: 5 * root.u; width: 30 * root.u; height: 30 * root.u; background: #ffffff10;
            Rectangle { x: 8 * root.u; y: 5 * root.u; width: 14 * root.u; height: 14 * root.u; background: #4FE3D0; }
            Rectangle { x: 4 * root.u; y: 24 * root.u; width: 22 * root.u; height: 3 * root.u; background: #000000aa;
                Rectangle { x: 0; width: parent.width * f; background: f > 0.3 ? #3DDC84 : (f > 0.15 ? #FFB020 : #FF3B2F); } }
        }
    }
    if root.m.id == "potions": Rectangle {
        background: #00000088;
        Text { x: 8 * root.u; y: 5 * root.u; text: "Speed II"; color: #9ad7ff; font-family: Theme.mono; font-size: 9 * root.u; }
        Text { x: 8 * root.u; y: 22 * root.u; text: "1:30"; color: #d0d0d0; font-family: Theme.mono; font-size: 8 * root.u; }
    }
}

// one row of the settings panel, drawn for its type
component SettingRow inherits Rectangle {
    in property <SetVal> s;
    in property <int> mi;
    in property <bool> locked;
    property <int> n: Math.max(1, Math.round((root.s.max - root.s.min) / Math.max(0.0001, root.s.step)));
    property <[{c: color, h: string}]> palette: [{c: #EAEEF3, h: "#EAEEF3"}, {c: #E10600, h: "#E10600"}, {c: #FF3B2F, h: "#FF3B2F"}, {c: #FFFFFF, h: "#FFFFFF"},
        {c: #8A93A1, h: "#8A93A1"}, {c: #3DDC84, h: "#3DDC84"}, {c: #4DA3FF, h: "#4DA3FF"}, {c: #FFB020, h: "#FFB020"}, {c: #A855F7, h: "#A855F7"}];
    property <bool> in-palette: root.s.str == "#EAEEF3" || root.s.str == "#E10600" || root.s.str == "#FF3B2F" || root.s.str == "#FFFFFF" || root.s.str == "#8A93A1" || root.s.str == "#3DDC84" || root.s.str == "#4DA3FF" || root.s.str == "#FFB020" || root.s.str == "#A855F7";
    height: 50px;
    if root.s.t != 6: Text { x: 0px; y: 0px; width: 220px; height: root.s.hint == "" ? root.height : 31px; text: root.s.label; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; vertical-alignment: center; overflow: elide; }
    if root.s.t != 6 && root.s.hint != "": Text { x: 0px; y: 29px; width: 330px; height: 16px; text: root.s.hint; color: Theme.mut; font-family: Theme.ui; font-size: 11px * Theme.ts; overflow: elide; }
    if root.s.t == 6: Text { x: 0px; y: 16px; width: parent.width; height: 28px; text: root.s.label.to-uppercase(); color: Theme.dim; font-family: Theme.disp; font-size: 15px * Theme.ts; font-weight: 700; letter-spacing: 1.4px; vertical-alignment: center; }
    if root.s.t == 5: Field { x: parent.width - 240px; y: 5px; width: 240px; height: 40px; text-size: 13px; text: root.s.str; edited => { ClientState.set-str(root.mi, root.s.key, self.text); } }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; visible: root.s.t != 6; }
    if root.s.t == 0: Toggle { x: parent.width - 42px; y: 14px; on: root.s.on; enabled: !root.locked; toggled(v) => { ClientState.set-bool(root.mi, root.s.key, v); } }
    if root.s.t == 1: Rectangle {
        x: parent.width - 330px; width: 330px;
        Slider { x: 0px; y: 10px; width: 260px; min: 0; max: root.n; major: Math.max(1, Math.round(root.n / 4)); enabled: !root.locked;
            value: Math.round((root.s.num - root.s.min) / Math.max(0.0001, root.s.step)); controlled: true;
            moved(v) => { ClientState.set-num(root.mi, root.s.key, root.s.min + v * root.s.step); } }
        Text { x: 270px; width: 60px; height: parent.height; horizontal-alignment: right; vertical-alignment: center; color: Theme.tx; font-family: Theme.mono; font-size: 12px * Theme.ts;
            text: root.s.key == "scale" || root.s.key == "bgAlpha" ? "\{Math.round(root.s.num * 100)}%" : (root.s.step >= 1 ? "\{Math.round(root.s.num)}" : "\{Math.round(root.s.num * 100) / 100}"); }
    }
    // a value outside the palette (#RRGGBBAA from the in-game picker, chroma): shown as the selected swatch
    if root.s.t == 2 && root.s.str != "" && !root.in-palette: Rectangle {
        x: parent.width - 294px; y: 13px; width: 24px; height: 24px; border-width: 2px; border-color: Theme.red2;
        background: root.s.rainbow ? @linear-gradient(90deg, #FF3B2F, #FFB020, #3DDC84, #4DA3FF, #A855F7) : root.s.col;
    }
    if root.s.t == 2: HorizontalLayout {
        x: parent.width - self.preferred-width; y: 13px; height: 24px; spacing: 6px; alignment: end;
        for p in root.palette: Rectangle {
            width: 24px; height: 24px; background: p.c;
            border-width: root.s.str == p.h ? 2px : 1px; border-color: root.s.str == p.h ? Theme.red2 : #ffffff22;
            if root.s.str == p.h: Rectangle { x: 7px; y: 7px; width: 10px; height: 10px; background: p.c == #FFFFFF || p.c == #EAEEF3 ? Theme.ink : white; }
            TouchArea { mouse-cursor: pointer; clicked => { if !root.locked { ClientState.set-str(root.mi, root.s.key, p.h); } } }
        }
    }
    if root.s.t == 3 && root.s.opts.length <= 3: Seg {
        x: parent.width - self.width; y: 8px; items: root.s.opts; item-w: 104px; current: root.s.pick;
        changed(i) => { if !root.locked { ClientState.set-str(root.mi, root.s.key, root.s.opts[i]); } }
    }
    if root.s.t == 3 && root.s.opts.length > 3: Dropdown {
        x: parent.width - self.width; y: 5px; width: 240px; items: root.s.opts; current: root.s.pick;
        changed(i) => { if !root.locked { ClientState.set-str(root.mi, root.s.key, root.s.opts[i]); } }
    }
    if root.s.t == 4: Rectangle {
        x: parent.width - 330px; width: 330px;
        Text { x: 0px; width: 210px; height: parent.height; text: root.s.unset ? "Not bound · set it in Minecraft's Key Binds" : "Rebind in Minecraft's Key Binds"; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; vertical-alignment: center; horizontal-alignment: right; }
        Rectangle { x: parent.width - kt.preferred-width - 24px; y: 12px; width: kt.preferred-width + 24px; height: 26px; background: root.s.unset ? Theme.s3 : Theme.ice;
            kt := Text { text: root.s.unset ? "UNBOUND" : root.s.str; color: root.s.unset ? Theme.dim : Theme.ink; font-family: Theme.mono; font-size: 11px * Theme.ts; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
    }
}

// Module list + per-module settings + HUD position editor. `scope` -1 = global setup, else an instance index.
export component ClientEditor inherits Rectangle {
    in property <int> scope: -1;
    init => { ClientState.load(root.scope); }
    property <int> cat: 0;
    property <int> pane: 0;
    property <bool> locked: root.scope >= 0 && ClientState.use-global;
    property <length> lw: 520px;
    pure function snap(f: float) -> float { return Math.abs(f - 0.5) < 0.02 ? 0.5 : (f < 0.015 ? 0 : (f > 0.985 ? 1 : f)); }

    // ---------- modules ----------
    Rectangle {
        x: 0px; y: 0px; width: root.lw; height: parent.height;
        SectionHead { x: 0px; y: 0px; width: parent.width; idx: "01"; title: "MODULES"; note: root.scope >= 0 && ClientState.use-global ? "follows global" : ""; }
        Seg { x: 0px; y: 32px; items: ClientState.cats; item-w: (root.lw - 6px) / Math.max(1, ClientState.cats.length); current <=> root.cat; }
        Flickable {
            x: 0px; y: 80px; width: parent.width; height: parent.height - 80px;
            content-height: Math.ceil(ClientState.modules.length / 2) * 78px;
            for m[i] in ClientState.modules: Rectangle {
                property <bool> shown: root.cat == 0 || m.cat == ClientState.cats[root.cat];
                property <int> slot: root.cat == 0 ? i : m.ci;
                visible: self.shown;
                x: mod(self.slot, 2) * (parent.width / 2 + 3px); y: floor(self.slot / 2) * 78px;
                width: parent.width / 2 - 3px; height: 72px;
                background: ClientState.sel == i ? Theme.s3 : (ct.has-hover ? Theme.s2 : Theme.s1);
                opacity: root.locked ? 0.5 : 1;
                animate background { duration: Theme.fast; }
                Rectangle { x: 0px; width: 3px; background: ClientState.sel == i ? Theme.red2 : (m.on ? Theme.ice : Theme.s3); animate background { duration: Theme.mid; } }
                ct := TouchArea { mouse-cursor: pointer; clicked => { ClientState.sel = i; root.pane = 0; } }
                // module glyph tile, as in the in-game menu (item texture only as fallback)
                Rectangle { x: 14px; y: 14px; width: 44px; height: 44px; background: m.on ? Theme.red.with-alpha(0.149) : Theme.s2; border-width: 1px; border-color: m.on ? Theme.red.with-alpha(0.502) : Theme.ln;
                    animate background, border-color { duration: Theme.mid; }
                    if m.has-icon: Image { x: 8px; y: 8px; width: 28px; height: 28px; source: m.icon; image-rendering: m.pixel-icon ? ImageRendering.pixelated : ImageRendering.smooth; }
                    if !m.has-icon: Text { text: m.name; color: Theme.dim; font-family: Theme.disp; font-size: 18px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                Text { x: 70px; y: 11px; width: parent.width - 134px; text: m.name; color: m.on ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; overflow: elide; }
                Text { x: 70px; y: 32px; width: parent.width - 134px; text: m.desc; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; overflow: elide; }
                Text { x: 70px; y: 51px; text: m.cat; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; }
                Toggle { x: parent.width - 56px; y: 25px; on: m.on; enabled: !root.locked;
                    toggled(v) => { if !root.locked { ClientState.modules[i].on = v; ClientState.sel = i; ClientState.save(); } } }
            }
        }
    }

    // ---------- settings / HUD layout ----------
    col := Rectangle {
        x: root.lw + 32px; y: 0px; width: parent.width - root.lw - 32px; height: parent.height;
        property <ClientMod> s: ClientState.sel >= 0 ? ClientState.modules[ClientState.sel] : { name: "" };
        SectionHead { x: 0px; y: 0px; width: parent.width; idx: "02"; title: root.pane == 0 ? "SETTINGS" : "HUD LAYOUT"; note: root.pane == 1 ? "drag to place · snaps to edges and centre" : ""; }
        Seg { x: parent.width - self.width; y: -8px; items: ["SETTINGS", "HUD LAYOUT"]; item-w: 120px; current <=> root.pane; }

        if root.pane == 0 && ClientState.sel < 0: Rectangle {
            y: 40px; height: 220px;
            Hatch { width: parent.width; height: parent.height; }
            Text { x: 28px; y: 44px; text: "PICK A MODULE"; color: Theme.tx; font-family: Theme.disp; font-size: 30px; font-weight: 700; }
            Text { x: 28px; y: 86px; width: parent.width - 56px; wrap: word-wrap; text: "Every setting from the in-game menu lives here too: layout, colours, keys and more. Changes reach a running game within a second."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; }
        }
        if root.pane == 0 && ClientState.sel >= 0: Rectangle {
            y: 40px; height: parent.height - 40px;
            Rectangle {
                y: 0px; height: 76px; background: Theme.s1;
                Text { x: 22px; y: 12px; width: parent.width - 120px; text: col.s.name; color: Theme.tx; font-family: Theme.disp; font-size: 26px; font-weight: 700; overflow: elide; }
                Text { x: 22px; y: 46px; width: parent.width - 120px; text: col.s.desc; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; overflow: elide; }
                Toggle { x: parent.width - 62px; y: 27px; on: col.s.on; enabled: !root.locked;
                    toggled(v) => { if !root.locked && ClientState.sel >= 0 { ClientState.modules[ClientState.sel].on = v; ClientState.save(); } } }
            }
            if root.locked: Text { x: 0px; y: 86px; height: 20px; text: "Following your global setup: turn that off above to change settings here."; color: Theme.redtx; font-family: Theme.ui; font-size: 12px * Theme.ts; vertical-alignment: center; }
            Flickable {
                y: 110px; height: parent.height - 110px;
                content-height: col.s.sets.length * 50px;
                for st[k] in col.s.sets: SettingRow { y: k * 50px; width: parent.width; s: st; mi: ClientState.sel; locked: root.locked; }
            }
        }

        if root.pane == 1: cv := Rectangle {
            property <length> maxh: parent.height - 40px - 76px;
            height: Math.min(self.maxh, parent.width * 9 / 16); width: self.height * 16 / 9;
            x: 0px; y: 40px;
            clip: true; background: Theme.s1;
            Hatch { width: parent.width; height: parent.height; }
            if Backend.cover-choices.length > 1: Image { width: parent.width; height: parent.height; source: Backend.cover-choices[Backend.cover-choices.length - 1].img; image-fit: cover; opacity: 0.6; }
            Rectangle { x: parent.width / 2 - 6px; y: parent.height / 2 - 1px; width: 12px; height: 2px; background: #ffffffcc; }
            Rectangle { x: parent.width / 2 - 1px; y: parent.height / 2 - 6px; width: 2px; height: 12px; background: #ffffffcc; }
            Rectangle { x: (parent.width - 9 * 22px) / 2; y: parent.height - 30px; width: 9 * 22px; height: 22px; background: #00000066; border-width: 1px; border-color: #ffffff44; }
            Rectangle { x: parent.width / 2 - 0.5px; width: 1px; background: Theme.red2.with-alpha(0.533); visible: root.dragging; }
            Rectangle { y: parent.height / 2 - 0.5px; height: 1px; background: Theme.red2.with-alpha(0.533); visible: root.dragging; }
            for m[i] in ClientState.modules: w := Rectangle {
                visible: m.on && m.hud;
                property <length> fw: cv.width - hw.width;
                property <length> fh: cv.height - hw.height;
                x: m.x * self.fw; y: m.y * self.fh;
                width: hw.width; height: hw.height;
                hw := HudWidget { m: m; k: cv.width / 800px; }
                Rectangle { border-width: 1px; border-color: ClientState.sel == i ? Theme.red2 : (wt.has-hover ? #ffffff88 : transparent); }
                wt := TouchArea {
                    mouse-cursor: root.locked ? default : (self.pressed ? MouseCursor.grabbing : MouseCursor.grab);
                    property <length> gx; property <length> gy;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down { ClientState.sel = i; }
                        if root.locked { return; }
                        if e.kind == PointerEventKind.down { self.gx = self.mouse-x; self.gy = self.mouse-y; root.dragging = true; }
                        if e.kind == PointerEventKind.up { root.dragging = false; ClientState.save(); }
                    }
                    moved => {
                        if self.pressed && !root.locked {
                            ClientState.modules[i].moved = true;
                            ClientState.modules[i].x = root.snap(Math.clamp((w.x + self.mouse-x - self.gx) / w.fw, 0, 1));
                            ClientState.modules[i].y = root.snap(Math.clamp((w.y + self.mouse-y - self.gy) / w.fh, 0, 1));
                        }
                    }
                }
            }
            Ticks { width: parent.width; height: parent.height; tint: #ffffff66; }
        }
        if root.pane == 1: Rectangle {
            y: parent.height - 64px; height: 64px;
            if ClientState.sel < 0 || !col.s.hud: Text { y: 0px; height: 30px; vertical-alignment: center; text: "Drag an element on the preview, or pick a HUD module to size it."; color: Theme.mut; font-family: Theme.ui; font-size: 14px * Theme.ts; }
            if ClientState.sel >= 0 && col.s.hud: Rectangle {
                Eyebrow { x: 0px; y: 0px; text: "SELECTED"; }
                Text { x: 0px; y: 18px; width: 200px; text: col.s.name; color: Theme.tx; font-family: Theme.disp; font-size: 24px; font-weight: 700; overflow: elide; }
                Text { x: 220px; y: 14px; height: 30px; text: "Size"; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; vertical-alignment: center; }
                Slider { x: 270px; y: 16px; width: 300px; min: 10; max: 50; major: 10; enabled: !root.locked;
                    value: Math.round(ClientState.modules[ClientState.sel].scale * 20); controlled: true;
                    moved(v) => { if !root.locked && ClientState.sel >= 0 { ClientState.set-num(ClientState.sel, "scale", v / 20); } } }
                Text { x: 584px; y: 14px; width: 50px; height: 30px; text: "\{Math.round(ClientState.modules[ClientState.sel].scale * 100)}%"; color: Theme.tx; font-family: Theme.mono; font-size: 13px * Theme.ts; vertical-alignment: center; }
                Btn { x: 646px; y: 12px; height: 34px; text: "RESET"; clicked => { if !root.locked { ClientState.set-num(ClientState.sel, "scale", 1); } } }
            }
        }
    }
    property <bool> dragging: false;
}

export component ClientScreen inherits Rectangle {
    Heading { x: 53px; y: 22px; text: "CLIENT"; }
    Text { x: 56px; y: 88px; text: "Modules and HUD that run inside the game. This is your global setup; instances can override it."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; }
    // title screen + menu key (rebind in Minecraft: Options > Controls > Key Binds > Nether Client)
    Rectangle {
        x: 1384px - 640px; y: 30px; width: 640px; height: 64px;
        Eyebrow { x: 0px; y: 0px; text: "IN-GAME MENU KEY"; }
        Rectangle { x: 0px; y: 22px; height: 30px; width: kt.preferred-width + 24px; background: Theme.ice;
            kt := Text { text: ClientState.menu-key; color: Theme.ink; font-family: Theme.mono; font-size: 12px * Theme.ts; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
        Text { x: 150px; y: 18px; width: 490px; text: "Rebind the key in Minecraft under Options › Controls › Key Binds › Nether Client."; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; wrap: word-wrap; }
    }
    ClientEditor { x: 56px; y: 132px; width: 1328px; height: parent.height - 132px - 16px; scope: -1; }
}
