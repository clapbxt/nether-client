// Design tokens (v7: NetherGlass Dark/Light = rounded glass + Barlow display; NetherMinecraft Dark/Light = square + Nether Pixel).
// Rust (settings::apply_theme) swaps every value below; defaults = NetherGlass Dark. See NC Obsidian Vault/Design.md.
export global Theme {
    // theme surfaces (OLED default; Rust swaps them for Obsidian / Slate / Ice): bg, three raised steps, hairlines,
    // text (primary, secondary, tertiary), ink = text on ice / accent plates, ice = primary button fill
    in-out property <color> bg: #0D1015;
    in-out property <color> s1: #161A21E6;
    in-out property <color> s2: #1C222B;
    in-out property <color> s3: #252C37;
    in-out property <color> ln: #ffffff12;
    in-out property <color> ln2: #ffffff26;
    in-out property <color> tx: #E9EDF3;
    in-out property <color> dim: #9BA5B4;
    in-out property <color> mut: #677183;
    in-out property <color> ink: #0D1015;
    in-out property <color> ice: #E9EDF3;
    // glass (Home): s1 see-through + hairline
    in-out property <color> glass: #161A21B0;
    in-out property <color> glass-ln: #ffffff1c;
    // white-on-dark / dark-on-light overlay base for hover fills
    in-out property <color> hov: #ffffff0f;
    // stage backdrop: top-left tint the bg fades from, accent aura strength (0 = none), glass top sheen
    in-out property <color> bg-top: #161C26;
    in-out property <float> aura: 0.10;
    in-out property <color> sheen: #ffffff0d;
    // shape: radius for controls / panels / floating cards (all 0 in the Minecraft themes); square = Minecraft theme
    in-out property <length> r1: 8px;
    in-out property <length> r2: 12px;
    in-out property <length> r3: 16px;
    in-out property <bool> square: false;
    in-out property <bool> light: false;
    // accent, racing red by default (Settings > Personalization swaps it): base, bright, deep,
    // readable text on dark, pressed, and the dark plate under PLAY
    in-out property <color> red: #F76A05;
    in-out property <color> red2: #FF9A2E;
    in-out property <color> red3: #8F0400;
    in-out property <color> redtx: #FF7A70;
    in-out property <color> press: #C40500;
    in-out property <color> plate: #4A0200;
    // reading-text scale (Settings > Personalization > Text size); display type stays as designed
    in-out property <float> ts: 1.0;
    // type: condensed display (titles, buttons, labels), text face, data face
    in-out property <string> disp: "Barlow";
    out property <string> ui: "Barlow";
    out property <string> mono: "JetBrains Mono";
    // motion; Reduce motion (set from Rust with Backend.calm) collapses every transition to none
    in-out property <bool> calm: false;
    out property <duration> fast: calm ? 0ms : 110ms;
    out property <duration> mid: calm ? 0ms : 180ms;
    out property <duration> slow: calm ? 0ms : 260ms;
    // full CJK face for text that has Chinese / Japanese / Korean in it (Barlow has none)
    out property <string> cjk: "Microsoft YaHei UI";
}
