// Host page (crates/app/src/host.rs): one dedicated server per profile, its console, players, settings and world.
import { Theme } from "theme.slint";
import { Backend, HostState } from "structs.slint";
import { Eyebrow, Heading, Btn, Hatch, Ticks, SectionHead, Stat, Pulse, Chip, Icon, Ico, IconBtn, LinkBtn, PlayButton, UTabs, Seg, Field, Toggle, Dropdown, Slider, Scrim } from "components.slint";

// Compact setting row: title + one line of explanation left, control (children) right.
component HRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <length> reserve: 200px;
    height: 56px;
    Text { x: 0px; y: 9px; text: root.title; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; }
    Text { x: 0px; y: 30px; width: parent.width - root.reserve; text: root.sub; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; overflow: elide; }
    Rectangle { x: 0px; y: parent.height - 1px; height: 1px; background: Theme.ln; }
    @children
}

// Quiet centred message for an empty list or panel.
component Empty inherits Rectangle {
    in property <string> title;
    in property <string> text;
    Text { y: parent.height / 2 - 22px; width: parent.width; text: root.title; color: Theme.dim; font-family: Theme.disp; font-size: 16px; font-weight: 700; letter-spacing: 0.8px; horizontal-alignment: center; }
    Text { x: 24px; y: parent.height / 2 + 2px; width: parent.width - 48px; text: root.text; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; horizontal-alignment: center; wrap: word-wrap; }
}

// Label + value row in the addresses column, with a copy button.
component AddrRow inherits Rectangle {
    in property <string> k;
    in property <string> v;
    in property <color> tint: Theme.tx;
    in property <bool> can-copy;
    height: 62px;
    Eyebrow { x: 0px; y: 10px; text: root.k; font-size: 12px; }
    Text { x: 0px; y: 28px; width: parent.width - 48px; text: root.v; color: root.tint; font-family: Theme.mono; font-size: 15px * Theme.ts; font-weight: 500; overflow: elide; }
    if root.can-copy: IconBtn { x: parent.width - 32px; y: 15px; size: 32px; d: Ico.copy; clicked => { Backend.copy-text(root.v); Backend.toast(root.k == "LAN" ? "LAN address copied" : "Address copied"); } }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
}

export component HostScreen inherits Rectangle {
    callback go-instances();
    property <int> tab: HostState.tab;
    in-out property <int> list: 0;
    property <bool> has-inst: Backend.instances.length > 0;
    property <int> st: HostState.status;
    property <bool> ready: HostState.phase == 3;
    property <bool> live: HostState.live;
    property <[string]> names: root.list == 0 ? HostState.whitelist : HostState.ops;
    init => { HostState.opened(); }

    Heading { x: 56px; y: 28px; text: "HOST"; font-size: 32px; }
    Text { x: 56px; y: 80px; width: 700px; text: "Run a server from one of your profiles and play on it with friends."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; overflow: elide; }

    // ---------- no instances ----------
    if !root.has-inst: Rectangle {
        x: 56px; y: 132px; width: 1328px; height: 300px; background: Theme.s1; border-radius: Theme.r2; clip: true;
        Hatch { width: parent.width; height: parent.height; }
        Ticks { width: parent.width; height: parent.height; }
        Heading { x: 40px; y: 52px; text: "NOTHING TO HOST"; font-size: 64px; color: Theme.dim; }
        Text { x: 44px; y: 150px; text: "A server runs from one of your profiles. Make one on the Play page, then come back here."; color: Theme.dim; font-family: Theme.ui; font-size: 15px * Theme.ts; }
        Btn { x: 44px; y: 200px; height: 40px; text: "GO TO PLAY"; icon: Ico.chev; clicked => { root.go-instances(); } }
    }

    if root.has-inst: Rectangle {
        // ---------- instance picker ----------
        pick := Rectangle {
            x: 1384px - 250px - 14px - 330px; y: 30px; width: 330px; height: 48px; border-radius: Theme.r2;
            background: root.live ? transparent : (pt.has-hover ? Theme.s2 : Theme.s1);
            border-width: 1px; border-color: root.live ? Theme.ln : (pt.has-hover ? Theme.dim : Theme.ln2);
            animate background, border-color { duration: Theme.fast; }
            property <bool> ok: HostState.idx >= 0 && HostState.idx < Backend.instances.length;
            Rectangle { x: 8px; y: 8px; width: 32px; height: 32px; background: Theme.s2; border-radius: Theme.r1;
                if pick.ok: Image { x: 4px; y: 4px; width: 24px; height: 24px; source: Backend.instances[HostState.idx].icon-img; image-rendering: pixelated; } }
            Text { x: 52px; y: 7px; width: parent.width - 90px; text: pick.ok ? Backend.instances[HostState.idx].name : "Pick a profile"; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; overflow: elide; }
            Text { x: 52px; y: 27px; width: parent.width - 90px; text: root.live ? "Stop the server to switch" : (pick.ok ? Backend.instances[HostState.idx].ver + " · " + Backend.instances[HostState.idx].loader : ""); color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
            if !root.live: Icon { x: parent.width - 26px; y: 18px; d: Ico.down; tint: pt.has-hover ? Theme.tx : Theme.dim; }
            pt := TouchArea { mouse-cursor: root.live ? default : pointer; clicked => { if !root.live { pop.show(); } } }
            pop := PopupWindow {
                x: 0px; y: parent.height + 4px; width: 380px; height: Math.min(Backend.instances.length, 9) * 44px + 40px;
                Rectangle {
                    background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r2;
                    Eyebrow { x: 16px; y: 10px; text: "HOST FROM"; }
                    Flickable {
                        y: 34px; height: parent.height - 38px; content-height: Backend.instances.length * 44px;
                        for it[i] in Backend.instances: Rectangle {
                            y: i * 44px; height: 44px; width: parent.width;
                            background: t2.has-hover ? Theme.s3 : transparent;
                            Rectangle { x: 0px; width: 3px; background: Theme.red; visible: HostState.idx == i; }
                            Image { x: 16px; y: 11px; width: 22px; height: 22px; source: it.icon-img; image-rendering: pixelated; }
                            Text { x: 50px; width: 190px; text: it.name; color: HostState.idx == i || t2.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
                            Text { x: parent.width - 136px; width: 120px; text: it.ver + " · " + it.loader; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                            t2 := TouchArea { mouse-cursor: pointer; clicked => { HostState.select(i); pop.close(); } }
                        }
                    }
                }
            }
        }

        // ---------- primary action: the one red slab ----------
        PlayButton {
            x: 1384px - 250px; y: 26px; width: 250px; height: 56px; text-size: 24px;
            arrow: root.ready && !root.live && !HostState.busy;
            label: HostState.phase == 2 ? (HostState.busy ? "SETTING UP…" : "SET UP SERVER")
                : HostState.phase != 3 ? "START SERVER"
                : root.st == 3 ? "STOPPING…"
                : root.live ? "STOP SERVER"
                : HostState.busy ? "STARTING…" : "START SERVER";
            enabled: (HostState.phase == 2 || HostState.phase == 3) && root.st != 3 && !(HostState.busy && !root.live);
            clicked => { HostState.primary(); }
        }

        // ---------- status plate ----------
        Rectangle {
            x: 56px; y: 132px; width: 860px; height: 240px; background: Theme.s1; border-radius: Theme.r2; clip: true;
            Hatch { width: parent.width; height: parent.height; }
            if root.st == 2: Rectangle { x: -200px; y: 40px; width: 700px; height: 500px; background: @radial-gradient(circle, Theme.red.with-alpha(0.25) 0%, transparent 68%); }
            Ticks { width: parent.width; height: parent.height; }
            if root.live: Pulse { x: 32px; y: 34px; width: 10px; height: 10px; }
            if !root.live: Rectangle { x: 32px; y: 34px; width: 10px; height: 10px; border-radius: 5px; background: root.st == 4 ? Theme.red2 : Theme.mut; }
            Eyebrow { x: 52px; y: 30px; width: parent.width - 80px; text: HostState.inst-name.to-uppercase() + "  ·  " + HostState.inst-meta; color: Theme.dim; font-size: 15px; overflow: elide; }
            Heading {
                x: 30px; y: 72px; font-size: 64px;
                text: HostState.phase == 0 ? "…" : HostState.phase == 1 ? "CAN'T HOST" : HostState.phase == 2 ? "NOT SET UP"
                    : root.st == 1 ? "STARTING" : root.st == 2 ? "ONLINE" : root.st == 3 ? "STOPPING" : root.st == 4 ? "CRASHED" : "OFFLINE";
                color: root.st == 4 ? Theme.red2 : (root.st == 2 || root.st == 1 ? Theme.tx : Theme.dim);
            }
            if root.ready: Rectangle {
                x: 32px; y: 176px; width: 800px; height: 48px;
                Stat { x: 0px; width: 160px; rule: false; k: "PLAYERS"; v: root.live ? "\{HostState.players.length} / \{HostState.max-players}" : "— / \{HostState.max-players}"; }
                Stat { x: 160px; width: 160px; k: root.st == 4 ? "EXIT CODE" : "UPTIME"; v: root.st == 4 ? "\{HostState.exit-code}" : HostState.uptime; }
                Stat { x: 320px; width: 160px; k: "PORT"; v: HostState.port; }
                Stat { x: 480px; width: 300px; k: "REACHABLE VIA";
                    v: !root.live ? "—" : HostState.upnp-state == 2 ? "Internet · UPnP" : HostState.upnp-state == 1 ? "Opening port…" : "Your network only"; }
            }
            if !root.ready: Text { x: 32px; y: 186px; width: 760px; text: HostState.phase-note; color: HostState.phase == 1 ? Theme.redtx : Theme.dim; font-family: Theme.ui; font-size: 15px * Theme.ts; wrap: word-wrap; }
        }

        // ---------- share: the address friends type into Direct Connect ----------
        tk := Rectangle {
            x: 948px; y: 132px; width: 436px; height: 240px; clip: true;
            background: Theme.s1; border-radius: Theme.r2; border-width: 1px; border-color: tk.has ? Theme.red.with-alpha(0.5) : Theme.ln;
            property <bool> has: HostState.share-addr != "" && root.live;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 3px; background: tk.has ? Theme.red : Theme.ln2; }
            Eyebrow { x: 28px; y: 26px; text: "SHARE WITH FRIENDS"; }
            if tk.has: Text { x: 28px; y: 50px; width: parent.width - 56px; height: 56px; text: HostState.share-addr; color: Theme.tx; font-family: Theme.mono; font-size: HostState.share-addr.character-count > 18 ? 22px : 28px; font-weight: 700; vertical-alignment: center; overflow: elide; }
            if !tk.has: Text { x: 28px; y: 50px; width: parent.width - 56px; height: 56px; text: "NOT RUNNING"; color: Theme.mut; font-family: Theme.pix; font-size: 32px; font-weight: 700; vertical-alignment: center; }
            if tk.has: Btn { x: 28px; y: 116px; height: 36px; text: "COPY ADDRESS"; solid: true; icon: Ico.copy; clicked => { Backend.copy-text(HostState.share-addr); Backend.toast("Address copied"); } }
            if tk.has && HostState.pub-addr != "": LinkBtn { x: parent.width - 28px - self.width; y: 122px;
                text: HostState.reach == 1 ? "CHECKING…" : "CHECK FROM OUTSIDE"; clicked => { if HostState.reach != 1 { HostState.check-reach(); } } }
            Text {
                x: 28px; y: 168px; width: parent.width - 56px; height: 56px; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; overflow: elide;
                color: HostState.reach == 3 ? Theme.redtx : (HostState.reach == 2 ? Theme.ok : Theme.dim);
                text: !tk.has ? "Start the server and the address to share appears here."
                    : HostState.reach == 2 ? "Reachable from the internet. Friends add this address under Multiplayer, then Direct Connect."
                    : HostState.reach == 3 ? "Not reachable from outside yet. Forward the port on your router (see Addresses), then check again."
                    : HostState.pub-addr != "" ? "Friends add this address under Multiplayer, then Direct Connect. Check from outside to be sure it works."
                    : "Works on your network only. Friends on the same Wi-Fi add this address under Multiplayer, then Direct Connect.";
            }
        }

        // ---------- addresses (right column) ----------
        SectionHead { x: 948px; y: 413px; width: 436px; idx: ""; title: "ADDRESSES"; note: "TCP \{HostState.port}"; }
        AddrRow { x: 948px; y: 446px; width: 436px; k: "LAN"; v: HostState.lan == "" ? "No network connection" : HostState.lan; tint: HostState.lan == "" ? Theme.mut : Theme.tx; can-copy: HostState.lan != ""; }
        AddrRow {
            x: 948px; y: 508px; width: 436px; k: "INTERNET";
            v: HostState.upnp-state == 2 ? (HostState.pub-addr != "" ? HostState.pub-addr : "Port open, no public address")
                : HostState.upnp-state == 1 ? "Opening the port with UPnP…"
                : HostState.upnp-state == 3 ? "UPnP didn't work"
                : HostState.upnp-state == 4 ? "UPnP is off" : "Start the server to open the port";
            tint: HostState.upnp-state == 2 && HostState.pub-addr != "" ? Theme.tx : (HostState.upnp-state == 3 ? Theme.redtx : Theme.mut);
            can-copy: HostState.upnp-state == 2 && HostState.pub-addr != "";
        }
        hint := Rectangle {
            x: 948px; y: 586px; width: 436px; height: 166px;
            property <bool> manual: HostState.upnp-state == 3 || HostState.upnp-state == 4 || (HostState.upnp-state == 2 && HostState.pub-addr == "");
            if hint.manual: Rectangle { x: 0px; y: 0px; width: 3px; height: 100%; background: HostState.upnp-state == 3 ? Theme.red2 : Theme.ln2; }
            if hint.manual && HostState.upnp-msg != "": Text { x: 18px; y: 0px; width: parent.width - 18px; text: HostState.upnp-msg; color: HostState.upnp-state == 3 ? Theme.redtx : Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; overflow: elide; height: 36px; }
            if hint.manual: Text { x: 18px; y: HostState.upnp-msg != "" ? 42px : 0px; width: parent.width - 18px; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap;
                text: "For friends outside your network: forward TCP port " + HostState.port + " on your router to " + (HostState.lan == "" ? "this PC" : HostState.lan) + ", then share your public IP. LAN friends can join right away."; }
            if !hint.manual: Text { x: 0px; y: 0px; width: parent.width; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap;
                text: "Friends add the address under Multiplayer, then Direct Connect. Nether Client players can also be invited to a world from in game."; }
        }

        // ---------- tabs ----------
        UTabs { x: 56px; y: 404px; width: 860px; items: ["CONSOLE", "PLAYERS", "SETTINGS", "WORLD"]; item-w: 130px; current <=> HostState.tab; }
        if root.tab == 2: Text { x: 56px; y: 404px; width: 860px; height: 38px; text: "Saved automatically · applies on next start"; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
        if root.tab == 0 && root.live: Text { x: 56px; y: 404px; width: 860px; height: 38px; text: "\{HostState.console.length} lines"; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }

        if HostState.phase == 1: Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px; background: Theme.s1; border-radius: Theme.r2; clip: true;
            Hatch { width: parent.width; height: parent.height; }
            Empty { title: "NOT AVAILABLE FOR THIS PROFILE"; text: "Vanilla and Fabric profiles can host a server. Pick one of those above."; }
        }

        // CONSOLE
        if root.tab == 0 && HostState.phase != 1: con := Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px; background: Theme.s1; border-radius: Theme.r2; clip: true;
            property <bool> follow: true;
            property <int> rev: HostState.console-rev;
            changed rev => { if con.follow { fl.content-y = Math.min(0px, fl.height - fl.content-height); } }
            init => { fl.content-y = Math.min(0px, fl.height - fl.content-height); }
            fl := Flickable {
                x: 0px; y: 0px; width: parent.width; height: parent.height - 42px;
                content-height: Math.max(self.height, HostState.console.length * 18px + 24px);
                flicked => { con.follow = self.content-y <= self.height - self.content-height + 6px; }
                for l[i] in HostState.console: Text {
                    x: 18px; y: 12px + i * 18px; width: 860px - 36px; height: 18px;
                    text: l.t; color: l.k == 1 ? Theme.redtx : (l.k == 2 ? Theme.tx : Theme.dim);
                    font-family: Theme.mono; font-size: 12px * Theme.ts; font-weight: l.k == 2 ? 500 : 400; vertical-alignment: center; overflow: elide;
                }
            }
            if HostState.console.length == 0: Empty { height: parent.height - 42px;
                title: root.live ? "WAITING FOR OUTPUT" : "CONSOLE";
                text: root.live ? "The server is starting up." : (HostState.phase == 2 ? "Set the server up, then start it to see its log here." : "Start the server to see its log and send commands."); }
            if !con.follow: Rectangle {
                x: parent.width - self.width - 14px; y: parent.height - 42px - self.height - 12px; width: jl.preferred-width + 40px; height: 28px;
                background: jt.has-hover ? Theme.s2 : Theme.s3; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r1;
                animate background { duration: Theme.fast; }
                Icon { x: 12px; y: 8px; d: Ico.down; tint: Theme.tx; }
                jl := Text { x: 30px; height: parent.height; text: "LATEST"; color: Theme.tx; font-family: Theme.disp; font-size: 13px; font-weight: 700; letter-spacing: 0.7px; vertical-alignment: center; }
                jt := TouchArea { mouse-cursor: pointer; clicked => { con.follow = true; fl.content-y = Math.min(0px, fl.height - fl.content-height); } }
            }
            Rectangle { x: 0px; y: parent.height - 42px; height: 1px; background: inp.has-focus ? Theme.red2 : Theme.ln; animate background { duration: Theme.mid; } }
            Text { x: 18px; y: parent.height - 41px; height: 41px; text: ">"; color: root.live ? Theme.redtx : Theme.mut; font-family: Theme.mono; font-size: 13px * Theme.ts; font-weight: 700; vertical-alignment: center; }
            if inp.text == "": Text { x: 38px; y: parent.height - 41px; height: 41px; text: root.live ? "Type a command, like say hello or time set day" : "Commands can be sent while the server runs"; color: Theme.mut; font-family: Theme.mono; font-size: 12px * Theme.ts; vertical-alignment: center; }
            Text { x: parent.width - 18px - self.preferred-width; y: parent.height - 41px; height: 41px; text: "ENTER SEND · ↑↓ HISTORY"; color: Theme.mut; font-family: Theme.disp; font-size: 12px; font-weight: 600; letter-spacing: 0.7px; vertical-alignment: center; visible: root.live; }
            FocusScope {
                x: 38px; y: parent.height - 41px; width: parent.width - 220px; height: 41px;
                capture-key-pressed(e) => {
                    if e.text == Key.UpArrow { inp.text = HostState.history(-1); inp.set-selection-offsets(999, 999); return accept; }
                    if e.text == Key.DownArrow { inp.text = HostState.history(1); inp.set-selection-offsets(999, 999); return accept; }
                    reject
                }
                inp := TextInput {
                    width: parent.width; height: parent.height; vertical-alignment: center; single-line: true; enabled: root.live;
                    color: Theme.tx; font-family: Theme.mono; font-size: 12px * Theme.ts; selection-background-color: Theme.red.with-alpha(0.5);
                    accepted => { if self.text != "" { HostState.send(self.text); self.text = ""; con.follow = true; } }
                }
            }
        }

        // PLAYERS
        if root.tab == 1 && HostState.phase != 1: Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px;
            SectionHead { x: 0px; y: 0px; width: 500px; idx: "01"; title: "ONLINE"; note: root.live ? "\{HostState.players.length} / \{HostState.max-players}" : "offline"; }
            Flickable {
                x: 0px; y: 28px; width: 500px; height: 266px; content-height: HostState.players.length * 48px;
                for p[i] in HostState.players: Rectangle {
                    y: i * 48px; width: 500px; height: 48px;
                    background: rh.has-hover ? Theme.hov : transparent; border-radius: Theme.r1;
                    rh := TouchArea { }
                    Rectangle { x: 0px; width: 3px; background: Theme.red; visible: rh.has-hover; }
                    Text { x: 12px; width: 26px; text: i + 1 < 10 ? "0\{i + 1}" : "\{i + 1}"; color: Theme.mut; font-family: Theme.mono; font-size: 12px * Theme.ts; font-weight: 700; vertical-alignment: center; }
                    nm := Text { x: 44px; text: p.name; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; vertical-alignment: center; }
                    if p.op: Chip { x: nm.x + nm.preferred-width + 10px; y: 13px; text: "OP"; hot: true; }
                    if p.wl: Chip { x: nm.x + nm.preferred-width + (p.op ? 50px : 10px); y: 13px; text: "WHITELISTED"; }
                    kb := Btn { x: parent.width - self.width - 8px; y: 10px; height: 28px; text: "KICK"; danger: true; clicked => { HostState.player(p.name, 0); } }
                    wb := Btn { x: kb.x - self.width - 6px; y: 10px; height: 28px; text: "WHITELIST"; visible: !p.wl; clicked => { if !p.wl { HostState.player(p.name, 3); } } }
                    Btn { x: (p.wl ? kb.x : wb.x) - self.width - 6px; y: 10px; height: 28px; text: p.op ? "DEOP" : "OP"; clicked => { HostState.player(p.name, p.op ? 2 : 1); } }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if HostState.players.length == 0: Empty { x: 0px; y: 28px; width: 500px; height: 220px;
                title: root.live ? "NO ONE ONLINE YET" : "SERVER OFFLINE";
                text: root.live ? "Players show up here as they join. Send them the address." : "Start the server to see who's playing."; }

            // whitelist / operators editor
            Seg { x: 532px; y: -7px; items: ["WHITELIST", "OPERATORS"]; item-w: 120px; current <=> root.list; }
            if root.list == 0: Toggle { x: 860px - 42px; y: 0px; on <=> HostState.wl-on; toggled => { HostState.save-settings(); } }
            if root.list == 0: Text { x: 760px; y: 0px; width: 50px; height: 22px; text: HostState.wl-on ? "ON" : "OFF"; color: HostState.wl-on ? Theme.tx : Theme.mut; font-family: Theme.disp; font-size: 13px; font-weight: 700; letter-spacing: 0.8px; horizontal-alignment: right; vertical-alignment: center; }
            nf := Field { x: 532px; y: 40px; width: 328px - 86px; placeholder: "Minecraft name"; accepted => { if self.text != "" { HostState.list-add(root.list, self.text); self.text = ""; } } }
            Btn { x: 860px - 76px; y: 40px; width: 76px; height: 40px; text: "ADD"; icon: Ico.plus; enabled: nf.text != ""; clicked => { HostState.list-add(root.list, nf.text); nf.text = ""; } }
            Flickable {
                x: 532px; y: 92px; width: 328px; height: 202px; content-height: root.names.length * 40px;
                for n[i] in root.names: Rectangle {
                    y: i * 40px; width: 328px; height: 40px;
                    Text { x: 0px; width: parent.width - 40px; text: n; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
                    IconBtn { x: parent.width - 28px; y: 6px; size: 28px; d: Ico.close; danger: true; clicked => { HostState.list-remove(root.list, n); } }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if root.names.length == 0: Text {
                x: 532px; y: 104px; width: 328px; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap;
                text: root.list == 0 ? (HostState.wl-on ? "The whitelist is on and empty: no one can join yet. Add your friends by name." : "The whitelist is off, so anyone with the address can join. Turn it on to allow only the names you add.")
                    : "Operators can use admin commands like /gamemode and /kick. Add trusted players by name.";
            }
        }

        // SETTINGS
        if root.tab == 2 && HostState.phase != 1: Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px;
            HRow { x: 0px; y: 0px; width: 410px; title: "Port"; sub: "TCP port friends connect to"; reserve: 140px;
                Field { x: parent.width - 110px; y: 8px; width: 110px; text <=> HostState.port; edited => { HostState.save-settings(); } } }
            HRow { x: 0px; y: 56px; width: 410px; title: "Message"; sub: "Shown in the server list"; reserve: 250px;
                Field { x: parent.width - 220px; y: 8px; width: 220px; text <=> HostState.motd; edited => { HostState.save-settings(); } } }
            HRow { x: 0px; y: 112px; width: 410px; title: "Max players"; sub: "How many can be online at once"; reserve: 110px;
                Field { x: parent.width - 80px; y: 8px; width: 80px; text <=> HostState.max-players; edited => { HostState.save-settings(); } } }
            HRow { x: 0px; y: 168px; width: 410px; title: "Memory"; sub: "RAM for the server"; reserve: 240px;
                Slider { x: parent.width - 220px; y: 17px; width: 160px; min: 1; max: 16; value <=> HostState.ram; released => { HostState.save-settings(); } }
                Text { x: parent.width - 50px; width: 50px; text: "\{HostState.ram} GB"; color: Theme.tx; font-family: Theme.mono; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; } }
            HRow { x: 0px; y: 224px; width: 410px; title: "Difficulty"; sub: "Mob damage and hunger"; reserve: 200px;
                Dropdown { x: parent.width - 170px; y: 8px; width: 170px; items: ["Peaceful", "Easy", "Normal", "Hard"]; current <=> HostState.difficulty; changed => { HostState.save-settings(); } } }

            HRow { x: 450px; y: 0px; width: 410px; title: "Game mode"; sub: "For players joining the first time"; reserve: 200px;
                Dropdown { x: parent.width - 170px; y: 8px; width: 170px; items: ["Survival", "Creative", "Adventure", "Spectator"]; current <=> HostState.gamemode; changed => { HostState.save-settings(); } } }
            HRow { x: 450px; y: 56px; width: 410px; title: "PvP"; sub: "Players can hurt each other";
                Toggle { x: parent.width - 42px; y: 17px; on <=> HostState.pvp; toggled => { HostState.save-settings(); } } }
            HRow { x: 450px; y: 112px; width: 410px; title: "Online mode"; sub: "Only real Minecraft accounts can join";
                Toggle { x: parent.width - 42px; y: 17px; on <=> HostState.online; toggled => { HostState.save-settings(); } } }
            HRow { x: 450px; y: 168px; width: 410px; title: "Whitelist"; sub: "Only listed players can join";
                Toggle { x: parent.width - 42px; y: 17px; on <=> HostState.wl-on; toggled => { HostState.save-settings(); } } }
            HRow { x: 450px; y: 224px; width: 410px; title: "Open port automatically"; sub: "Ask the router to forward it (UPnP)";
                Toggle { x: parent.width - 42px; y: 17px; on <=> HostState.upnp; toggled => { HostState.save-settings(); } } }
        }

        // WORLD
        if root.tab == 3 && HostState.phase != 1: Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px;
            SectionHead { x: 0px; y: 0px; width: 410px; idx: "01"; title: "USE A SINGLEPLAYER WORLD"; }
            Text { x: 0px; y: 28px; width: 410px; text: "Copies a world from this profile into the server. The original is not changed; the current server world is set aside, never deleted."; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
            Flickable {
                x: 0px; y: 78px; width: 410px; height: 216px; content-height: HostState.saves.length * 44px;
                for s[i] in HostState.saves: Rectangle {
                    y: i * 44px; width: 410px; height: 44px;
                    Text { x: 0px; width: parent.width - 120px; text: s; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; vertical-alignment: center; overflow: elide; }
                    Btn { x: parent.width - self.width; y: 8px; height: 28px; text: "COPY IN"; icon: Ico.copy; enabled: !root.live && !HostState.busy; clicked => { HostState.import-save(i); } }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if HostState.saves.length == 0: Text { x: 0px; y: 90px; width: 410px; text: "This profile has no singleplayer worlds yet. Play it once and create a world, or let the server make a fresh one."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
            if root.live && HostState.saves.length > 0: Text { x: 0px; y: 78px + Math.min(HostState.saves.length, 4) * 44px + 12px; width: 410px; text: "Stop the server to swap its world."; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; }

            SectionHead { x: 450px; y: 0px; width: 410px; idx: "02"; title: "BACKUPS"; note: "\{HostState.backups.length}"; }
            Btn { x: 450px; y: 30px; height: 34px; text: "BACK UP NOW"; icon: Ico.download; enabled: HostState.phase == 3 && !HostState.busy && root.st != 1 && root.st != 3; clicked => { HostState.backup(); } }
            LinkBtn { x: 860px - self.width; y: 33px; text: "OPEN FOLDER"; clicked => { HostState.open-backups(); } }
            Flickable {
                x: 450px; y: 78px; width: 410px; height: 216px; content-height: HostState.backups.length * 44px;
                for b[i] in HostState.backups: Rectangle {
                    y: i * 44px; width: 410px; height: 44px;
                    Text { x: 0px; y: 6px; width: parent.width - 90px; text: b.date; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                    Text { x: 0px; y: 25px; width: parent.width - 90px; text: b.name; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
                    Text { x: parent.width - 90px; width: 90px; text: b.size; color: Theme.dim; font-family: Theme.mono; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if HostState.backups.length == 0: Text { x: 450px; y: 90px; width: 410px; text: "No backups yet. A backup is a zip of the server world, saved in the server folder."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
        }
    }

    // ---------- EULA: only the user's click on I AGREE accepts it ----------
    if HostState.eula-open: Scrim {
        dismiss => { HostState.eula-open = false; }
        Rectangle {
            x: (parent.width - 560px) / 2; y: 200px; width: 560px; height: 290px;
            background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: Theme.r3; clip: true;
            TouchArea { }
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 4px; background: Theme.red; }
            Eyebrow { x: 28px; y: 28px; text: "BEFORE THE FIRST START"; }
            Heading { x: 28px; y: 50px; text: "MINECRAFT EULA"; font-size: 32px; }
            Text { x: 28px; y: 98px; width: parent.width - 56px; text: "Running a Minecraft server means agreeing to Mojang's End User License Agreement. Please read it. The server only starts after you agree."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
            LinkBtn { x: 28px; y: 156px; text: "READ THE EULA"; clicked => { Backend.open-url("https://aka.ms/MinecraftEULA"); } }
            Text { x: 28px; y: 186px; text: "aka.ms/MinecraftEULA"; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; }
            nb := Btn { x: parent.width - 28px - self.width - ab.width - 10px; y: parent.height - 64px; text: "NOT NOW"; clicked => { HostState.eula-open = false; } }
            ab := Btn { x: parent.width - 28px - self.width; y: parent.height - 64px; text: "I AGREE"; solid: true; icon: Ico.check; clicked => { HostState.accept-eula(); } }
        }
    }
}
