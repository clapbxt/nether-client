import { Theme } from "theme.slint";
import { Backend, HostState, HostServer } from "structs.slint";
import { Eyebrow, Heading, Btn, Hatch, Ticks, SectionHead, Stat, Pulse, Chip, Icon, Ico, IconBtn, LinkBtn, PlayButton, UTabs, Seg, Field, Toggle, Dropdown, Slider, Scrim, Slash, ModIcon } from "components.slint";

// Compact setting row: title + one line of explanation left, control (children) right.
component HRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <length> reserve: 200px;
    height: 56px;
    Text { x: 0px; y: 9px; text: root.title; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; }
    Text { x: 0px; y: 30px; width: parent.width - root.reserve; text: root.sub; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; overflow: elide; }
    Rectangle { x: 0px; y: parent.height - 1px; height: 1px; background: Theme.ln; }
    @children
}

// Quiet centred message for an empty list or panel.
component Empty inherits Rectangle {
    in property <string> title;
    in property <string> text;
    Text { y: parent.height / 2 - 22px; width: parent.width; text: root.title; color: Theme.dim; font-family: Theme.ui; font-size: 16px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; horizontal-alignment: center; }
    Text { x: 24px; y: parent.height / 2 + 2px; width: parent.width - 48px; text: root.text; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; horizontal-alignment: center; wrap: word-wrap; }
}

// Label + value row in the addresses column, with a copy button.
component AddrRow inherits Rectangle {
    in property <string> k;
    in property <string> v;
    in property <color> tint: Theme.tx;
    in property <bool> can-copy;
    in property <string> note;
    in property <color> note-tint: Theme.mut;
    height: 62px;
    Eyebrow { x: 0px; y: 10px; text: root.k; font-size: 12px * Theme.ts; }
    if root.note != "": Text { x: 0px; y: 10px; width: parent.width - 48px; text: root.note; color: root.note-tint; font-family: Theme.mono; font-size: 11px * Theme.ts; font-weight: 700; horizontal-alignment: right; }
    Text { x: 0px; y: 28px; width: parent.width - 48px; text: root.v; color: root.tint; font-family: Theme.mono; font-size: 15px * Theme.ts; font-weight: 500; overflow: elide; }
    if root.can-copy: IconBtn { x: parent.width - 32px; y: 15px; size: 32px; d: Ico.copy; tip: "Copy"; clicked => { Backend.copy-text(root.v); Backend.toast(root.k == "LAN" ? "LAN address copied" : "Address copied"); } }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
}

// Status square for a server: red online, ice while starting/stopping, grey off.
component Dot inherits Rectangle {
    in property <int> status;
    width: 10px; height: 10px; border-radius: 5px;
    background: root.status == 2 ? Theme.red : (root.status == 1 || root.status == 3) ? Theme.ice : root.status == 4 ? Theme.red2 : Theme.mut;
}

// Big selectable card (wizard type / world choices).
component Choice inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> chip;
    in property <bool> on;
    callback clicked();
    callback double-clicked();
    background: root.on ? Theme.red.with-alpha(0.094) : (ct.has-hover ? Theme.s2 : Theme.s1);
    border-width: 1px; border-color: root.on ? Theme.red2 : Theme.ln; border-radius: 8px;
    animate background, border-color { duration: Theme.fast; }
    Text { x: 24px; y: 22px; width: parent.width - 48px; text: root.title; color: Theme.tx; font-family: Theme.disp; font-size: 32px; font-weight: 800;  overflow: elide; }
    if root.chip != "": Chip { x: parent.width - self.width - 20px; y: 24px; text: root.chip; hot: true; }
    Text { x: 24px; y: 70px; width: parent.width - 48px; text: root.text; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
    ct := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.double-clicked(); } }
}

export component HostScreen inherits Rectangle {
    callback go-instances();
    property <int> tab: HostState.tab;
    in-out property <int> list: 0;
    property <bool> has-srv: HostState.servers.length > 0;
    property <int> st: HostState.status;
    property <bool> ready: HostState.phase == 3;
    property <bool> live: HostState.live;
    property <[string]> names: root.list == 0 ? HostState.whitelist : HostState.ops;
    property <string> addon-word: HostState.kind == "paper" ? "PLUGINS" : HostState.kind == "fabric" ? "MODS" : "ADD-ONS";
    property <bool> confirm-del;
    changed tab => { if root.tab == 2 && HostState.hits.length == 0 && HostState.kind != "vanilla" { HostState.addon-search(""); } }
    init => { HostState.opened(); }

    Heading { x: 56px; y: 28px; text: "HOST"; font-size: 32px; }
    Text { x: 56px; y: 92px; text: "Run servers on this PC and invite friends anywhere with an address or link. Several can run at once."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; }

    // ---------- no servers: the walkthrough at a glance ----------
    if !root.has-srv: Rectangle {
        x: 56px; y: 132px; width: 1328px; height: 420px; background: Theme.s1; border-radius: 8px; border-width: 1px; border-color: Theme.ln; clip: true;
        Hatch { width: parent.width; height: parent.height; }
        Ticks { width: parent.width; height: parent.height; }
        Heading { x: 40px; y: 52px; text: "NO SERVERS YET"; font-size: 48px; color: Theme.tx; }
        Text { x: 44px; y: 150px; text: "A server lives on its own, apart from your instances. Setting one up takes about a minute."; color: Theme.dim; font-family: Theme.ui; font-size: 15px * Theme.ts; }
        for s[i] in [{t: "TYPE", d: "Vanilla, Fabric for mods, or Paper for plugins"},
                     {t: "VERSION", d: "Any Minecraft release the type supports"},
                     {t: "WORLD", d: "A fresh world, or a copy of one from an instance"},
                     {t: "PLAYERS", d: "Whitelist, account checks and the router port"}]: Rectangle {
            x: 44px + i * 310px; y: 200px; width: 290px; height: 100px;
            Rectangle { y: 0px; height: 1px; background: Theme.ln2; }
            Text { x: 0px; y: 14px; text: s.t; color: Theme.tx; font-family: Theme.disp; font-size: 24px; font-weight: 700; }
            Text { x: 0px; y: 54px; width: parent.width - 16px; text: s.d; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
        }
        Btn { x: 44px; y: 336px; height: 44px; text: "SET UP A SERVER"; solid: true; icon: Ico.plus; clicked => { HostState.new-server(); } }
    }

    if root.has-srv: Rectangle {
        // ---------- server picker ----------
        pick := Rectangle {
            x: 196px; y: 34px; width: 330px; height: 48px;
            background: pt.has-hover ? Theme.s2 : Theme.s1;
            border-width: 1px; border-color: pt.has-hover ? #ffffff66 : Theme.ln2; border-radius: 8px;
            animate background, border-color { duration: Theme.fast; }
            property <bool> ok: HostState.idx >= 0 && HostState.idx < HostState.servers.length;
            Dot { x: 18px; y: 19px; status: pick.ok ? HostState.servers[HostState.idx].status : 0; }
            Text { x: 44px; y: 7px; width: parent.width - 82px; text: pick.ok ? HostState.servers[HostState.idx].name : "Pick a server"; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; overflow: elide; }
            Text { x: 44px; y: 27px; width: parent.width - 82px; text: (pick.ok ? HostState.servers[HostState.idx].meta : "") + (HostState.running > 1 ? "  ·  \{HostState.running} running" : ""); color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
            Icon { x: parent.width - 26px; y: 18px; d: Ico.down; tint: pt.has-hover ? Theme.tx : Theme.dim; }
            pt := TouchArea { mouse-cursor: pointer; clicked => { pop.show(); } }
            pop := PopupWindow {
                x: 0px; y: parent.height + 4px; width: 420px; height: Math.min(HostState.servers.length, 8) * 48px + 34px + 52px;
                Rectangle {
                    background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: 8px;
                    Eyebrow { x: 16px; y: 10px; text: "SERVERS"; }
                    Flickable {
                        y: 34px; height: parent.height - 34px - 52px; content-height: HostState.servers.length * 48px;
                        for it[i] in HostState.servers: Rectangle {
                            y: i * 48px; height: 48px; width: parent.width;
                            background: t2.has-hover ? Theme.s3 : transparent;
                            Rectangle { x: 0px; width: 3px; background: Theme.red; visible: HostState.idx == i; }
                            Dot { x: 18px; y: 19px; status: it.status; }
                            Text { x: 44px; y: 7px; width: 220px; text: it.name; color: HostState.idx == i || t2.has-hover ? Theme.tx : Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                            Text { x: 44px; y: 27px; width: 220px; text: it.meta; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
                            Text { x: parent.width - 136px; width: 120px; text: it.status == 2 ? "ONLINE · \{it.players}" : it.status == 1 ? "STARTING" : it.status == 3 ? "STOPPING" : it.status == 4 ? "CRASHED" : "OFFLINE";
                                color: it.status == 2 ? Theme.tx : Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                            t2 := TouchArea { mouse-cursor: pointer; clicked => { HostState.select(i); pop.close(); } }
                        }
                    }
                    Rectangle {
                        y: parent.height - 52px; height: 52px; background: nt.has-hover ? Theme.s3 : transparent;
                        Rectangle { y: 0px; height: 1px; background: Theme.ln; }
                        Icon { x: 17px; y: 20px; d: Ico.plus; tint: nt.has-hover ? Theme.red2 : Theme.dim; }
                        Text { x: 44px; height: parent.height; text: "NEW SERVER"; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; }
                        nt := TouchArea { mouse-cursor: pointer; clicked => { pop.close(); HostState.new-server(); } }
                    }
                }
            }
        }
        nsb := Btn { x: 540px; y: 38px; height: 40px; text: "NEW SERVER"; icon: Ico.plus; clicked => { HostState.new-server(); } }
        IconBtn { x: nsb.x + nsb.width + 8px; y: 38px; size: 40px; d: Ico.folder; tip: "Open folder"; clicked => { HostState.open-folder(); } }
        IconBtn { x: nsb.x + nsb.width + 56px; y: 38px; size: 40px; d: Ico.trash; danger: true; tip: "Delete server"; clicked => { if root.live { Backend.toast("Stop the server before deleting it"); } else { root.confirm-del = true; } } }

        // ---------- primary action: the one red slab ----------
        PlayButton {
            x: 1384px - 330px; y: 30px; width: 330px; height: 56px; text-size: 24px;
            arrow: root.ready && !root.live && !HostState.busy;
            label: HostState.phase == 2 ? (HostState.busy ? "SETTING UP…" : "SET UP SERVER")
                : HostState.phase != 3 ? "START SERVER"
                : root.st == 3 ? "STOPPING…"
                : root.live ? "STOP SERVER"
                : HostState.busy ? "STOP SERVER" : "START SERVER";
            enabled: (HostState.phase == 2 || HostState.phase == 3) && root.st != 3 && !(HostState.busy && !root.live && HostState.phase != 3);
            clicked => { HostState.primary(); }
        }

        // ---------- status plate ----------
        Rectangle {
            x: 56px; y: 132px; width: 860px; height: 240px; background: Theme.s1; border-radius: 8px; border-width: 1px; border-color: Theme.ln; clip: true;
            Hatch { width: parent.width; height: parent.height; }
            if root.st == 2: Rectangle { x: -200px; y: 40px; width: 700px; height: 500px; background: @radial-gradient(circle, Theme.red.with-alpha(0.251) 0%, Theme.red.with-alpha(0.000) 68%); }
            Ticks { width: parent.width; height: parent.height; }
            if root.live: Pulse { x: 32px; y: 34px; width: 10px; height: 10px; }
            if !root.live: Rectangle { x: 32px; y: 34px; width: 10px; height: 10px; background: root.st == 4 ? Theme.red2 : Theme.mut; }
            Eyebrow { x: 52px; y: 30px; width: parent.width - 80px; text: HostState.inst-name.to-uppercase() + "  ·  " + HostState.inst-meta; color: Theme.dim; font-size: 15px * Theme.ts; overflow: elide; }
            Heading {
                x: 28px; y: 40px; font-size: 128px;
                text: HostState.phase == 0 ? "…" : HostState.phase == 2 ? "NOT SET UP"
                    : root.st == 1 ? "STARTING" : root.st == 2 ? "ONLINE" : root.st == 3 ? "STOPPING" : root.st == 4 ? "CRASHED" : "OFFLINE";
                color: root.st == 4 ? Theme.red2 : (root.st == 2 || root.st == 1 ? Theme.tx : Theme.dim);
            }
            if root.ready: Rectangle {
                x: 32px; y: 176px; width: 800px; height: 48px;
                Stat { x: 0px; width: 160px; rule: false; k: "PLAYERS"; v: root.live ? "\{HostState.players.length} / \{HostState.max-players}" : "— / \{HostState.max-players}"; }
                Stat { x: 160px; width: 160px; k: root.st == 4 ? "EXIT CODE" : "UPTIME"; v: root.st == 4 ? "\{HostState.exit-code}" : HostState.uptime; }
                Stat { x: 320px; width: 160px; k: "PORT"; v: HostState.port; }
                Stat { x: 480px; width: 300px; size: 16px; k: "REACHABLE VIA";
                    v: !root.live ? "—" : HostState.tun == 4 ? "Internet · tunnel" : HostState.reach == 2 ? "Internet · checked"
                        : HostState.reach == 1 || HostState.upnp-state == 1 ? "Checking…" : "Your network only"; }
            }
            if !root.ready: Text { x: 32px; y: 186px; width: 760px; text: HostState.phase-note; color: Theme.dim; font-family: Theme.ui; font-size: 15px * Theme.ts; wrap: word-wrap; }
        }

        // ---------- invite ticket: the one ice slab on this screen ----------
        tk := Rectangle {
            x: 948px; y: 132px; width: 436px; height: 240px; clip: true;
            background: Theme.s1; border-radius: 8px; border-width: 1px; border-color: Theme.ln;
            property <bool> has: HostState.addr != "" && root.live;
            Text { x: 28px; y: 24px; text: "INVITE FRIENDS"; color: Theme.dim; font-family: Theme.disp; font-size: 16px; font-weight: 700; }
            if tk.has: Rectangle {
                x: parent.width - 28px - cc.preferred-width; y: 20px; width: cc.preferred-width; height: 24px;
                cc := Text { text: "COPY ADDRESS"; color: ccta.has-hover ? Theme.red : Theme.dim; font-family: Theme.disp; font-size: 16px; font-weight: 700; vertical-alignment: center; animate color { duration: Theme.fast; } }
                ccta := TouchArea { mouse-cursor: pointer; clicked => { Backend.copy-text(HostState.addr); Backend.toast("Address copied"); } }
            }
            if tk.has: Text { x: 28px; y: 50px; width: parent.width - 56px; height: 60px; text: HostState.addr; color: Theme.tx; font-family: Theme.mono; font-size: HostState.addr.character-count > 17 ? 22px : 34px; font-weight: 700; vertical-alignment: center; overflow: elide; }
            if !tk.has: Text { x: 28px; y: 50px; width: parent.width - 56px; height: 60px; text: "Not running"; color: Theme.mut; font-family: Theme.disp; font-size: 32px; font-weight: 800;  vertical-alignment: center; }
            Rectangle { x: 28px; y: 118px; width: parent.width - 56px; height: 1px; background: Theme.ln2; }
            Rectangle { x: 28px; y: 166px; width: parent.width - 56px; height: 1px; background: Theme.ln2; }
            Text { x: 28px; y: 118px; width: parent.width - 56px - 96px; height: 48px; text: "Minecraft › Multiplayer › Add Server › paste"; color: tk.has ? Theme.tx : Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center; overflow: elide; }
            if tk.has: Rectangle {
                x: parent.width - 28px - 84px; y: 125px; width: 84px; height: 34px;
                background: cp.pressed ? Theme.press : (cp.has-hover ? Theme.red : Theme.s3);
                animate background { duration: Theme.fast; }
                Text { y: cp.pressed ? 1px : 0px; height: parent.height; text: "COPY"; color: white; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; letter-spacing: 0.7px; horizontal-alignment: center; vertical-alignment: center; }
                cp := TouchArea { mouse-cursor: pointer; clicked => { Backend.copy-text(HostState.addr); Backend.toast("Address copied"); } }
            }
            Text {
                x: 28px; y: 180px; width: parent.width - 56px; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap;
                text: !tk.has ? "Start the server and the address for your friends appears here."
                    : HostState.tun == 4 ? "Through the playit.gg tunnel: friends anywhere can join with this address, from any launcher."
                    : HostState.reach == 2 ? "Checked from the internet: friends anywhere can join with this address, from any launcher."
                    : HostState.reach == 1 || HostState.upnp-state == 1 ? "Checking whether friends outside your network can reach it…"
                    : "Friends on your network only. For everyone else, start the free tunnel below.";
            }
        }

        // ---------- addresses (right column) ----------
        SectionHead { x: 948px; y: 413px; width: 436px; idx: ""; title: "ADDRESSES"; note: "TCP \{HostState.port}"; }
        AddrRow { x: 948px; y: 446px; width: 436px; k: "LAN"; v: HostState.lan == "" ? "No network connection" : HostState.lan; tint: HostState.lan == "" ? Theme.mut : Theme.tx; can-copy: HostState.lan != ""; }
        AddrRow {
            x: 948px; y: 508px; width: 436px; k: "INTERNET";
            v: HostState.pub-addr != "" ? HostState.pub-addr
                : !root.live ? "Checked when the server runs"
                : HostState.reach == 1 || HostState.upnp-state == 1 ? "Looking up your public address…"
                : "No public address";
            tint: HostState.reach == 2 ? Theme.tx : HostState.reach == 3 ? Theme.redtx : Theme.mut;
            note: !root.live ? "" : HostState.reach == 1 ? "CHECKING" : HostState.reach == 2 ? "REACHABLE" : HostState.reach == 3 ? "BLOCKED" : HostState.reach == 4 ? "UNCHECKED" : "";
            note-tint: HostState.reach == 2 ? Theme.ice : HostState.reach == 3 ? Theme.redtx : Theme.mut;
            can-copy: HostState.reach == 2 && HostState.pub-addr != "";
        }
        AddrRow {
            x: 948px; y: 570px; width: 436px; k: "TUNNEL · PLAYIT.GG";
            v: HostState.tun == 4 ? HostState.tun-addr : HostState.tun == 1 ? HostState.tun-msg + "…" : HostState.tun == 2 ? "Waiting for you to link playit.gg"
                : HostState.tun == 3 ? "Linked, no tunnel yet" : HostState.tun == 5 ? "Tunnel stopped" : "Off · free, works on any network";
            tint: HostState.tun == 4 ? Theme.tx : HostState.tun == 5 ? Theme.redtx : Theme.mut;
            note: HostState.tun == 4 ? "ONLINE" : "";
            note-tint: Theme.ice;
            can-copy: HostState.tun == 4;
        }
        hint := Rectangle {
            x: 948px; y: 648px; width: 436px; height: 104px;
            // which action fits: 0 none, 1 start tunnel, 2 open claim link, 3 open playit.gg, 4 stop tunnel, 5 retry tunnel
            property <int> act: !root.live ? 0 : HostState.tun == 2 ? 2 : HostState.tun == 3 ? 3 : HostState.tun == 4 ? 4 : HostState.tun == 5 ? 5
                : HostState.tun == 1 ? 4 : (HostState.reach == 3 || HostState.reach == 4) ? 1 : 0;
            property <bool> bad: root.live && (HostState.tun == 5 || (HostState.tun == 0 && HostState.reach == 3));
            Rectangle { x: 0px; y: 0px; width: 3px; height: 100%; background: hint.bad ? Theme.red2 : (root.live && (HostState.tun == 4 || HostState.reach == 2)) ? Theme.ice : Theme.ln2; }
            Text {
                x: 18px; y: 0px; width: parent.width - 18px; height: hint.act == 0 ? 100px : 58px; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; overflow: elide;
                color: hint.bad ? Theme.redtx : Theme.dim;
                text: !root.live ? "Once the server runs, Nether checks from the internet whether friends can reach it. If your network blocks them, a free playit.gg tunnel takes over."
                    : HostState.tun == 1 ? "Starting the free playit.gg tunnel. It runs only while you host."
                    : HostState.tun == 2 ? "Link this PC to a free playit.gg account in the browser page that opened (a guest account works). The tunnel address appears here after."
                    : HostState.tun == 3 ? "playit.gg is linked but made no tunnel (" + HostState.tun-msg + "). Add a Minecraft Java tunnel to local port " + HostState.port + " there."
                    : HostState.tun == 4 ? "Tunnel online. Share the tunnel address: friends anywhere can join, and it stays the same next time."
                    : HostState.tun == 5 ? "The tunnel stopped: " + HostState.tun-msg
                    : HostState.reach == 1 || HostState.upnp-state == 1 ? "Checking from the internet whether friends can reach your server…"
                    : HostState.reach == 2 ? "Checked from the internet: friends anywhere can join at your public address."
                    : HostState.reach-msg != "" ? HostState.reach-msg
                    : "Friends on your network can join right away.";
            }
            if hint.act == 1: Btn { x: 18px; y: parent.height - 36px; height: 34px; text: "START FREE TUNNEL"; solid: true; clicked => { HostState.tunnel(0); } }
            if hint.act == 2: Btn { x: 18px; y: parent.height - 36px; height: 34px; text: "OPEN LINK PAGE"; solid: true; clicked => { Backend.open-url(HostState.tun-url); } }
            if hint.act == 3: Btn { x: 18px; y: parent.height - 36px; height: 34px; text: "OPEN PLAYIT.GG"; solid: true; clicked => { Backend.open-url(HostState.tun-url); } }
            if hint.act == 4: Btn { x: 18px; y: parent.height - 36px; height: 34px; text: "STOP TUNNEL"; clicked => { HostState.tunnel(1); } }
            if hint.act == 5: Btn { x: 18px; y: parent.height - 36px; height: 34px; text: "TRY AGAIN"; solid: true; clicked => { HostState.tunnel(0); } }
            if root.live && HostState.tun != 4 && HostState.reach >= 2: LinkBtn { x: parent.width - self.width; y: parent.height - 30px; text: "CHECK AGAIN"; clicked => { HostState.recheck(); } }
        }

        // ---------- tabs ----------
        UTabs { x: 56px; y: 404px; width: 860px; items: ["CONSOLE", "PLAYERS", root.addon-word, "SETTINGS", "WORLD"]; item-w: 130px; current <=> HostState.tab; }
        if root.tab == 3: Text { x: 56px; y: 404px; width: 860px; height: 38px; text: "Saved automatically · applies on next start"; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
        if root.tab == 0 && root.live: Text { x: 56px; y: 404px; width: 860px; height: 38px; text: "\{HostState.console.length} lines"; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }

        // CONSOLE
        if root.tab == 0: con := Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px; background: Theme.s1; clip: true;
            property <bool> follow: true;
            property <int> rev: HostState.console-rev;
            changed rev => { if con.follow { fl.content-y = Math.min(0px, fl.height - fl.content-height); } }
            init => { fl.content-y = Math.min(0px, fl.height - fl.content-height); }
            fl := Flickable {
                x: 0px; y: 0px; width: parent.width; height: parent.height - 42px;
                content-height: Math.max(self.height, HostState.console.length * 18px + 24px);
                flicked => { con.follow = self.content-y <= self.height - self.content-height + 6px; }
                for l[i] in HostState.console: Text {
                    x: 18px; y: 12px + i * 18px; width: 860px - 36px; height: 18px;
                    text: l.t; color: l.k == 1 ? Theme.redtx : (l.k == 2 ? Theme.tx : Theme.dim);
                    font-family: Theme.mono; font-size: 12px * Theme.ts; font-weight: l.k == 2 ? 500 : 400; vertical-alignment: center; overflow: elide;
                }
            }
            if HostState.console.length == 0: Empty { height: parent.height - 42px;
                title: root.live ? "WAITING FOR OUTPUT" : "CONSOLE";
                text: root.live ? "The server is starting up." : (HostState.phase == 2 ? "Set the server up, then start it to see its log here." : "Start the server to see its log and send commands."); }
            if !con.follow: Rectangle {
                x: parent.width - self.width - 14px; y: parent.height - 42px - self.height - 12px; width: jl.preferred-width + 40px; height: 28px;
                background: jt.has-hover ? Theme.ice : Theme.s3; border-width: 1px; border-color: Theme.ln2; border-radius: 8px;
                animate background { duration: Theme.fast; }
                Icon { x: 12px; y: 8px; d: Ico.down; tint: jt.has-hover ? Theme.ink : Theme.tx; }
                jl := Text { x: 30px; height: parent.height; text: "LATEST"; color: jt.has-hover ? Theme.ink : Theme.tx; font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 600; letter-spacing: 0.7px; vertical-alignment: center; }
                jt := TouchArea { mouse-cursor: pointer; clicked => { con.follow = true; fl.content-y = Math.min(0px, fl.height - fl.content-height); } }
            }
            Rectangle { x: 0px; y: parent.height - 42px; height: 1px; background: inp.has-focus ? Theme.red2 : Theme.ln; animate background { duration: Theme.mid; } }
            Text { x: 18px; y: parent.height - 41px; height: 41px; text: ">"; color: root.live ? Theme.redtx : Theme.mut; font-family: Theme.mono; font-size: 13px * Theme.ts; font-weight: 700; vertical-alignment: center; }
            if inp.text == "": Text { x: 38px; y: parent.height - 41px; height: 41px; text: root.live ? "Type a command, like say hello or time set day" : "Commands can be sent while the server runs"; color: Theme.mut; font-family: Theme.mono; font-size: 12px * Theme.ts; vertical-alignment: center; }
            Text { x: parent.width - 18px - self.preferred-width; y: parent.height - 41px; height: 41px; text: "ENTER SEND · ↑↓ HISTORY"; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; letter-spacing: 0.7px; vertical-alignment: center; visible: root.live; }
            FocusScope {
                x: 38px; y: parent.height - 41px; width: parent.width - 220px; height: 41px;
                capture-key-pressed(e) => {
                    if e.text == Key.UpArrow { inp.text = HostState.history(-1); inp.set-selection-offsets(999, 999); return accept; }
                    if e.text == Key.DownArrow { inp.text = HostState.history(1); inp.set-selection-offsets(999, 999); return accept; }
                    reject
                }
                inp := TextInput {
                    width: parent.width; height: parent.height; vertical-alignment: center; single-line: true; enabled: root.live;
                    color: Theme.tx; font-family: Theme.mono; font-size: 12px * Theme.ts; selection-background-color: Theme.red.with-alpha(0.502);
                    accepted => { if self.text != "" { HostState.send(self.text); self.text = ""; con.follow = true; } }
                }
            }
        }

        // PLAYERS
        if root.tab == 1: Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px;
            SectionHead { x: 0px; y: 0px; width: 500px; idx: "01"; title: "ONLINE"; note: root.live ? "\{HostState.players.length} / \{HostState.max-players}" : "offline"; }
            Flickable {
                x: 0px; y: 28px; width: 500px; height: 266px; content-height: HostState.players.length * 48px;
                for p[i] in HostState.players: Rectangle {
                    y: i * 48px; width: 500px; height: 48px;
                    background: rh.has-hover ? #ffffff06 : transparent;
                    rh := TouchArea { }
                    Rectangle { x: 0px; width: 3px; background: Theme.red; visible: rh.has-hover; }
                    Text { x: 12px; width: 26px; text: i + 1 < 10 ? "0\{i + 1}" : "\{i + 1}"; color: Theme.mut; font-family: Theme.mono; font-size: 12px * Theme.ts; font-weight: 700; vertical-alignment: center; }
                    nm := Text { x: 44px; text: p.name; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; vertical-alignment: center; }
                    if p.op: Chip { x: nm.x + nm.preferred-width + 10px; y: 13px; text: "OP"; hot: true; }
                    if p.wl: Chip { x: nm.x + nm.preferred-width + (p.op ? 50px : 10px); y: 13px; text: "WHITELISTED"; }
                    kb := Btn { x: parent.width - self.width - 8px; y: 10px; height: 28px; text: "KICK"; danger: true; clicked => { HostState.player(p.name, 0); } }
                    wb := Btn { x: kb.x - self.width - 6px; y: 10px; height: 28px; text: "WHITELIST"; visible: !p.wl; clicked => { if !p.wl { HostState.player(p.name, 3); } } }
                    Btn { x: (p.wl ? kb.x : wb.x) - self.width - 6px; y: 10px; height: 28px; text: p.op ? "DEOP" : "OP"; clicked => { HostState.player(p.name, p.op ? 2 : 1); } }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if HostState.players.length == 0: Empty { x: 0px; y: 28px; width: 500px; height: 220px;
                title: root.live ? "NO ONE ONLINE YET" : "SERVER OFFLINE";
                text: root.live ? "Players show up here as they join. Send them the invite address." : "Start the server to see who's playing."; }

            // whitelist / operators editor
            Seg { x: 532px; y: -7px; items: ["WHITELIST", "OPERATORS"]; item-w: 120px; current <=> root.list; }
            if root.list == 0: Toggle { x: 860px - 42px; y: 0px; on <=> HostState.wl-on; toggled => { HostState.save-settings(); } }
            if root.list == 0: Text { x: 760px; y: 0px; width: 50px; height: 22px; text: HostState.wl-on ? "ON" : "OFF"; color: HostState.wl-on ? Theme.tx : Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; horizontal-alignment: right; vertical-alignment: center; }
            nf := Field { x: 532px; y: 40px; width: 328px - 86px; placeholder: "Minecraft name"; accepted => { if self.text != "" { HostState.list-add(root.list, self.text); self.text = ""; } } }
            Btn { x: 860px - self.width; y: 40px; height: 40px; text: "ADD"; icon: Ico.plus; enabled: nf.text != ""; clicked => { HostState.list-add(root.list, nf.text); nf.text = ""; } }
            Flickable {
                x: 532px; y: 92px; width: 328px; height: 202px; content-height: root.names.length * 40px;
                for n[i] in root.names: Rectangle {
                    y: i * 40px; width: 328px; height: 40px;
                    Text { x: 0px; width: parent.width - 40px; text: n; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 500; vertical-alignment: center; overflow: elide; }
                    IconBtn { x: parent.width - 28px; y: 6px; size: 28px; d: Ico.close; danger: true; tip: "Remove"; clicked => { HostState.list-remove(root.list, n); } }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if root.names.length == 0: Text {
                x: 532px; y: 104px; width: 328px; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap;
                text: root.list == 0 ? (HostState.wl-on ? "The whitelist is on and empty: no one can join yet. Add your friends by name." : "The whitelist is off, so anyone with the address can join. Turn it on to allow only the names you add.")
                    : "Operators can use admin commands like /gamemode and /kick. Add trusted players by name.";
            }
        }

        // ADD-ONS: Paper plugins / Fabric server mods from Modrinth
        if root.tab == 2 && HostState.kind == "vanilla": Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px; background: Theme.s1; clip: true;
            Hatch { width: parent.width; height: parent.height; }
            Empty { height: parent.height - 60px; title: "VANILLA RUNS NO ADD-ONS"; text: "For plugins, set up a Paper server. For mods, set up a Fabric server. Worlds copy across from the World tab."; }
            Btn { x: (parent.width - self.width) / 2; y: parent.height - 84px; height: 36px; text: "NEW SERVER"; icon: Ico.plus; clicked => { HostState.new-server(); } }
        }
        if root.tab == 2 && HostState.kind != "vanilla": Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px;
            SectionHead { x: 0px; y: 0px; width: 300px; idx: "01"; title: "INSTALLED"; note: "\{HostState.addons.length}"; }
            Flickable {
                x: 0px; y: 28px; width: 300px; height: 266px; content-height: HostState.addons.length * 44px;
                for a[i] in HostState.addons: Rectangle {
                    y: i * 44px; width: 300px; height: 44px;
                    Text { x: 0px; y: 6px; width: parent.width - 44px; text: a.name; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                    Text { x: 0px; y: 25px; text: a.meta; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; }
                    IconBtn { x: parent.width - 30px; y: 8px; size: 28px; d: Ico.close; danger: true; tip: "Remove"; clicked => { HostState.addon-remove(a.id); } }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if HostState.addons.length == 0: Text { x: 0px; y: 40px; width: 300px; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap;
                text: HostState.kind == "paper" ? "No plugins yet. Pick some on the right; they go in the plugins folder and load on the next start." : "No mods yet. Mods added here run on the server; players need the same mod too where it says so."; }

            SectionHead { x: 330px; y: 0px; width: 530px; idx: "02"; title: "FROM MODRINTH"; note: HostState.inst-meta; }
            sf := Field { x: 330px; y: 30px; width: 530px - 108px; search: true; placeholder: HostState.kind == "paper" ? "Search plugins" : "Search server mods"; accepted => { HostState.addon-search(self.text); } }
            Btn { x: 860px - self.width; y: 30px; height: 40px; text: "SEARCH"; clicked => { HostState.addon-search(sf.text); } }
            Flickable {
                x: 330px; y: 78px; width: 530px; height: 216px; content-height: HostState.hits.length * 54px;
                for r[i] in HostState.hits: Rectangle {
                    y: i * 54px; width: 530px; height: 54px;
                    background: hh.has-hover ? #ffffff06 : transparent;
                    hh := TouchArea { }
                    ModIcon { x: 0px; y: 8px; src: r.icon; has: r.has-icon; }
                    Text { x: 52px; y: 8px; width: parent.width - 52px - 176px; text: r.name; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                    Text { x: 52px; y: 28px; width: parent.width - 52px - 176px; text: r.sub; color: Theme.dim; font-family: Theme.ui; font-size: 12px * Theme.ts; overflow: elide; }
                    Text { x: parent.width - 172px; width: 60px; text: r.meta; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                    Btn { x: parent.width - self.width - 4px; y: 11px; height: 32px; text: r.busy ? "ADDING…" : "INSTALL"; enabled: !r.busy; clicked => { HostState.addon-install(r.id); } }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if HostState.hits.length == 0: Text { x: 330px; y: 92px; width: 530px; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap;
                text: HostState.hits-loading ? "Searching Modrinth…" : "Nothing found for this version yet. Try another search."; }
        }

        // SETTINGS
        if root.tab == 3: Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px;
            HRow { x: 0px; y: 0px; width: 410px; title: "Port"; sub: "TCP port friends connect to"; reserve: 140px;
                Field { x: parent.width - 110px; y: 8px; width: 110px; text <=> HostState.port; edited => { HostState.save-settings(); } } }
            HRow { x: 0px; y: 56px; width: 410px; title: "Message"; sub: "Shown in the server list"; reserve: 250px;
                Field { x: parent.width - 220px; y: 8px; width: 220px; text <=> HostState.motd; edited => { HostState.save-settings(); } } }
            HRow { x: 0px; y: 112px; width: 410px; title: "Max players"; sub: "How many can be online at once"; reserve: 110px;
                Field { x: parent.width - 80px; y: 8px; width: 80px; text <=> HostState.max-players; edited => { HostState.save-settings(); } } }
            HRow { x: 0px; y: 168px; width: 410px; title: "Memory"; sub: "RAM for the server"; reserve: 240px;
                Slider { x: parent.width - 220px; y: 17px; width: 160px; min: 1; max: 16; value <=> HostState.ram; released => { HostState.save-settings(); } }
                Text { x: parent.width - 50px; width: 50px; text: "\{HostState.ram} GB"; color: Theme.tx; font-family: Theme.mono; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; } }
            HRow { x: 0px; y: 224px; width: 410px; title: "Difficulty"; sub: "Mob damage and hunger"; reserve: 200px;
                Dropdown { x: parent.width - 170px; y: 8px; width: 170px; items: ["Peaceful", "Easy", "Normal", "Hard"]; current <=> HostState.difficulty; changed => { HostState.save-settings(); } } }

            HRow { x: 450px; y: 0px; width: 410px; title: "Game mode"; sub: "For players joining the first time"; reserve: 200px;
                Dropdown { x: parent.width - 170px; y: 8px; width: 170px; items: ["Survival", "Creative", "Adventure", "Spectator"]; current <=> HostState.gamemode; changed => { HostState.save-settings(); } } }
            HRow { x: 450px; y: 56px; width: 410px; title: "PvP"; sub: "Players can hurt each other";
                Toggle { x: parent.width - 42px; y: 17px; on <=> HostState.pvp; toggled => { HostState.save-settings(); } } }
            HRow { x: 450px; y: 112px; width: 410px; title: "Online mode"; sub: "Only real Minecraft accounts can join";
                Toggle { x: parent.width - 42px; y: 17px; on <=> HostState.online; toggled => { HostState.save-settings(); } } }
            HRow { x: 450px; y: 168px; width: 410px; title: "Whitelist"; sub: "Only listed players can join";
                Toggle { x: parent.width - 42px; y: 17px; on <=> HostState.wl-on; toggled => { HostState.save-settings(); } } }
            HRow { x: 450px; y: 224px; width: 410px; title: "Open port automatically"; sub: "Ask the router to forward it (UPnP)";
                Toggle { x: parent.width - 42px; y: 17px; on <=> HostState.upnp; toggled => { HostState.save-settings(); } } }
        }

        // WORLD
        if root.tab == 4: Rectangle {
            x: 56px; y: 458px; width: 860px; height: 294px;
            SectionHead { x: 0px; y: 0px; width: 410px; idx: "01"; title: "USE A SINGLEPLAYER WORLD"; }
            Text { x: 0px; y: 28px; width: 410px; text: "Copies a world from any instance into the server. The original is not changed; the current server world is set aside, never deleted."; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
            Flickable {
                x: 0px; y: 78px; width: 410px; height: 216px; content-height: HostState.saves.length * 44px;
                for s[i] in HostState.saves: Rectangle {
                    y: i * 44px; width: 410px; height: 44px;
                    Text { x: 0px; y: 5px; width: parent.width - 120px; text: s.name; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                    Text { x: 0px; y: 24px; width: parent.width - 120px; text: s.sub; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
                    Btn { x: parent.width - self.width; y: 8px; height: 28px; text: "COPY IN"; icon: Ico.copy; enabled: !root.live && !HostState.busy; clicked => { HostState.import-save(i); } }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if HostState.saves.length == 0: Text { x: 0px; y: 90px; width: 410px; text: "Your instances have no singleplayer worlds yet. The server makes a fresh world on its first start."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
            if root.live && HostState.saves.length > 0: Text { x: 0px; y: 78px + Math.min(HostState.saves.length, 4) * 44px + 12px; width: 410px; text: "Stop the server to swap its world."; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; }

            SectionHead { x: 450px; y: 0px; width: 410px; idx: "02"; title: "BACKUPS"; note: "\{HostState.backups.length}"; }
            Btn { x: 450px; y: 30px; height: 34px; text: "BACK UP NOW"; icon: Ico.download; enabled: HostState.phase == 3 && !HostState.busy && root.st != 1 && root.st != 3; clicked => { HostState.backup(); } }
            LinkBtn { x: 860px - self.width; y: 33px; text: "OPEN FOLDER"; clicked => { HostState.open-backups(); } }
            Flickable {
                x: 450px; y: 78px; width: 410px; height: 216px; content-height: HostState.backups.length * 44px;
                for b[i] in HostState.backups: Rectangle {
                    y: i * 44px; width: 410px; height: 44px;
                    Text { x: 0px; y: 6px; width: parent.width - 90px; text: b.date; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                    Text { x: 0px; y: 25px; width: parent.width - 90px; text: b.name; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
                    Text { x: parent.width - 90px; width: 90px; text: b.size; color: Theme.dim; font-family: Theme.mono; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
                }
            }
            if HostState.backups.length == 0: Text { x: 450px; y: 90px; width: 410px; text: "No backups yet. A backup is a zip of the server world, saved in the server folder."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
        }
    }

    // ---------- EULA: only the user's click on I AGREE accepts it ----------
    if HostState.eula-open: Scrim {
        dismiss => { HostState.eula-open = false; }
        Rectangle {
            x: (parent.width - 560px) / 2; y: 200px; width: 560px; height: 290px;
            background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: 8px;
            TouchArea { }
            Eyebrow { x: 28px; y: 28px; text: "BEFORE THE FIRST START"; }
            Text { x: 28px; y: 48px; text: "MINECRAFT EULA"; color: Theme.tx; font-family: Theme.disp; font-size: 32px; font-weight: 800;  }
            Text { x: 28px; y: 98px; width: parent.width - 56px; text: "Running a Minecraft server means agreeing to Mojang's End User License Agreement. Please read it. The server only starts after you agree."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
            LinkBtn { x: 28px; y: 156px; text: "READ THE EULA"; clicked => { Backend.open-url("https://aka.ms/MinecraftEULA"); } }
            Text { x: 28px; y: 186px; text: "aka.ms/MinecraftEULA"; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; }
            nb := Btn { x: parent.width - 28px - self.width - ab.width - 10px; y: parent.height - 64px; text: "NOT NOW"; clicked => { HostState.eula-open = false; } }
            ab := Btn { x: parent.width - 28px - self.width; y: parent.height - 64px; text: "I AGREE"; solid: true; icon: Ico.check; clicked => { HostState.accept-eula(); } }
        }
    }

    // ---------- delete server ----------
    if root.confirm-del: Scrim {
        dismiss => { root.confirm-del = false; }
        Rectangle {
            x: (parent.width - 500px) / 2; y: 230px; width: 500px; height: 232px;
            background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: 8px;
            TouchArea { }
            Eyebrow { x: 28px; y: 28px; text: "DELETE SERVER"; color: Theme.redtx; }
            Text { x: 28px; y: 48px; width: parent.width - 56px; text: HostState.inst-name; color: Theme.tx; font-family: Theme.disp; font-size: 32px; font-weight: 800;  overflow: elide; }
            Text { x: 28px; y: 98px; width: parent.width - 56px; text: "Its world, backups, plugins and settings are removed from this PC. This can't be undone."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
            Btn { x: parent.width - 28px - self.width - db.width - 10px; y: parent.height - 64px; text: "KEEP IT"; clicked => { root.confirm-del = false; } }
            db := Btn { x: parent.width - 28px - self.width; y: parent.height - 64px; text: "DELETE FOREVER"; danger: true; solid: true; icon: Ico.trash;
                clicked => { root.confirm-del = false; HostState.delete-server(); } }
        }
    }

    // ---------- new server: setup walkthrough ----------
    if HostState.wiz-open: Scrim {
        dismiss => { HostState.wiz-open = false; }
        wz := Rectangle {
            // kind: 0 Vanilla, 1 Fabric, 2 Paper
            property <int> kind: 2;
            property <int> vi: 0;
            // -1 fresh world, else index into HostState.saves
            property <int> world: -1;
            property <bool> wl: false;
            property <bool> online: true;
            property <bool> upnp: true;
            property <int> ram: 3;
            property <bool> agree: false;
            // 0 type, 1 version, 2 world, 3 players, 4 finish
            property <int> step: 0;
            property <[string]> steps: ["TYPE", "VERSION", "WORLD", "PLAYERS", "FINISH"];
            property <[string]> vers: wz.kind == 0 ? Backend.mc-versions : wz.kind == 1 ? Backend.fabric-versions : HostState.paper-versions;
            property <string> ver: wz.vers.length > 0 ? wz.vers[Math.min(wz.vi, wz.vers.length - 1)] : "";
            property <string> kind-name: wz.kind == 0 ? "Vanilla" : wz.kind == 1 ? "Fabric" : "Paper";
            property <bool> can-create: wz.agree && HostState.wiz-name != "" && wz.ver != "";
            x: (parent.width - 1040px) / 2; y: 30px; width: 1040px; height: 728px;
            background: Theme.s1; border-width: 1px; border-color: Theme.ln2; border-radius: 8px;
            TouchArea { }
            Heading { x: 30px; y: 44px; text: "NEW SERVER"; font-size: 48px; }
            IconBtn { x: parent.width - 32px - 34px; y: 28px; size: 34px; d: Ico.close; tip: "Close"; clicked => { HostState.wiz-open = false; } }

            // step rail
            HorizontalLayout {
                x: 32px; y: 112px; width: parent.width - 64px; height: 30px; spacing: 6px;
                for s[i] in wz.steps: Rectangle {
                    background: wz.step == i ? Theme.s3 : transparent;
                    Rectangle { y: parent.height - 2px; height: 2px; background: i < wz.step ? Theme.ice : (wz.step == i ? Theme.red2 : Theme.ln2); }
                    Text { x: 10px; height: parent.height; text: "0\{i + 1}"; color: wz.step == i ? Theme.red2 : Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; font-weight: 700; vertical-alignment: center; }
                    Text { x: 34px; height: parent.height; text: s; color: wz.step == i ? Theme.tx : (i < wz.step ? Theme.dim : Theme.mut); font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; }
                    TouchArea { mouse-cursor: i < wz.step ? pointer : default; clicked => { if i < wz.step { wz.step = i; } } }
                }
            }

            // ---- 01 type ----
            if wz.step == 0: Rectangle {
                x: 32px; y: 166px; width: parent.width - 64px; height: 450px;
                for k[i] in [{t: "PAPER", d: "Fast, and runs Bukkit, Spigot and Paper plugins from Modrinth. Players join with plain Minecraft.", c: "RECOMMENDED"},
                             {t: "FABRIC", d: "Runs Fabric server mods like Lithium. Some mods need players to install them too.", c: ""},
                             {t: "VANILLA", d: "Mojang's own server, nothing added. The closest match to singleplayer.", c: ""}]: Choice {
                    x: 0px; y: i * 150px; width: parent.width; height: 138px;
                    title: k.t; text: k.d; chip: k.c;
                    property <int> me: i == 0 ? 2 : i == 1 ? 1 : 0;
                    on: wz.kind == self.me;
                    clicked => { wz.kind = self.me; wz.vi = 0; }
                    double-clicked => { wz.kind = self.me; wz.vi = 0; wz.step = 1; }
                }
            }

            // ---- 02 version ----
            if wz.step == 1: Rectangle {
                x: 32px; y: 166px; width: parent.width - 64px; height: 450px;
                Text { x: 0px; y: 0px; text: "Minecraft versions " + wz.kind-name + " can host. Newest first. Players need the same version."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; }
                if wz.vers.length == 0: Text { x: 0px; y: 40px; text: "Loading versions…"; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; }
                Flickable {
                    y: 32px; height: parent.height - 32px; content-height: Math.ceil(wz.vers.length / 6) * 52px;
                    for v[i] in wz.vers: Rectangle {
                        x: mod(i, 6) * (parent.width / 6); y: floor(i / 6) * 52px; width: parent.width / 6 - 8px; height: 44px;
                        background: wz.vi == i ? Theme.ice : (vt.has-hover ? Theme.s2 : Theme.s1);
                        border-width: 1px; border-color: wz.vi == i ? Theme.ice : Theme.ln; border-radius: 8px;
                        Text { text: v; color: wz.vi == i ? Theme.ink : Theme.tx; font-family: Theme.mono; font-size: 14px * Theme.ts; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        if i == 0: Rectangle { x: parent.width - 8px; y: 0px; width: 8px; height: 8px; background: Theme.red2; }
                        vt := TouchArea { mouse-cursor: pointer; clicked => { wz.vi = i; } double-clicked => { wz.vi = i; wz.step = 2; } }
                    }
                }
            }

            // ---- 03 world ----
            if wz.step == 2: Rectangle {
                x: 32px; y: 166px; width: parent.width - 64px; height: 450px;
                Choice { x: 0px; y: 0px; width: parent.width; height: 120px; title: "FRESH WORLD"; chip: wz.world == -1 ? "" : "";
                    text: "The server generates a new world on its first start."; on: wz.world == -1; clicked => { wz.world = -1; } double-clicked => { wz.world = -1; wz.step = 3; } }
                Eyebrow { x: 0px; y: 142px; text: "OR COPY A SINGLEPLAYER WORLD"; }
                Text { x: 0px; y: 162px; width: parent.width; text: "The original stays as it is. Use a world from the same Minecraft version (" + wz.ver + ") or older."; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; }
                Flickable {
                    y: 192px; height: parent.height - 192px; content-height: Math.ceil(HostState.saves.length / 3) * 66px;
                    for s[i] in HostState.saves: Rectangle {
                        x: mod(i, 3) * (parent.width / 3); y: floor(i / 3) * 66px; width: parent.width / 3 - 8px; height: 58px;
                        background: wz.world == i ? Theme.red.with-alpha(0.094) : (st2.has-hover ? Theme.s2 : Theme.s1);
                        border-width: 1px; border-color: wz.world == i ? Theme.red2 : Theme.ln; border-radius: 8px;
                        Text { x: 16px; y: 10px; width: parent.width - 32px; text: s.name; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; overflow: elide; }
                        Text { x: 16px; y: 31px; width: parent.width - 32px; text: s.sub; color: Theme.mut; font-family: Theme.mono; font-size: 11px * Theme.ts; overflow: elide; }
                        st2 := TouchArea { mouse-cursor: pointer; clicked => { wz.world = i; } double-clicked => { wz.world = i; wz.step = 3; } }
                    }
                }
                if HostState.saves.length == 0: Text { x: 0px; y: 200px; text: "Your instances have no singleplayer worlds yet."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; }
            }

            // ---- 04 players ----
            if wz.step == 3: Rectangle {
                x: 32px; y: 166px; width: parent.width - 64px; height: 450px;
                Text { x: 0px; y: 0px; width: parent.width; text: "Who can join. All of this can be changed later on the server's Settings and Players tabs."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; }
                HRow { x: 0px; y: 40px; width: parent.width; title: "Whitelist"; sub: "Only players you add by name can join. Best for a private server with friends.";
                    Toggle { x: parent.width - 42px; y: 17px; on <=> wz.wl; } }
                HRow { x: 0px; y: 96px; width: parent.width; title: "Online mode"; sub: "Players must own Minecraft; their accounts are checked with Mojang. Keep this on.";
                    Toggle { x: parent.width - 42px; y: 17px; on <=> wz.online; } }
                HRow { x: 0px; y: 152px; width: parent.width; title: "Open port automatically"; sub: "Asks your router (UPnP) to let friends outside your network in while the server runs.";
                    Toggle { x: parent.width - 42px; y: 17px; on <=> wz.upnp; } }
                if !wz.online: Text { x: 0px; y: 228px; width: parent.width; text: "With online mode off anyone can join under any name, including yours. Use it only on your own network."; color: Theme.redtx; font-family: Theme.ui; font-size: 13px * Theme.ts; wrap: word-wrap; }
            }

            // ---- 05 finish ----
            if wz.step == 4: Rectangle {
                x: 32px; y: 166px; width: parent.width - 64px; height: 450px;
                Eyebrow { x: 0px; y: 0px; text: "NAME"; }
                Field { x: 0px; y: 22px; width: 470px; text <=> HostState.wiz-name; placeholder: "My Server"; }
                HRow { x: 0px; y: 86px; width: 470px; title: "Port"; sub: "Free ports are picked for you"; reserve: 140px;
                    Field { x: parent.width - 110px; y: 8px; width: 110px; text <=> HostState.wiz-port; } }
                HRow { x: 0px; y: 142px; width: 470px; title: "Memory"; sub: "RAM for the server"; reserve: 240px;
                    Slider { x: parent.width - 220px; y: 17px; width: 160px; min: 1; max: 16; value <=> wz.ram; }
                    Text { x: parent.width - 50px; width: 50px; text: "\{wz.ram} GB"; color: Theme.tx; font-family: Theme.mono; font-size: 12px * Theme.ts; horizontal-alignment: right; vertical-alignment: center; } }

                // summary plate
                Rectangle {
                    x: 506px; y: 0px; width: parent.width - 506px; height: 214px; background: Theme.s1; clip: true;
                    Hatch { width: parent.width; height: parent.height; }
                    Ticks { width: parent.width; height: parent.height; }
                    Text { x: 24px; y: 20px; width: parent.width - 48px; text: HostState.wiz-name == "" ? "MY SERVER" : HostState.wiz-name.to-uppercase(); color: Theme.tx; font-family: Theme.disp; font-size: 32px; font-weight: 800;  overflow: elide; }
                    for r[i] in [{k: "TYPE", v: wz.kind-name}, {k: "VERSION", v: wz.ver},
                                 {k: "WORLD", v: wz.world < 0 ? "Fresh world" : HostState.saves[wz.world].name + " (copy)"},
                                 {k: "JOIN", v: (wz.wl ? "Whitelist" : "Anyone with the address") + (wz.online ? "" : " · offline mode") + (wz.upnp ? " · UPnP" : "")}]: Rectangle {
                        x: 24px; y: 70px + i * 32px; width: parent.width - 48px; height: 32px;
                        Text { x: 0px; width: 90px; height: parent.height; text: r.k; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; }
                        Text { x: 90px; width: parent.width - 90px; height: parent.height; text: r.v; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; vertical-alignment: center; overflow: elide; }
                    }
                }

                // the user's own agreement to the EULA (required to create)
                Rectangle {
                    x: 0px; y: 250px; width: parent.width; height: 120px; background: Theme.s1;
                    border-width: 1px; border-color: wz.agree ? Theme.ln2 : Theme.ln; border-radius: 8px;
                    Rectangle { x: 0px; y: 0px; width: 3px; height: 100%; background: Theme.ice; }
                    Eyebrow { x: 24px; y: 18px; text: "MINECRAFT EULA"; }
                    Text { x: 24px; y: 40px; width: parent.width - 140px; text: "Running a Minecraft server means agreeing to Mojang's End User License Agreement. Please read it first."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
                    LinkBtn { x: 24px; y: 82px; text: "READ THE EULA"; clicked => { Backend.open-url("https://aka.ms/MinecraftEULA"); } }
                    Text { x: parent.width - 200px; y: 0px; width: 130px; height: parent.height; text: wz.agree ? "I AGREE" : "I AGREE?"; color: wz.agree ? Theme.tx : Theme.mut; font-family: Theme.ui; font-size: 14px * Theme.ts; font-weight: 600; letter-spacing: 0.8px; horizontal-alignment: right; vertical-alignment: center; }
                    Toggle { x: parent.width - 66px; y: (parent.height - 22px) / 2; on <=> wz.agree; }
                }
                Text { x: 0px; y: 392px; width: parent.width; text: "CREATE SERVER downloads the " + wz.kind-name + " " + wz.ver + " server" + (wz.world >= 0 ? " and copies the world" : "") + ". You start it from the Host page."; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; }
            }

            // footer
            Rectangle { x: 0px; y: parent.height - 76px; width: parent.width; height: 1px; background: Theme.ln; }
            Btn { x: parent.width - 32px - 200px - 12px - self.width; y: parent.height - 58px; height: 40px; text: wz.step == 0 ? "CANCEL" : "BACK";
                clicked => { if wz.step == 0 { HostState.wiz-open = false; } else { wz.step -= 1; } } }
            if wz.step < 4: Btn { x: parent.width - 32px - self.width; y: parent.height - 58px; height: 40px; width: 200px; text: "NEXT"; solid: true; enabled: wz.step != 1 || wz.ver != "";
                clicked => { wz.step += 1; } }
            if wz.step == 4: Btn { x: parent.width - 32px - self.width; y: parent.height - 58px; height: 40px; width: 200px; text: "CREATE SERVER"; solid: true; enabled: wz.can-create;
                clicked => { HostState.create(HostState.wiz-name, wz.kind, wz.ver, wz.ram, HostState.wiz-port, wz.world, wz.wl, wz.online, wz.upnp); } }
        }
    }
}
