import { Theme } from "theme.slint";
import { Backend, SkinLib, Cape, CosCard } from "structs.slint";
import { Eyebrow, Heading, Btn, Seg, Chip, IconBtn, Ico, Icon, SpinArea, GroundShadow, Hatch, Ticks, Slash, SectionHead, Field, PlayButton, LinkBtn, Scrim } from "components.slint";
import { Community, CommBar, CommGrid, UploadDialog, ReportDialog, DeleteUploadDialog } from "community.slint";

// one cape card (account or Nether): outside face on a hatch plate, name, "In use"
component CapeCard inherits Rectangle {
    in property <Cape> cape;
    in property <bool> none;
    // worn = picked in the editor; applied = what the account wears now
    in property <bool> worn;
    in property <bool> applied: true;
    in property <bool> busy;
    callback clicked();
    width: 220px; height: 186px;
    border-radius: 8px;
    background: ct.has-hover ? Theme.s2 : Theme.s1;
    opacity: root.busy && !root.worn ? 0.6 : 1;
    animate background { duration: Theme.fast; }
    Rectangle {
        x: 6px; y: 6px; width: parent.width - 12px; height: 124px; background: Theme.bg; border-radius: 6px; clip: true;
        Hatch { width: parent.width; height: parent.height; }
        if !root.none: Image { y: 12px; height: parent.height - 24px; width: parent.width; source: root.cape.img; image-fit: contain; image-rendering: pixelated; }
        if root.none: Text { text: "NONE"; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 600; letter-spacing: 0.9px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 14px; y: 136px; width: parent.width - 28px; height: 28px; text: root.cape.name; color: Theme.tx; font-family: Theme.disp; font-size: 16px; font-weight: 700; vertical-alignment: center; overflow: elide; }
    if root.worn: Icon { x: 14px; y: 168px; d: Ico.check; tint: Theme.redtx; }
    if root.worn: Text { x: 32px; y: 162px; width: 120px; height: 22px; text: root.applied ? "Equipped" : "Selected"; color: Theme.redtx; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; vertical-alignment: center; }
    if !root.worn && ct.has-hover && !root.none: Text { x: 14px; y: 162px; width: 120px; height: 22px; text: "Select"; color: Theme.tx; font-family: Theme.ui; font-size: 12px * Theme.ts; font-weight: 600; vertical-alignment: center; }
    Rectangle { border-radius: 8px; border-width: root.worn ? 2px : 1px; border-color: root.worn ? Theme.red2 : Theme.ln; }
    ct := TouchArea { mouse-cursor: pointer; clicked => { if !root.busy { root.clicked(); } } }
}

// one cosmetic card: the player wearing it, name, description, Equipped / Selected
component CosView inherits Rectangle {
    in property <CosCard> item;
    in property <string> kind-label;
    in property <bool> none;
    in property <bool> worn;
    in property <bool> applied: true;
    in property <bool> busy;
    callback clicked();
    callback hovered(bool);
    width: 220px; height: 276px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.s2 : Theme.s1;
    opacity: root.busy && !root.worn ? 0.6 : 1;
    animate background { duration: Theme.fast; }
    Rectangle {
        x: 6px; y: 6px; width: parent.width - 12px; height: 196px; background: Theme.bg; border-radius: 6px; clip: true;
        Hatch { width: parent.width; height: parent.height; }
        if !root.none: Image {
            y: ta.has-hover ? 0px : 4px; height: parent.height - 4px; width: parent.width; source: root.item.img; image-fit: contain;
            animate y { duration: Theme.mid; easing: ease-out; }
        }
        if root.none: Rectangle {
            Rectangle { x: (parent.width - 56px) / 2; y: (parent.height - 56px) / 2; width: 56px; height: 56px; border-radius: 28px; border-width: 1px; border-color: Theme.ln2;
                Icon { x: 20px; y: 20px; d: Ico.close; tint: Theme.mut; } }
        }
        // state pill: equipped / wear / take off
        if root.worn || ta.has-hover: Rectangle {
            x: parent.width - self.width - 8px; y: 8px; height: 22px; width: pl.preferred-width + 18px; border-radius: 11px;
            background: root.worn ? Theme.red : Theme.s3;
            pl := Text { text: root.worn ? (root.none ? "NOTHING" : root.applied ? "EQUIPPED" : "SELECTED") : (root.none ? "TAKE OFF" : "SELECT"); color: root.worn ? #ffffff : Theme.tx;
                font-family: Theme.ui; font-size: 11px * Theme.ts; font-weight: 700; letter-spacing: 0.6px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    Text { x: 14px; y: 210px; width: parent.width - 28px; height: 26px; text: root.none ? "None" : root.item.name; color: Theme.tx; font-family: Theme.disp; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; }
    if !root.none: Text { x: 14px; y: 240px; width: parent.width - 28px; height: 20px; text: root.item.desc != "" ? root.item.desc : root.kind-label; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; vertical-alignment: center; overflow: elide; }
    if root.none: Text { x: 14px; y: 240px; height: 20px; text: "Take this slot off"; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; vertical-alignment: center; }
    Rectangle { border-radius: 8px; border-width: root.worn ? 2px : 1px; border-color: root.worn ? Theme.red2 : (ta.has-hover ? Theme.ln2 : Theme.ln); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if !root.busy { root.clicked(); } }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}

// a grid of one cosmetic slot: None first, then every card of that type
component CosGrid inherits Flickable {
    in property <[CosCard]> items;
    in property <int> slot;
    in property <string> title;
    in property <string> kind-label;
    property <string> worn: Backend.cos-sel[root.slot];
    property <string> applied: Backend.cos-worn[root.slot];
    content-height: 36px + Math.ceil((root.items.length + 1) / 4) * 288px + 100px;
    init => { Backend.load-cos(); }
    SectionHead { x: 0px; y: 0px; width: 916px; title: root.title; note: "seen by every Nether player · pick, then APPLY"; }
    if Backend.cos-state == 2: Rectangle {
        y: 36px; height: parent.content-height - self.y;
        CosView {
            x: 0px; y: 0px; none: true; worn: root.worn == ""; applied: root.applied == ""; busy: Backend.look-busy; kind-label: root.kind-label;
            clicked => { if root.worn != "" { Backend.wear-cos(root.slot, ""); } }
        }
        for c[i] in root.items: CosView {
            x: mod(i + 1, 4) * 232px; y: floor((i + 1) / 4) * 288px;
            item: c; worn: root.worn == c.id; applied: root.applied == c.id; busy: Backend.look-busy; kind-label: root.kind-label;
            clicked => { Backend.wear-cos(root.slot, c.id); }
            hovered(on) => { Backend.hover-cos(on ? c.id : ""); }
        }
    }
    if Backend.cos-state != 2: Rectangle {
        y: 36px; width: 916px; height: 110px; background: Theme.s1; border-width: 1px; border-color: Theme.ln2;
        Hatch { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; }
        Text { x: 28px; width: parent.width - 56px; vertical-alignment: center; color: Theme.dim; font-family: Theme.ui; font-size: 15px * Theme.ts;
            text: Backend.cos-state == 3 ? "The Nether cosmetics aren't reachable right now. Check your connection and open this page again." : "Loading Nether cosmetics…"; }
    }
}

export component WardrobeScreen inherits Rectangle {
    in-out property <int> page: 0;
    // dialogs: tile being renamed / deleted (-1 = closed)
    in-out property <int> ren-idx: -1;
    in-out property <string> ren-text;
    in-out property <int> del-idx: -1;
    property <int> sel: SkinLib.sel;
    property <bool> picked: root.page == 0 && root.sel >= 0 && root.sel < SkinLib.skins.length;
    property <bool> signed: Backend.acct-state == 2;
    // the worn cosmetic of the page shown (preview footer)
    property <[CosCard]> page-items: root.page >= 2 ? Backend.cos-items[root.page - 2] : [];
    property <string> page-worn: root.page >= 2 ? Backend.cos-sel[root.page - 2] : "";
    property <string> worn-name: root.page-worn == "" ? "Nothing worn" : root.find-name(root.page-items, root.page-worn);
    pure function find-name(list: [CosCard], id: string) -> string {
        // Slint has no lookup: the footer scans the (short) list
        if list.length > 0 && list[0].id == id { return list[0].name; }
        if list.length > 1 && list[1].id == id { return list[1].name; }
        if list.length > 2 && list[2].id == id { return list[2].name; }
        if list.length > 3 && list[3].id == id { return list[3].name; }
        if list.length > 4 && list[4].id == id { return list[4].name; }
        if list.length > 5 && list[5].id == id { return list[5].name; }
        if list.length > 6 && list[6].id == id { return list[6].name; }
        if list.length > 7 && list[7].id == id { return list[7].name; }
        return "Worn";
    }
    init => { SkinLib.refresh(); }

    Heading { x: 56px; y: 28px; text: "WARDROBE"; font-size: 32px; }
    Seg { x: 1384px - self.width; y: 32px; items: ["SKINS", "CAPES", "HATS", "HEADBANDS", "MASKS", "BACK", "WINGS", "AURAS", "PETS"]; item-w: 92px; current <=> root.page;
        changed(i) => { Backend.hover-cos(""); } }

    // preview plate
    Rectangle {
        x: 56px; y: 100px; width: 380px; height: 660px; background: Theme.s1; border-radius: 8px; border-width: 1px; border-color: Theme.ln; clip: true;
        if Backend.skin-ready: GroundShadow { x: (parent.width - self.width) / 2; y: 488px; }
        // 3:2 frame at the old 356-wide 600:780 box height (same player size); the plate clips the sides
        if Backend.skin-ready: Image { height: 463px; width: self.height * 1.5; x: (parent.width - self.width) / 2; y: 70px; source: Backend.skin-frame; image-fit: contain; }
        SpinArea { height: parent.height - 70px; }
        if !Backend.skin-ready: Text { text: "Loading skin…"; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; horizontal-alignment: center; vertical-alignment: center; }
        nm := Text { x: 20px; y: 16px; width: Math.min(self.preferred-width, 250px); height: 32px; overflow: elide;
            text: root.picked ? SkinLib.skins[root.sel].name : (root.signed ? Backend.acct-name : "Player");
            color: Theme.tx; font-family: Theme.disp; font-size: 24px; font-weight: 700; vertical-alignment: center; }
        if root.picked: Chip { x: parent.width - self.width - 16px; y: 21px; text: "Preview"; }
        if root.page >= 1: Btn { x: parent.width - self.width - 14px; y: 14px; height: 36px; icon: Ico.refresh;
            text: Backend.look-refreshing ? "CHECKING…" : "REFRESH"; enabled: !Backend.look-refreshing;
            clicked => { Backend.refresh-look(); if Community.source == 1 { Community.load(root.page); } } }
        // signed out: wearing needs the account
        if root.picked && !root.signed: Rectangle {
            x: 0px; y: parent.height - 62px - 44px; width: parent.width; height: 44px; background: Theme.s1;
            Rectangle { y: 0px; height: 1px; background: Theme.ln; }
            Text { x: 16px; height: parent.height; text: "Sign in to wear skins on your account"; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center; }
            LinkBtn { x: parent.width - self.width - 10px; y: 8px; text: "SIGN IN"; clicked => { Backend.acct-open = true; } }
        }
        Rectangle { x: 0px; y: parent.height - 62px; width: parent.width; height: 62px; background: Theme.s1;
            Rectangle { y: 0px; height: 1px; background: Theme.ln; }
            Seg { x: 14px; y: 14px; items: ["CLASSIC", "SLIM"]; item-w: 84px; current: Backend.skin-slim ? 1 : 0;
                changed(i) => { Backend.skin-slim = i == 1; if root.picked { SkinLib.set-slim(root.sel, i == 1); } } }
            if !root.picked: Text { x: 200px; width: parent.width - 214px; horizontal-alignment: right; vertical-alignment: center; text: root.page == 0 ? (root.signed ? "Account skin" : "Default (Steve)") : root.page == 1 ? (Backend.ncape-sel != "" ? "Nether cape" : Backend.capes[Backend.cape-sel].name) : root.worn-name; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; overflow: elide; }
            if root.picked: PlayButton {
                x: parent.width - 14px - 150px - 4px; y: 13px; width: 150px; height: 36px; text-size: 16px; arrow: false;
                property <bool> worn: SkinLib.worn-id == SkinLib.skins[root.sel].id;
                label: SkinLib.wearing ? "WEARING…" : (self.worn ? "WORN" : "WEAR");
                enabled: root.signed && !SkinLib.wearing && !self.worn;
                clicked => { SkinLib.wear(root.sel); }
            }
        }
    }

    // skins
    if root.page == 0: Rectangle {
        SectionHead { x: 468px; y: 100px; width: 916px; title: "ADD A SKIN"; }
        Btn { x: 468px; y: 132px; height: 40px; text: "UPLOAD FILE"; icon: Ico.export; enabled: !SkinLib.busy; clicked => { SkinLib.add-file(); } }
        Text { x: 688px; y: 132px; height: 40px; text: "or"; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center; }
        imp := Field { x: 716px; y: 132px; width: 500px; placeholder: "Minecraft username or https:// skin link"; accepted => { if self.text != "" && !SkinLib.busy { SkinLib.import(self.text); self.text = ""; } } }
        Btn { x: 1384px - self.width; y: 132px; height: 40px; text: SkinLib.busy ? "WORKING…" : "IMPORT"; enabled: imp.text != "" && !SkinLib.busy; clicked => { SkinLib.import(imp.text); imp.text = ""; } }
        Text { x: 716px; y: 178px; text: "A name like Notch copies that player's current skin. Links must point straight at a 64×64 PNG."; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; }

        SectionHead { x: 468px; y: 208px; width: 916px; title: "LIBRARY"; note: SkinLib.skins.length == 1 ? "1 skin" : "\{SkinLib.skins.length} skins"; }
        Flickable {
            x: 468px; y: 240px; width: 916px; height: parent.height - 240px; content-height: Math.ceil((SkinLib.skins.length + 1) / 4) * 252px + 100px;
            for s[i] in SkinLib.skins: tl := Rectangle {
                x: mod(i, 4) * 232px; y: floor(i / 4) * 252px; width: 220px; height: 240px;
                property <bool> on: root.sel == i;
                property <bool> hot: ta.has-hover || b1.hovered || b2.hovered || b3.hovered;
                border-radius: 8px;
                background: self.hot ? Theme.s2 : Theme.s1;
                animate background { duration: Theme.fast; }
                Rectangle { x: 6px; y: 6px; width: parent.width - 12px; height: 162px; clip: true; background: Theme.bg; border-radius: 6px;
                    Hatch { width: parent.width; height: parent.height; }
                    if s.has-img: Image { x: 0px; y: 10px; width: parent.width; height: parent.height - 16px; source: s.img; image-fit: contain; }
                    if !s.has-img: Text { text: "RENDERING"; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; font-weight: 600; letter-spacing: 0.9px; horizontal-alignment: center; vertical-alignment: center; }
                    Chip { x: 10px; y: 10px; text: s.slim ? "SLIM" : "CLASSIC"; }
                }
                ta := TouchArea { mouse-cursor: pointer; clicked => { SkinLib.select(i); } }
                Text { x: 14px; y: 172px; width: parent.width - 28px; height: 28px; text: s.name; color: Theme.tx; font-family: Theme.disp; font-size: 16px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                Rectangle {
                    x: 14px; y: 204px; width: parent.width - 24px; height: 28px;
                    if SkinLib.worn-id == s.id: Icon { x: 0px; y: 8px; d: Ico.check; tint: Theme.redtx; }
                    Text { x: SkinLib.worn-id == s.id ? 18px : 0px; width: parent.width - (tl.hot || tl.on ? 100px : 0px) - (SkinLib.worn-id == s.id ? 18px : 0px); height: parent.height; text: SkinLib.worn-id == s.id ? "Equipped" : (tl.on ? "Previewing" : s.src); color: tl.on || SkinLib.worn-id == s.id ? Theme.redtx : Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; vertical-alignment: center; overflow: elide; }
                    Rectangle {
                        x: parent.width - 96px; width: 96px;
                        opacity: tl.hot || tl.on ? 1 : 0; animate opacity { duration: Theme.mid; }
                        b1 := IconBtn { x: 0px; size: 28px; d: Ico.edit; tip: "Rename"; clicked => { root.ren-text = s.name; root.ren-idx = i; } }
                        b2 := IconBtn { x: 34px; size: 28px; d: Ico.download; tip: "Save as PNG"; clicked => { SkinLib.export(i); } }
                        b3 := IconBtn { x: 68px; size: 28px; d: Ico.trash; danger: true; tip: "Delete"; clicked => { root.del-idx = i; } }
                    }
                }
                Rectangle { border-radius: 8px; border-width: tl.on || SkinLib.worn-id == s.id ? 2px : 1px; border-color: tl.on || SkinLib.worn-id == s.id ? Theme.red2 : Theme.ln; }
            }
            // add tile after the library: the next step sits where the eye ends up
            if SkinLib.skins.length > 0: Rectangle {
                x: mod(SkinLib.skins.length, 4) * 232px; y: floor(SkinLib.skins.length / 4) * 252px; width: 220px; height: 240px; border-radius: 8px;
                background: adt.has-hover ? Theme.hov : transparent; border-width: 1px; border-color: adt.has-hover ? Theme.mut : Theme.ln2;
                animate background, border-color { duration: Theme.fast; }
                Rectangle { x: (parent.width - 48px) / 2; y: 70px; width: 48px; height: 48px; border-radius: 24px; border-width: 1px; border-color: Theme.ln2;
                    Icon { x: 18px; y: 18px; d: Ico.plus; tint: adt.has-hover ? Theme.tx : Theme.dim; } }
                Text { y: 132px; width: parent.width; text: "Add a skin"; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600; horizontal-alignment: center; }
                Text { x: 20px; y: 156px; width: parent.width - 40px; text: "Upload a 64×64 PNG, or import one by name above"; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts; horizontal-alignment: center; wrap: word-wrap; }
                adt := TouchArea { mouse-cursor: pointer; clicked => { if !SkinLib.busy { SkinLib.add-file(); } } }
            }
        }
        if SkinLib.loaded && SkinLib.skins.length == 0: Rectangle {
            x: 468px; y: 248px; width: 916px; height: 300px; background: Theme.s1; clip: true;
            Hatch { width: parent.width; height: parent.height; }
            Ticks { width: parent.width; height: parent.height; }
            Heading { x: 36px; y: 30px; text: "NO SKINS YET"; font-size: 64px; color: Theme.dim; }
            Text { x: 40px; y: 112px; width: 560px; text: "Your library keeps skins on this PC so you can switch in one click. Add your first one:"; color: Theme.dim; font-family: Theme.ui; font-size: 15px * Theme.ts; wrap: word-wrap; }
            for t[i] in ["Upload a 64×64 PNG from your computer", "Import by username, like Notch or jeb_", "Paste a direct https link to a skin PNG"]: Rectangle {
                x: 40px; y: 168px + i * 36px; width: 560px; height: 36px;
                Text { x: 0px; width: 30px; text: "0\{i + 1}"; color: Theme.red2; font-family: Theme.mono; font-size: 12px * Theme.ts; font-weight: 700; vertical-alignment: center; }
                Text { x: 34px; text: t; color: Theme.tx; font-family: Theme.ui; font-size: 14px * Theme.ts; vertical-alignment: center; }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
            }
        }
    }

    // rename
    if root.ren-idx >= 0: Scrim {
        dismiss => { root.ren-idx = -1; }
        Rectangle {
            x: (parent.width - 500px) / 2; y: 230px; width: 500px; height: 212px;
            background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: 8px;
            TouchArea { }
            Eyebrow { x: 28px; y: 28px; text: "RENAME SKIN"; }
            rf := Field { x: 28px; y: 56px; width: parent.width - 56px; text <=> root.ren-text; init => { self.focus-input(); }
                accepted => { if root.ren-text != "" { SkinLib.rename(root.ren-idx, root.ren-text); root.ren-idx = -1; } } }
            Btn { x: parent.width - 28px - self.width - sb.width - 10px; y: parent.height - 64px; text: "CANCEL"; clicked => { root.ren-idx = -1; } }
            sb := Btn { x: parent.width - 28px - self.width; y: parent.height - 64px; text: "SAVE"; solid: true; icon: Ico.check; enabled: root.ren-text != "";
                clicked => { SkinLib.rename(root.ren-idx, root.ren-text); root.ren-idx = -1; } }
        }
    }
    // delete
    if root.del-idx >= 0 && root.del-idx < SkinLib.skins.length: Scrim {
        dismiss => { root.del-idx = -1; }
        Rectangle {
            x: (parent.width - 500px) / 2; y: 230px; width: 500px; height: 232px;
            background: Theme.s2; border-width: 1px; border-color: Theme.ln2; border-radius: 8px;
            TouchArea { }
            Eyebrow { x: 28px; y: 28px; text: "DELETE SKIN"; color: Theme.redtx; }
            Text { x: 28px; y: 48px; width: parent.width - 56px; text: SkinLib.skins[root.del-idx].name; color: Theme.tx; font-family: Theme.disp; font-size: 32px; font-weight: 800;  overflow: elide; }
            Text { x: 28px; y: 98px; width: parent.width - 56px; text: "It is removed from your library on this PC. The skin your account is wearing does not change."; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts; wrap: word-wrap; }
            kb := Btn { x: parent.width - 28px - self.width - db.width - 10px; y: parent.height - 64px; text: "KEEP IT"; clicked => { root.del-idx = -1; } }
            db := Btn { x: parent.width - 28px - self.width; y: parent.height - 64px; text: "DELETE"; danger: true; solid: true; icon: Ico.trash;
                clicked => { SkinLib.delete(root.del-idx); root.del-idx = -1; } }
        }
    }

    // cosmetics by slot (our directory; seen by Nether players): pages 2.. = slots 0..
    property <[string]> cos-titles: ["HATS", "HEADBANDS", "MASKS", "BACK", "WINGS", "AURAS", "PETS"];
    property <[string]> cos-kinds: ["Hat", "Headband", "Mask", "Back item", "Wings", "Aura", "Pet"];
    // capes + cosmetics: NETHER (signed catalog) or COMMUNITY (player uploads, community.slint)
    if root.page >= 1: CommBar { x: 468px; y: 100px; width: 916px; page: root.page; signed: root.signed; }
    if root.page >= 1 && Community.source == 1: CommGrid { x: 468px; y: 196px; width: 916px; height: parent.height - 196px; page: root.page; signed: root.signed; }
    for s[i] in root.cos-titles: Rectangle {
        x: 468px; y: 150px; width: 916px; height: parent.height - 150px;
        if root.page == i + 2 && Community.source == 0: CosGrid { width: parent.width; height: parent.height; items: Backend.cos-items[i]; slot: i; title: s; kind-label: root.cos-kinds[i]; }
    }

    // capes: account capes (Minecraft) + Nether capes (our directory; seen by Nether players)
    if root.page == 1 && Community.source == 0: Flickable {
        x: 468px; y: 150px; width: 916px; height: parent.height - 150px;
        property <length> acct-h: Math.ceil(Backend.capes.length / 4) * 198px;
        property <length> nth-y: 36px + self.acct-h + 18px;
        content-height: self.nth-y + 36px + (Backend.ncape-state == 2 ? Math.ceil(Backend.ncapes.length / 4) * 198px : 120px) + 100px;
        init => { Backend.load-ncapes(); }
        SectionHead { x: 0px; y: 0px; width: 916px; idx: "01"; title: Backend.acct-state == 2 ? "FROM YOUR MICROSOFT ACCOUNT" : "SIGN IN TO SEE YOUR CAPES"; note: "everyone sees these"; }
        for c[i] in Backend.capes: CapeCard {
            x: mod(i, 4) * 232px; y: 36px + floor(i / 4) * 198px;
            cape: c; none: i == 0; worn: Backend.cape-sel == i; applied: Backend.cape-idx == i; busy: Backend.look-busy;
            clicked => { if Backend.cape-sel != i { Backend.equip-cape(i); } }
        }
        SectionHead { x: 0px; y: parent.nth-y; width: 916px; idx: "02"; title: "NETHER CAPES"; note: "seen by Nether players · pick, then APPLY"; }
        if Backend.ncape-state == 2: Rectangle {
            y: parent.nth-y + 36px; height: parent.content-height - self.y;
            for c[i] in Backend.ncapes: CapeCard {
                x: mod(i, 4) * 232px; y: floor(i / 4) * 198px;
                cape: c; worn: Backend.ncape-sel == c.id; applied: Backend.ncape-worn == c.id; busy: Backend.look-busy;
                clicked => { Backend.wear-ncape(c.id); }
            }
        }
        if Backend.ncape-state != 2: Rectangle {
            y: parent.nth-y + 36px; width: 916px; height: 110px; background: Theme.s1; border-width: 1px; border-color: Theme.ln2;
            Hatch { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; }
            Text { x: 28px; width: parent.width - 56px; vertical-alignment: center; color: Theme.dim; font-family: Theme.ui; font-size: 15px * Theme.ts;
                text: Backend.ncape-state == 3 ? "The Nether cape directory isn't reachable right now. Check your connection and open this page again." : "Loading Nether capes…"; }
        }
    }

    // unapplied picks (capes + cosmetics): one save bar on every page, slides up over the bottom of the grid
    property <int> changes: (Backend.cape-sel != Backend.cape-idx ? 1 : 0) + (Backend.ncape-sel != Backend.ncape-worn ? 1 : 0)
        + (Backend.cos-sel[0] != Backend.cos-worn[0] ? 1 : 0) + (Backend.cos-sel[1] != Backend.cos-worn[1] ? 1 : 0) + (Backend.cos-sel[2] != Backend.cos-worn[2] ? 1 : 0)
        + (Backend.cos-sel[3] != Backend.cos-worn[3] ? 1 : 0) + (Backend.cos-sel[4] != Backend.cos-worn[4] ? 1 : 0) + (Backend.cos-sel[5] != Backend.cos-worn[5] ? 1 : 0)
        + (Backend.cos-sel[6] != Backend.cos-worn[6] ? 1 : 0);
    property <bool> bar-on: Backend.look-dirty || Backend.look-busy;
    Rectangle {
        x: 468px; width: 916px; height: 64px;
        y: root.bar-on ? root.height - 84px : root.height + 12px;
        opacity: root.bar-on ? 1 : 0;
        animate y { duration: Theme.mid; easing: ease-out; }
        animate opacity { duration: Theme.fast; }
        background: Theme.s2; border-radius: 8px; border-width: 1px; border-color: Theme.red2;
        drop-shadow-blur: 24px; drop-shadow-color: #000000aa;
        TouchArea { }
        Rectangle { x: 20px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px; background: Theme.red; }
        Text { x: 40px; y: 12px; height: 22px; vertical-alignment: center; color: Theme.tx; font-family: Theme.ui; font-size: 15px * Theme.ts; font-weight: 600;
            text: Backend.look-busy ? "Applying your look…" : root.changes == 1 ? "1 unapplied change" : "\{Math.max(1, root.changes)} unapplied changes"; }
        Text { x: 40px; y: 33px; height: 18px; vertical-alignment: center; color: Theme.mut; font-family: Theme.ui; font-size: 12px * Theme.ts;
            text: root.signed ? "Only you see it until you apply. Leaving asks first." : "Sign in with your Microsoft account to apply."; }
        rv := Btn { x: ap.x - self.width - 10px; y: 12px; height: 40px; text: "REVERT"; enabled: !Backend.look-busy; clicked => { Backend.revert-look(); } }
        ap := PlayButton {
            x: parent.width - 12px - 150px; y: 12px; width: 150px; height: 40px; text-size: 16px; arrow: false;
            label: Backend.look-busy ? "APPLYING…" : "APPLY";
            enabled: root.signed && Backend.look-dirty && !Backend.look-busy;
            clicked => { Backend.apply-look(); }
        }
    }

    // community dialogs
    if Community.up-state != 0: UploadDialog { }
    if Community.report-id != "": ReportDialog { }
    if Community.delete-id != "": DeleteUploadDialog { }
}
