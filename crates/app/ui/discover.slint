import { Theme } from "theme.slint";
import { Backend, Row } from "structs.slint";
import { Heading, Seg, Hatch, Chip, Btn, ModIcon, Field, Dropdown, Icon, Ico } from "components.slint";
import { ModDetail } from "moddetail.slint";

component ColHead inherits Text {
    font-family: Theme.disp; font-size: 12px * Theme.ts; font-weight: 600; letter-spacing: 0.9px; color: Theme.mut; vertical-alignment: center;
}

// Install Packs: Modrinth modpacks and Nether packs (pack-src 0 / 2; CurseForge stays hidden until there is an API key).
// Clicking a row opens the project page.
export component DiscoverScreen inherits Rectangle {
    property <int> src: Backend.pack-src;
    property <bool> typing;
    init => { Backend.load-packs(); }

    Heading { x: 53px; y: 22px; text: "INSTALL PACKS"; }
    Text {
        x: 56px; y: 88px;
        text: root.src == 2 ? "Small bundles picked by us. Mods download from Modrinth for the version you choose." : "Modpacks. Installing one creates a ready-to-play instance.";
        color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts;
    }
    Seg { x: 1384px - self.width; y: 40px; items: ["MODRINTH", "NETHER"]; item-w: 124px; current: Backend.pack-src == 2 ? 1 : 0;
        changed(i) => { Backend.pack-src = i == 1 ? 2 : 0; Backend.load-packs(); } }

    // search + sort (Modrinth)
    if root.src == 0: Rectangle {
        Field {
            x: 56px; y: 132px; width: 724px; search: true; placeholder: "Search Modrinth modpacks";
            text <=> Backend.pack-query;
            edited => { root.typing = false; root.typing = true; }
            accepted => { root.typing = false; Backend.load-packs(); }
        }
        Timer { interval: 450ms; running: root.typing; triggered => { root.typing = false; Backend.load-packs(); } }
        // categories: keep in step with packs.rs PACK_CATS
        Dropdown { x: 796px; y: 132px; width: 260px; items: ["All categories", "Adventure", "Challenging", "Combat", "Kitchen sink", "Lightweight", "Magic", "Multiplayer", "Optimization", "Quests", "Technology"];
            current <=> Backend.pack-cat; changed(i) => { Backend.load-packs(); } }
        Text { x: 1082px; y: 132px; height: 40px; text: "Sort"; color: Theme.mut; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center; }
        Dropdown { x: 1124px; y: 132px; width: 260px; items: ["Downloads", "Follows", "Newest", "Recently updated"]; current <=> Backend.pack-sort; changed(i) => { Backend.load-packs(); } }
    }

    lst := Rectangle {
        property <length> top: root.src == 0 ? 192px : 132px;
        x: 56px; y: self.top; width: 1328px; height: parent.height - self.top; clip: true;
        // column heads
        Rectangle {
            height: 28px; y: 0px;
            ColHead { x: 70px; text: root.src == 2 ? "PACK" : "MODPACK"; }
            ColHead { x: 860px; text: root.src == 2 ? "CONTENTS" : "LATEST MC"; }
            ColHead { x: 980px; text: "LOADER"; }
            if root.src == 0: ColHead { x: 1110px; text: "DOWNLOADS"; }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln2; }
        }
        // loading skeleton
        if Backend.pack-rows.length == 0 && Backend.pack-loading: Rectangle {
            y: 29px;
            for k in 8: Rectangle {
                y: k * 68px; height: 68px;
                opacity: (Backend.calm ? 0.8 : 0.55 + 0.45 * sin((Backend.tick / 1.4s + k * 0.08) * 360deg)) * (1 - k * 0.11);
                Rectangle { x: 16px; y: 14px; width: 40px; height: 40px; background: Theme.s2; }
                Rectangle { x: 70px; y: 18px; width: 240px; height: 11px; background: Theme.s3; }
                Rectangle { x: 70px; y: 40px; width: 480px; height: 8px; background: Theme.s2; }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
            }
        }
        // empty states
        if Backend.pack-rows.length == 0 && !Backend.pack-loading: Rectangle {
            x: 0px; y: 29px; width: parent.width; height: 230px;
            Hatch { width: parent.width; height: parent.height; }
            Text { x: 32px; y: 52px; text: "NO RESULTS"; color: Theme.tx; font-family: Theme.disp; font-size: 30px; font-weight: 700; }
            Text {
                x: 32px; y: 94px; width: 760px; wrap: word-wrap; color: Theme.dim; font-family: Theme.ui; font-size: 14px * Theme.ts;
                text: root.src == 2 ? "No Nether packs are available right now. Check your connection and open this page again." : "Nothing on Modrinth matches this search. Try fewer words.";
            }
        }
        Flickable {
            y: 29px; height: parent.height - 29px; content-height: Backend.pack-rows.length * 68px + 16px; interactive: !Backend.detail-open;
            for r[i] in Backend.pack-rows: Rectangle {
                y: i * 68px; height: 68px; width: parent.width;
                background: ta.has-hover ? Theme.s1 : transparent;
                animate background { duration: Theme.fast; }
                ta := TouchArea { mouse-cursor: pointer; clicked => { Backend.open-pack(i); } }
                Rectangle { x: 0px; width: 3px; background: Theme.red2; opacity: ta.has-hover ? 1 : 0; animate opacity { duration: Theme.fast; } }
                if root.src != 2: ModIcon { x: 16px; y: 14px; width: 40px; height: 40px; src: r.icon; has: r.has-icon; }
                if root.src == 2: Rectangle {
                    x: 16px; y: 14px; width: 40px; height: 40px; background: Theme.s2; border-width: 1px; border-color: Theme.ln2;
                    Image { x: 6px; y: 6px; width: 28px; height: 28px; source: @image-url("assets/nether-icon.png"); image-fit: contain; }
                }
                Text { x: 70px; y: 12px; width: 760px; text: r.name; color: Theme.tx; font-family: r.cjk ? Theme.cjk : Theme.ui; font-size: 16px * Theme.ts; font-weight: 600; overflow: elide; }
                Text { x: 70px; y: 37px; width: 760px; text: r.sub; color: Theme.mut; font-family: r.cjk ? Theme.cjk : Theme.ui; font-size: 12px * Theme.ts; overflow: elide; }
                Text { x: 860px; width: 110px; text: root.src == 2 ? r.meta : r.mc; color: Theme.dim; font-family: Theme.mono; font-size: 12px * Theme.ts; vertical-alignment: center; }
                Text { x: 980px; width: 120px; text: r.ver; color: Theme.dim; font-family: Theme.ui; font-size: 13px * Theme.ts; vertical-alignment: center; overflow: elide; }
                if root.src == 0: Text { x: 1110px; width: 90px; text: r.meta; color: Theme.tx; font-family: Theme.mono; font-size: 12px * Theme.ts; vertical-alignment: center; }
                // view chevron
                Rectangle {
                    x: parent.width - 120px; y: 17px; width: 104px; height: 34px;
                    background: ta.has-hover ? Theme.red : transparent; border-width: 1px; border-color: ta.has-hover ? Theme.red : Theme.ln2;
                    animate background, border-color { duration: Theme.fast; }
                    Text { text: "VIEW"; color: Theme.tx; font-family: Theme.disp; font-size: 14px * Theme.ts; font-weight: 700; letter-spacing: 0.9px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ln; }
            }
        }
    }

    if Backend.detail-open && Backend.detail-pack: ModDetail { x: 0px; y: 0px; width: root.width; height: parent.height; }
}
